<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\..\packaging\windows\grxfirma-diputacion.ico</ApplicationIcon>
    <RootNamespace>GrxFirma.WinUI</RootNamespace>
    <AssemblyName>grxfirma-winui</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrxFirma.WinUI.Core\GrxFirma.WinUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\packaging\windows\grxfirma-diputacion.ico">
      <Link>Assets\grxfirma-diputacion.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>Assets\grxfirma-diputacion.ico</TargetPath>
    </Content>
    <Content Include="..\..\..\gui-qml\assets\logo-dipgra.png">
      <Link>Assets\logo-dipgra.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>Assets\logo-dipgra.png</TargetPath>
    </Content>
    <Content Include="..\..\..\..\VERSION.txt">
      <Link>VERSION.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>VERSION.txt</TargetPath>
    </Content>
    <Content Include="..\..\..\..\internal\adapters\outbound\common\localizador\locales\*.json">
      <Link>locales\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\..\docs\NOVEDADES.md">
      <Link>help\NOVEDADES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>help\NOVEDADES.md</TargetPath>
    </Content>
    <None Update="help\guia-usuario.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>help\guia-usuario.txt</TargetPath>
    </None>
  </ItemGroup>
</Project>
