<ContentDialog
    x:Class="GrxFirma.WinUI.Controls.OperationDiagnosticDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GrxFirma.WinUI.Controls"
    CloseButtonText="Cerrar"
    DefaultButton="Close"
    PrimaryButtonClick="OnExportReport"
    PrimaryButtonText="Exportar informe"
    Title="Diagnóstico de la operación">

    <ContentDialog.Resources>
        <controls:DiagnosticStatusBrushConverter x:Key="DiagnosticStatusBrushConverter" />
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="680">
        <StackPanel MinWidth="300" MaxWidth="680" Spacing="18">
            <InfoBar
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.Presentation.Cause}"
                Severity="{x:Bind ViewModel.CauseSeverity}"
                Title="Qué ha ocurrido" />

            <InfoBar
                x:Name="ExportStatusBar"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Estado de la exportación del informe"
                IsClosable="False"
                IsOpen="False" />

            <StackPanel Spacing="12">
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontWeight="SemiBold"
                            Text="Responsable probable" />
                        <TextBlock
                            AutomationProperties.Name="Responsable probable"
                            Text="{x:Bind ViewModel.Presentation.OwnerLabel}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="{x:Bind ViewModel.Presentation.Responsibility}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontWeight="SemiBold"
                            Text="Qué puede hacer ahora" />
                        <TextBlock
                            AutomationProperties.Name="Acción sugerida"
                            Text="{x:Bind ViewModel.Presentation.SuggestedAction}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="Pasos observados" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="Solo se muestran evidencias de la operación original. Abrir este diagnóstico no repite la firma ni inicia nuevas comprobaciones." />

                <ItemsControl
                    AutomationProperties.Name="Cronología de la operación"
                    ItemsSource="{x:Bind ViewModel.Presentation.Steps}"
                    Visibility="{x:Bind ViewModel.TimelineVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,0,0,10"
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    MinWidth="38"
                                    MinHeight="38"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    BorderBrush="{Binding Status, Converter={StaticResource DiagnosticStatusBrushConverter}}"
                                    BorderThickness="2"
                                    CornerRadius="999">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{Binding Status, Converter={StaticResource DiagnosticStatusBrushConverter}}"
                                        Text="{Binding StatusIcon}" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="14"
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level3"
                                            AutomationProperties.Name="{Binding AutomationSummary}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Label}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Status, Converter={StaticResource DiagnosticStatusBrushConverter}}"
                                            Text="{Binding StatusDisplayText}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{Binding OwnerDisplayText}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontStyle="Italic"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{Binding SuggestedActionDisplayText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Padding="18"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.EmptyTimelineVisibility}">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="?" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level3"
                            FontWeight="SemiBold"
                            Text="No comprobado" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="El motor no registró fases para esta operación; no se puede determinar en cuál se detuvo."
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Expander
                AutomationProperties.Name="Detalles técnicos del diagnóstico"
                Header="Detalles técnicos — información avanzada"
                IsExpanded="False">
                <StackPanel Margin="0,10,0,0" Spacing="8">
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind ViewModel.FailureCodeVisibility}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level3"
                            FontWeight="SemiBold"
                            Text="Código para soporte" />
                        <TextBlock
                            AutomationProperties.Name="Código para soporte"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.Presentation.FailureCode}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox
                        MinHeight="120"
                        AutomationProperties.Name="Detalle técnico del diagnóstico"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.Presentation.ExpertDetail}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
