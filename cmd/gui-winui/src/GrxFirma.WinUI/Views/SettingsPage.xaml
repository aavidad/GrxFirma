<Page
    x:Class="GrxFirma.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GrxFirma.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <ScrollViewer
        AutomationProperties.Name="Contenido de configuración"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="32" />
                        <Setter Target="ThemeColumn.Width" Value="*" />
                        <Setter Target="ThemeRow.Height" Value="0" />
                        <Setter Target="ThemeCombo.(Grid.Column)" Value="1" />
                        <Setter Target="ThemeCombo.(Grid.Row)" Value="0" />
                        <Setter Target="ProxyTypeColumn.Width" Value="*" />
                        <Setter Target="ProxyTypeRow.Height" Value="0" />
                        <Setter Target="ProxyTypeCombo.(Grid.Column)" Value="1" />
                        <Setter Target="ProxyTypeCombo.(Grid.Row)" Value="0" />
                        <Setter Target="ProxyPortColumn.Width" Value="*" />
                        <Setter Target="ProxyPortRow.Height" Value="0" />
                        <Setter Target="ProxyPortTextBox.(Grid.Column)" Value="1" />
                        <Setter Target="ProxyPortTextBox.(Grid.Row)" Value="0" />
                        <Setter Target="ProxyUsernameColumn.Width" Value="*" />
                        <Setter Target="ProxyUsernameRow.Height" Value="0" />
                        <Setter Target="ProxyUsername.(Grid.Column)" Value="1" />
                        <Setter Target="ProxyUsername.(Grid.Row)" Value="0" />
                        <Setter Target="SettingsActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="LayoutRoot"
            MaxWidth="960"
            Padding="16"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="{x:Bind ViewModel.Title}" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Description}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsAvailabilityNoticeOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.PendingMessage, Mode=OneWay}"
                Severity="Informational"
                Title="Disponibilidad de preferencias" />

            <StackPanel Grid.Row="2" Spacing="20">
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Apariencia y comportamiento" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ThemeColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ThemeRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                AutomationProperties.Name="Idioma compartido"
                                DisplayMemberPath="Label"
                                Header="Idioma"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Languages}"
                                SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                TabIndex="0" />
                            <ComboBox
                                x:Name="ThemeCombo"
                                Grid.Row="1"
                                AutomationProperties.Name="Tema visual compartido"
                                DisplayMemberPath="Label"
                                Header="Tema"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Themes}"
                                SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                TabIndex="1" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="El idioma y el tema se comparten con las demás interfaces de GrxFirma; cada interfaz aplica las capacidades visuales que tenga disponibles."
                            TextWrapping="Wrap" />
                        <CheckBox
                            AutomationProperties.Name="Confirmar antes de firmar"
                            Content="Confirmar antes de firmar"
                            IsChecked="{x:Bind ViewModel.ConfirmBeforeSigning, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="2" />
                        <CheckBox
                            AutomationProperties.HelpText="Al cerrar la ventana, GrxFirma permanece disponible en la bandeja del sistema."
                            AutomationProperties.Name="Al cerrar, mantener en la bandeja"
                            Content="Al cerrar, mantener en la bandeja"
                            IsChecked="{x:Bind ViewModel.StayResident, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="3" />
                        <CheckBox
                            x:Name="StartWithWindowsCheckBox"
                            AutomationProperties.Name="Iniciar con Windows en la bandeja"
                            AutomationProperties.HelpText="Inicia GrxFirma oculto para este usuario. No aprueba ninguna firma."
                            Content="Iniciar con Windows en la bandeja"
                            Checked="OnStartupChanged"
                            Unchecked="OnStartupChanged"
                            IsChecked="False"
                            TabIndex="4" />
                        <CheckBox
                            AutomationProperties.HelpText="Al iniciar, consulta una vez la última GitHub Release. No envía documentos, certificados ni datos de firma."
                            AutomationProperties.Name="Avisar de nuevas versiones"
                            Content="Avisar de nuevas versiones"
                            IsChecked="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="5" />
                        <TextBlock
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="La consulta HTTPS se dirige al repositorio oficial de GitHub. Puede desactivarla; «Comprobar actualizaciones» seguirá disponible en «Acerca de» cuando quiera usarla manualmente."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Complementos" />
                        <CheckBox
                            x:Name="FacturaeToolsEnabledCheckBox"
                            AutomationProperties.HelpText="Muestra u oculta una sección independiente para crear facturas electrónicas y seguir la remisión oficial a FACe."
                            AutomationProperties.Name="Activar herramientas de facturación (Facturae, FACe y Veri*Factu)"
                            Content="Activar herramientas de facturación (Facturae, FACe y Veri*Factu)"
                            IsChecked="{x:Bind ViewModel.FacturaeToolsEnabled, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="6" />
                        <TextBlock
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Está desactivado de forma predeterminada. Al activarlo aparecerá «Facturae y FACe» como una sección separada; las funciones habituales de GrxFirma no cambian."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Firma predeterminada" />
                        <ComboBox
                            AutomationProperties.Name="Formato de firma predeterminado"
                            DisplayMemberPath="Label"
                            Header="Formato"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.DefaultFormats}"
                            SelectedItem="{x:Bind ViewModel.SelectedDefaultFormat, Mode=TwoWay}"
                            TabIndex="7" />
                        <CheckBox
                            AutomationProperties.Name="Compatibilidad estricta"
                            Content="Compatibilidad estricta"
                            IsChecked="{x:Bind ViewModel.StrictSignatureCompatibility, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="8" />
                        <CheckBox
                            x:Name="TsaEnabledCheckBox"
                            IsChecked="{x:Bind ViewModel.TsaEnabled, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="9"
                            AutomationProperties.Name="{Binding Content, ElementName=TsaEnabledCheckBox}" />
                        <TextBox
                            x:Name="TsaUrlTextBox"
                            MaxLength="2048"
                            Text="{x:Bind ViewModel.TsaUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="10"
                            AutomationProperties.Name="{Binding Header, ElementName=TsaUrlTextBox}" />
                        <TextBlock
                            x:Name="TsaFieldError"
                            AutomationProperties.LiveSetting="Assertive"
                            Foreground="{ThemeResource AppDiagnosticFailureBrush}"
                            Text="{x:Bind ViewModel.TsaValidationMessage, Mode=OneWay}"
                            Visibility="Collapsed"
                            TextWrapping="Wrap" />
                        <CheckBox
                            AutomationProperties.HelpText="La preferencia se conserva, pero la firma WinUI no la usa hasta disponer del editor seguro de sello PDF."
                            AutomationProperties.Name="Sello visible en PDF"
                            Content="Sello visible en PDF como valor predeterminado"
                            IsChecked="{x:Bind ViewModel.VisiblePdfSeal, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="11" />
                        <TextBlock
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="El sello visible solo es compatible con selección automática de formato o PAdES."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Red y proxy" />
                        <CheckBox
                            AutomationProperties.Name="Usar proxy"
                            Content="Usar proxy"
                            IsChecked="{x:Bind ViewModel.ProxyEnabled, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            TabIndex="12" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ProxyTypeColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ProxyTypeRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                AutomationProperties.Name="Tipo de proxy"
                                DisplayMemberPath="Label"
                                Header="Tipo"
                                IsEnabled="{x:Bind ViewModel.CanChooseProxyType, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.ProxyTypes}"
                                SelectedItem="{x:Bind ViewModel.SelectedProxyType, Mode=TwoWay}"
                                TabIndex="13" />
                            <TextBox
                                x:Name="ProxyHostTextBox"
                                Grid.Row="1"
                                AutomationProperties.Name="Servidor proxy"
                                Header="Host o IP"
                                IsEnabled="{x:Bind ViewModel.CanEditManualProxy, Mode=OneWay}"
                                MaxLength="512"
                                PlaceholderText="proxy.organizacion.es"
                                TabIndex="14"
                                Text="{x:Bind ViewModel.ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="ProxyHostFieldError" Grid.Row="2" Foreground="{ThemeResource AppDiagnosticFailureBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed" />
                        </Grid>
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ProxyPortColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ProxyPortRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="ProxyPortTextBox"
                                AutomationProperties.Name="Puerto del proxy"
                                Header="Puerto"
                                InputScope="Number"
                                IsEnabled="{x:Bind ViewModel.CanEditManualProxy, Mode=OneWay}"
                                MaxLength="5"
                                PlaceholderText="8080"
                                TabIndex="15"
                                Text="{x:Bind ViewModel.ProxyPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="ProxyPortFieldError" Grid.Row="2" Foreground="{ThemeResource AppDiagnosticFailureBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBlock
                                Grid.Row="1"
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="Las credenciales se administran únicamente mediante el almacén protegido del sistema."
                                TextWrapping="Wrap" />
                        </Grid>
                        <TextBox
                            AutomationProperties.HelpText="Indique una URL, host o patrón por línea."
                            AutomationProperties.Name="Exclusiones del proxy"
                            AcceptsReturn="True"
                            Header="URLs y hosts excluidos"
                            IsEnabled="{x:Bind ViewModel.CanEditManualProxy, Mode=OneWay}"
                            MaxLength="32768"
                            MinHeight="88"
                            PlaceholderText="localhost&#x0a;127.0.0.1&#x0a;*.organizacion.es"
                            TabIndex="16"
                            Text="{x:Bind ViewModel.ProxyExcludedUrlsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level3"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.ProxySecurityStatusTitle, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ProxySecurityStatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                    Text="{x:Bind ViewModel.ProxyRuntimeModeMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button MinHeight="40"
                                    AutomationProperties.Name="Actualizar estado del almacén seguro"
                                    Click="OnRefreshProxySecretStatusClick"
                                    Content="Actualizar estado"
                                    IsEnabled="{x:Bind ViewModel.CanRefreshProxySecretStatus, Mode=OneWay}"
                                    TabIndex="17" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="10">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level3"
                                FontWeight="SemiBold"
                                Text="Autenticación protegida"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="La contraseña se solicita en un diálogo nativo de Windows, se envía una sola vez y nunca aparece en esta pantalla."
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ProxyUsernameColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ProxyUsernameRow" Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox
                                    AutomationProperties.Name="Dominio de autenticación del proxy"
                                    Header="Dominio"
                                    IsEnabled="{x:Bind ViewModel.CanEditManualProxy, Mode=OneWay}"
                                    MaxLength="256"
                                    PlaceholderText="proxy-corporativo"
                                    TabIndex="18"
                                    Text="{x:Bind ViewModel.ProxyRealm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    x:Name="ProxyUsername"
                                    Grid.Row="1"
                                    AutomationProperties.Name="Usuario del proxy"
                                    Header="Usuario"
                                    IsEnabled="{x:Bind ViewModel.CanEditManualProxy, Mode=OneWay}"
                                    MaxLength="256"
                                    PlaceholderText="usuario"
                                    TabIndex="19"
                                    Text="{x:Bind ViewModel.ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <controls:ResponsiveActionPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button MinHeight="40"
                                    AutomationProperties.HelpText="Windows abrirá un diálogo nativo que mantiene la contraseña en memoria borrable."
                                    AutomationProperties.Name="Guardar o cambiar credenciales del proxy"
                                    Click="OnStoreProxyCredentialsClick"
                                    Content="Guardar o cambiar credenciales"
                                    IsEnabled="{x:Bind ViewModel.CanStoreProxyCredentials, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    TabIndex="20" />
                                <Button MinHeight="40"
                                    AutomationProperties.HelpText="Solicita confirmación antes de retirar la credencial del almacén protegido."
                                    AutomationProperties.Name="Quitar credenciales del proxy"
                                    Click="OnDeleteProxyCredentialsClick"
                                    Content="Quitar credenciales"
                                    IsEnabled="{x:Bind ViewModel.CanDeleteProxyCredentials, Mode=OneWay}"
                                    TabIndex="21" />
                            </controls:ResponsiveActionPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="RestSectionTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="RestStatusText"
                            AutomationProperties.LiveSetting="Polite"
                            TextWrapping="Wrap" />
                        <TextBox x:Name="RestTokenText"
                            IsReadOnly="True"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{Binding Header, ElementName=RestTokenText}"
                            TabIndex="22" />
                        <controls:ResponsiveActionPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RestRefreshButton" MinHeight="40"
                                Click="OnRefreshRestClick"
                            AutomationProperties.Name="{Binding Content, ElementName=RestRefreshButton}"
                            TabIndex="23" />
                            <Button x:Name="RestStartButton" MinHeight="40"
                                Click="OnStartRestClick"
                            AutomationProperties.Name="{Binding Content, ElementName=RestStartButton}"
                            TabIndex="24" />
                            <Button x:Name="RestStopButton" MinHeight="40"
                                Click="OnStopRestClick"
                            AutomationProperties.Name="{Binding Content, ElementName=RestStopButton}"
                            TabIndex="25" />
                            <Button x:Name="RestOpenButton" MinHeight="40"
                                Click="OnOpenRestClick"
                            AutomationProperties.Name="{Binding Content, ElementName=RestOpenButton}"
                            TabIndex="26" />
                        </controls:ResponsiveActionPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource AppMutedTextBrush}"
                    Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <StackPanel
                    x:Name="SettingsActions"
                    Orientation="Vertical"
                    Spacing="8">
                    <Button MinHeight="40"
                        AutomationProperties.HelpText="Descarta los cambios locales y vuelve a leer las preferencias persistidas."
                        AutomationProperties.Name="Recargar configuración"
                        Click="OnReloadClick"
                        Content="Recargar"
                        IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}"
                        TabIndex="27" />
                    <Button MinHeight="40"
                        x:Name="SaveButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Guardar configuración"
                        Click="OnSaveClick"
                        Content="Guardar preferencias"
                        IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        TabIndex="28" />
                    <Button MinHeight="40"
                        AutomationProperties.Name="Cancelar operación de configuración"
                        Click="OnCancelClick"
                        Content="Cancelar operación"
                        IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                        TabIndex="29" />
                    <ProgressRing
                        Width="28"
                        Height="28"
                        AutomationProperties.Name="Operación de configuración en curso"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>

                <InfoBar
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
