<Page
    x:Class="GrxFirma.WinUI.Views.FacturaePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <ScrollViewer
        AutomationProperties.Name="Guía de Facturae y FACe"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="32" />
                        <Setter Target="InvoiceSeriesColumn.Width" Value="*" />
                        <Setter Target="InvoiceSeriesRow.Height" Value="0" />
                        <Setter Target="InvoiceSeries.(Grid.Column)" Value="1" />
                        <Setter Target="InvoiceSeries.(Grid.Row)" Value="0" />
                        <Setter Target="ReferenceContractColumn.Width" Value="*" />
                        <Setter Target="ReferenceContractRow.Height" Value="0" />
                        <Setter Target="ReferenceContract.(Grid.Column)" Value="1" />
                        <Setter Target="ReferenceContract.(Grid.Row)" Value="0" />
                        <Setter Target="SellerNameColumn.Width" Value="2*" />
                        <Setter Target="SellerNameRow.Height" Value="0" />
                        <Setter Target="SellerName.(Grid.Column)" Value="1" />
                        <Setter Target="SellerName.(Grid.Row)" Value="0" />
                        <Setter Target="SellerSecondSurnameColumn.Width" Value="*" />
                        <Setter Target="SellerSecondSurnameRow.Height" Value="0" />
                        <Setter Target="SellerSecondSurname.(Grid.Column)" Value="1" />
                        <Setter Target="SellerSecondSurname.(Grid.Row)" Value="0" />
                        <Setter Target="SellerTownColumn.Width" Value="2*" />
                        <Setter Target="SellerProvinceColumn.Width" Value="*" />
                        <Setter Target="SellerTownRow.Height" Value="0" />
                        <Setter Target="SellerProvinceRow.Height" Value="0" />
                        <Setter Target="SellerTown.(Grid.Column)" Value="1" />
                        <Setter Target="SellerProvince.(Grid.Column)" Value="2" />
                        <Setter Target="SellerTown.(Grid.Row)" Value="0" />
                        <Setter Target="SellerProvince.(Grid.Row)" Value="0" />
                        <Setter Target="BuyerNameColumn.Width" Value="2*" />
                        <Setter Target="BuyerNameRow.Height" Value="0" />
                        <Setter Target="BuyerName.(Grid.Column)" Value="1" />
                        <Setter Target="BuyerName.(Grid.Row)" Value="0" />
                        <Setter Target="BuyerTownColumn.Width" Value="2*" />
                        <Setter Target="BuyerProvinceColumn.Width" Value="*" />
                        <Setter Target="BuyerTownRow.Height" Value="0" />
                        <Setter Target="BuyerProvinceRow.Height" Value="0" />
                        <Setter Target="BuyerTown.(Grid.Column)" Value="1" />
                        <Setter Target="BuyerProvince.(Grid.Column)" Value="2" />
                        <Setter Target="BuyerTown.(Grid.Row)" Value="0" />
                        <Setter Target="BuyerProvince.(Grid.Row)" Value="0" />
                        <Setter Target="ManagingBodyColumn.Width" Value="*" />
                        <Setter Target="ProcessingUnitColumn.Width" Value="*" />
                        <Setter Target="ManagingBodyRow.Height" Value="0" />
                        <Setter Target="ProcessingUnitRow.Height" Value="0" />
                        <Setter Target="ManagingBody.(Grid.Column)" Value="1" />
                        <Setter Target="ProcessingUnit.(Grid.Column)" Value="2" />
                        <Setter Target="ManagingBody.(Grid.Row)" Value="0" />
                        <Setter Target="ProcessingUnit.(Grid.Row)" Value="0" />
                        <Setter Target="UnitPriceColumn.Width" Value="*" />
                        <Setter Target="VatRateColumn.Width" Value="*" />
                        <Setter Target="UnitPriceRow.Height" Value="0" />
                        <Setter Target="VatRateRow.Height" Value="0" />
                        <Setter Target="UnitPrice.(Grid.Column)" Value="1" />
                        <Setter Target="VatRate.(Grid.Column)" Value="2" />
                        <Setter Target="UnitPrice.(Grid.Row)" Value="0" />
                        <Setter Target="VatRate.(Grid.Row)" Value="0" />
                        <Setter Target="TaxColumn.Width" Value="*" />
                        <Setter Target="TotalColumn.Width" Value="*" />
                        <Setter Target="TaxRow.Height" Value="0" />
                        <Setter Target="TotalRow.Height" Value="0" />
                        <Setter Target="TaxSummary.(Grid.Column)" Value="1" />
                        <Setter Target="TotalSummary.(Grid.Column)" Value="2" />
                        <Setter Target="TaxSummary.(Grid.Row)" Value="0" />
                        <Setter Target="TotalSummary.(Grid.Row)" Value="0" />
                        <Setter Target="IbanColumn.Width" Value="2*" />
                        <Setter Target="IbanRow.Height" Value="0" />
                        <Setter Target="Iban.(Grid.Column)" Value="1" />
                        <Setter Target="Iban.(Grid.Row)" Value="0" />
                        <Setter Target="ValidationActions.Orientation" Value="Horizontal" />
                        <Setter Target="SubmissionActions.Orientation" Value="Horizontal" />
                        <Setter Target="ReceiptActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="LayoutRoot"
            MaxWidth="960"
            Padding="16"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="{x:Bind ViewModel.Title}" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Description}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.PendingMessage, Mode=OneWay}"
                Severity="Informational"
                Title="Envío asistido" />

            <StackPanel Grid.Row="2" Spacing="20">
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Crear XML Facturae 3.2.2" />
                        <TextBlock
                            Text="Generador local para una factura ordinaria en euros con una línea y los tres destinos DIR3. Los totales se calculan automáticamente. Revise siempre el resultado y valídelo en FACe antes de remitirlo."
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="El fichero se crea sin firma. Después use «Firmar» con el formato FacturaE y el certificado del emisor."
                            Severity="Informational"
                            Title="Dos pasos: crear y firmar" />

                        <Expander
                            AutomationProperties.Name="Datos de la factura"
                            Header="Factura"
                            IsExpanded="True"
                            TabIndex="0">
                            <StackPanel Padding="0,12,0,0" Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="InvoiceSeriesColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="InvoiceSeriesRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Número de factura"
                                        Header="Número de factura *"
                                        MaxLength="20"
                                        TabIndex="1"
                                        Text="{x:Bind ViewModel.InvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="InvoiceSeries"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Serie de factura"
                                        Header="Serie (opcional)"
                                        MaxLength="20"
                                        TabIndex="2"
                                        Text="{x:Bind ViewModel.InvoiceSeriesCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <DatePicker
                                    AutomationProperties.Name="Fecha de expedición"
                                    Date="{x:Bind ViewModel.IssueDate, Mode=TwoWay}"
                                    DayVisible="True"
                                    Header="Fecha de expedición *"
                                    MonthVisible="True"
                                    TabIndex="3"
                                    YearVisible="True" />
                                <TextBox
                                    AutomationProperties.Name="Descripción general de la factura"
                                    Header="Descripción general (opcional)"
                                    MaxLength="2500"
                                    TabIndex="4"
                                    Text="{x:Bind ViewModel.InvoiceDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ReferenceContractColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="ReferenceContractRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Referencia del expediente"
                                        Header="Expediente (opcional)"
                                        MaxLength="20"
                                        TabIndex="5"
                                        Text="{x:Bind ViewModel.FileReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="ReferenceContract"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Referencia del contrato"
                                        Header="Contrato (opcional)"
                                        MaxLength="20"
                                        TabIndex="6"
                                        Text="{x:Bind ViewModel.ReceiverContractReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander
                            AutomationProperties.Name="Datos del emisor"
                            Header="Emisor"
                            TabIndex="7">
                            <StackPanel Padding="0,12,0,0" Spacing="10">
                                <ToggleSwitch
                                    AutomationProperties.Name="El emisor es una persona física"
                                    Header="Tipo de emisor"
                                    IsOn="{x:Bind ViewModel.SellerIsIndividual, Mode=TwoWay}"
                                    OffContent="Persona jurídica"
                                    OnContent="Persona física"
                                    TabIndex="8" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="SellerNameColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SellerNameRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="NIF del emisor"
                                        Header="NIF *"
                                        MaxLength="30"
                                        TabIndex="9"
                                        Text="{x:Bind ViewModel.SellerTaxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="SellerName"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Razón social o nombre del emisor"
                                        Header="Razón social o nombre *"
                                        MaxLength="80"
                                        TabIndex="10"
                                        Text="{x:Bind ViewModel.SellerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="SellerSecondSurnameColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SellerSecondSurnameRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Primer apellido del emisor"
                                        Header="Primer apellido (persona física)"
                                        MaxLength="40"
                                        TabIndex="11"
                                        Text="{x:Bind ViewModel.SellerFirstSurname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="SellerSecondSurname"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Segundo apellido del emisor"
                                        Header="Segundo apellido (opcional)"
                                        MaxLength="40"
                                        TabIndex="12"
                                        Text="{x:Bind ViewModel.SellerSecondSurname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBox
                                    AutomationProperties.Name="Dirección del emisor"
                                    Header="Dirección *"
                                    MaxLength="80"
                                    TabIndex="13"
                                    Text="{x:Bind ViewModel.SellerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="SellerTownColumn" Width="0" />
                                        <ColumnDefinition x:Name="SellerProvinceColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SellerTownRow" Height="Auto" /><RowDefinition x:Name="SellerProvinceRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Código postal del emisor"
                                        Header="Código postal *"
                                        MaxLength="5"
                                        TabIndex="14"
                                        Text="{x:Bind ViewModel.SellerPostCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="SellerTown"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Población del emisor"
                                        Header="Población *"
                                        MaxLength="50"
                                        TabIndex="15"
                                        Text="{x:Bind ViewModel.SellerTown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="SellerProvince"
                                        Grid.Row="2"
                                        AutomationProperties.Name="Provincia del emisor"
                                        Header="Provincia *"
                                        MaxLength="20"
                                        TabIndex="16"
                                        Text="{x:Bind ViewModel.SellerProvince, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBox
                                    AutomationProperties.Name="Correo del emisor"
                                    Header="Correo electrónico (opcional)"
                                    InputScope="EmailSmtpAddress"
                                    MaxLength="60"
                                    TabIndex="17"
                                    Text="{x:Bind ViewModel.SellerEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Expander>

                        <Expander
                            AutomationProperties.Name="Datos del receptor y códigos DIR3"
                            Header="Administración receptora y DIR3"
                            TabIndex="18">
                            <StackPanel Padding="0,12,0,0" Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="BuyerNameColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="BuyerNameRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="NIF del receptor"
                                        Header="NIF de la Administración *"
                                        MaxLength="30"
                                        TabIndex="19"
                                        Text="{x:Bind ViewModel.BuyerTaxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="BuyerName"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Razón social del receptor"
                                        Header="Razón social *"
                                        MaxLength="80"
                                        TabIndex="20"
                                        Text="{x:Bind ViewModel.BuyerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBox
                                    AutomationProperties.Name="Dirección del receptor"
                                    Header="Dirección *"
                                    MaxLength="80"
                                    TabIndex="21"
                                    Text="{x:Bind ViewModel.BuyerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="BuyerTownColumn" Width="0" />
                                        <ColumnDefinition x:Name="BuyerProvinceColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="BuyerTownRow" Height="Auto" /><RowDefinition x:Name="BuyerProvinceRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Código postal del receptor"
                                        Header="Código postal *"
                                        MaxLength="5"
                                        TabIndex="22"
                                        Text="{x:Bind ViewModel.BuyerPostCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="BuyerTown"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Población del receptor"
                                        Header="Población *"
                                        MaxLength="50"
                                        TabIndex="23"
                                        Text="{x:Bind ViewModel.BuyerTown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="BuyerProvince"
                                        Grid.Row="2"
                                        AutomationProperties.Name="Provincia del receptor"
                                        Header="Provincia *"
                                        MaxLength="20"
                                        TabIndex="24"
                                        Text="{x:Bind ViewModel.BuyerProvince, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ManagingBodyColumn" Width="0" />
                                        <ColumnDefinition x:Name="ProcessingUnitColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="ManagingBodyRow" Height="Auto" /><RowDefinition x:Name="ProcessingUnitRow" Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Código DIR3 de la oficina contable"
                                        CharacterCasing="Upper"
                                        Header="Oficina contable *"
                                        MaxLength="9"
                                        TabIndex="25"
                                        Text="{x:Bind ViewModel.AccountingOfficeDir3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="ManagingBody"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Código DIR3 del órgano gestor"
                                        CharacterCasing="Upper"
                                        Header="Órgano gestor *"
                                        MaxLength="9"
                                        TabIndex="26"
                                        Text="{x:Bind ViewModel.ManagingBodyDir3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="ProcessingUnit"
                                        Grid.Row="2"
                                        AutomationProperties.Name="Código DIR3 de la unidad tramitadora"
                                        CharacterCasing="Upper"
                                        Header="Unidad tramitadora *"
                                        MaxLength="9"
                                        TabIndex="27"
                                        Text="{x:Bind ViewModel.ProcessingUnitDir3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Button MinHeight="40"
                                    AutomationProperties.HelpText="Abre únicamente el buscador oficial fijo del Portal FACe Proveedores."
                                    AutomationProperties.Name="Buscar códigos DIR3 en FACe"
                                    Click="OnOpenOrganisationDirectoryClick"
                                    Content="Buscar organismo y relaciones DIR3"
                                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                    TabIndex="28" />
                            </StackPanel>
                        </Expander>

                        <Expander
                            AutomationProperties.Name="Concepto importes e impuestos"
                            Header="Concepto, importes e IVA"
                            TabIndex="29">
                            <StackPanel Padding="0,12,0,0" Spacing="10">
                                <TextBox
                                    AutomationProperties.Name="Descripción del bien o servicio"
                                    Header="Descripción del bien o servicio *"
                                    MaxLength="2500"
                                    TabIndex="30"
                                    Text="{x:Bind ViewModel.LineDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="UnitPriceColumn" Width="0" />
                                        <ColumnDefinition x:Name="VatRateColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="UnitPriceRow" Height="Auto" /><RowDefinition x:Name="VatRateRow" Height="Auto" /></Grid.RowDefinitions>
                                    <NumberBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Cantidad"
                                        Header="Cantidad *"
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        TabIndex="31"
                                        Value="{x:Bind ViewModel.LineQuantity, Mode=TwoWay}" />
                                    <NumberBox
                                        x:Name="UnitPrice"
                                        Grid.Row="1"
                                        AutomationProperties.Name="Precio unitario sin impuestos"
                                        Header="Precio unitario sin IVA *"
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        TabIndex="32"
                                        Value="{x:Bind ViewModel.LineUnitPrice, Mode=TwoWay}" />
                                    <NumberBox
                                        x:Name="VatRate"
                                        Grid.Row="2"
                                        AutomationProperties.Name="Porcentaje de IVA"
                                        Header="IVA (%) *"
                                        Maximum="100"
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        TabIndex="33"
                                        Value="{x:Bind ViewModel.LineVatRate, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="TaxColumn" Width="0" />
                                        <ColumnDefinition x:Name="TotalColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="TaxRow" Height="Auto" /><RowDefinition x:Name="TotalRow" Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Text="Base imponible"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.CalculatedBase, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="TaxSummary" Grid.Row="1" Spacing="2">
                                        <TextBlock
                                            Text="IVA"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.CalculatedTax, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="TotalSummary" Grid.Row="2" Spacing="2">
                                        <TextBlock
                                            Text="Total"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.CalculatedTotal, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander
                            AutomationProperties.Name="Datos de pago opcionales"
                            Header="Pago (opcional)"
                            TabIndex="34">
                            <StackPanel Padding="0,12,0,0" Spacing="10">
                                <CheckBox
                                    AutomationProperties.Name="Incluir pago por transferencia"
                                    Content="Incluir vencimiento y cuenta de abono por transferencia."
                                    IsChecked="{x:Bind ViewModel.IncludePayment, Mode=TwoWay}"
                                    TabIndex="35" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="IbanColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="IbanRow" Height="Auto" /></Grid.RowDefinitions>
                                    <DatePicker
                                        Grid.Column="0"
                                        AutomationProperties.Name="Fecha de vencimiento"
                                        Date="{x:Bind ViewModel.InstallmentDueDate, Mode=TwoWay}"
                                        Header="Vencimiento"
                                        IsEnabled="{x:Bind ViewModel.IncludePayment, Mode=OneWay}"
                                        TabIndex="36" />
                                    <TextBox
                                        x:Name="Iban"
                                        Grid.Row="1"
                                        AutomationProperties.Name="IBAN de abono"
                                        CharacterCasing="Upper"
                                        Header="IBAN de abono"
                                        IsEnabled="{x:Bind ViewModel.IncludePayment, Mode=OneWay}"
                                        MaxLength="40"
                                        TabIndex="37"
                                        Text="{x:Bind ViewModel.Iban, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Button MinHeight="40"
                            AutomationProperties.HelpText="Valida los campos, calcula los totales y guarda un XML Facturae 3.2.2 sin firmar."
                            AutomationProperties.Name="Crear XML Facturae 3.2.2"
                            Click="OnCreateInvoiceClick"
                            Content="Crear XML Facturae 3.2.2"
                            IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            TabIndex="38" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="GrxFirma no sube la factura por usted en este modo. El envío solo termina cuando FACe muestra la confirmación y usted descarga el justificante con número de registro y CSV."
                    Severity="Warning"
                    Title="No cierre el portal sin el justificante" />

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="1. Reúna los datos antes de crear la factura" />
                        <TextBlock
                            Text="Pida a la Administración destinataria los tres códigos DIR3 exactos: oficina contable, órgano gestor y unidad tramitadora. Reúna también los datos fiscales del emisor y del receptor, número y fecha, líneas, impuestos, totales y forma de pago."
                            TextWrapping="Wrap" />
                        <CheckBox
                            AutomationProperties.Name="Confirmo que tengo los tres códigos DIR3"
                            Content="Tengo la oficina contable, el órgano gestor y la unidad tramitadora."
                            TabIndex="39" />
                        <CheckBox
                            AutomationProperties.Name="Confirmo los datos fiscales y económicos"
                            Content="He revisado los datos fiscales, las líneas, los impuestos y los totales."
                            TabIndex="40" />
                        <Button MinHeight="40"
                            AutomationProperties.HelpText="Abre únicamente el buscador oficial fijo del Portal FACe Proveedores."
                            AutomationProperties.Name="Abrir buscador oficial de organismos y DIR3"
                            Click="OnOpenOrganisationDirectoryClick"
                            Content="Buscar organismo y relaciones DIR3"
                            IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                            TabIndex="41" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="2. Genere y firme el XML Facturae" />
                        <TextBlock
                            Text="Guarde la factura en XML Facturae y fírmela electrónicamente. FACe admite Facturae 3.2, 3.2.1 y 3.2.2 firmados. Un PDF puede acompañar a la factura si se lo solicitan, pero no sustituye al XML firmado."
                            TextWrapping="Wrap" />
                        <CheckBox
                            AutomationProperties.Name="Confirmo que el XML Facturae está firmado"
                            Content="Tengo localizado el XML Facturae firmado que voy a remitir."
                            TabIndex="42" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="3. Valide antes de remitir" />
                        <TextBlock
                            Text="Abra el validador oficial, suba el XML firmado y corrija cualquier error. Compruebe de nuevo que los tres códigos DIR3 corresponden al destino que le indicó la Administración."
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="ValidationActions"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button MinHeight="40"
                                AutomationProperties.HelpText="Abre únicamente el validador oficial fijo del Portal FACe Proveedores."
                                AutomationProperties.Name="Abrir validador oficial de FACe"
                                Click="OnOpenValidatorClick"
                                Content="Validar factura en FACe"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="43" />
                        </StackPanel>
                        <TextBlock x:Name="LocalValidationTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ValidateInvoiceButton" AutomationProperties.Name="Elegir factura" MinHeight="40" TabIndex="44" Click="OnValidateInvoiceClick" />
                            <Button x:Name="ExportInvoiceReportButton" AutomationProperties.Name="Exportar informe" MinHeight="40" TabIndex="45" Click="OnExportInvoiceReportClick" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="InvoiceValidationSummary" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                        <TextBox x:Name="InvoiceValidationReport" AutomationProperties.Name="Informe de validación" TabIndex="46" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" />
                        <CheckBox
                            AutomationProperties.Name="Confirmo que FACe no muestra errores de validación"
                            Content="El validador oficial no muestra errores que impidan la remisión."
                            TabIndex="47" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="4. Identifíquese y remita la factura" />
                        <TextBlock
                            Text="Abra la remisión oficial. FACe le pedirá identificarse con un medio admitido, como certificado electrónico o Cl@ve. En el portal, seleccione el XML firmado, añada solo los anexos solicitados, revise el destino y confirme la presentación."
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="SubmissionActions"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button MinHeight="40"
                                AutomationProperties.HelpText="Abre únicamente el trámite oficial fijo del Portal FACe Proveedores. La aplicación no adjunta ni transmite el fichero."
                                AutomationProperties.Name="Abrir remisión oficial de facturas en FACe"
                                Click="OnOpenSubmissionClick"
                                Content="Remitir factura en FACe"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="48" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="5. Descargue y conserve el justificante" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="No dé la factura por presentada hasta que FACe le entregue el justificante."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Guarde el justificante junto al XML firmado. Compruebe que contiene el número de registro y el código seguro de verificación (CSV). Puede verificar después que el justificante no ha sido alterado."
                            TextWrapping="Wrap" />
                        <CheckBox
                            AutomationProperties.Name="Confirmo que he guardado el justificante de FACe"
                            Content="He guardado el justificante con su número de registro y CSV."
                            TabIndex="49" />
                        <StackPanel
                            x:Name="ReceiptActions"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button MinHeight="40"
                                AutomationProperties.Name="Verificar CSV del justificante en FACe"
                                Click="OnOpenReceiptVerificationClick"
                                Content="Verificar CSV del justificante"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                TabIndex="50" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Consultar estado de factura en FACe"
                                Click="OnOpenInvoiceStatusClick"
                                Content="Consultar estado de la factura"
                                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                                TabIndex="51" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Qué debe conservar" />
                        <TextBlock
                            Text="Conserve el XML Facturae firmado, los anexos enviados, el justificante de registro y las comunicaciones posteriores. Consulte el estado en FACe; solicitar la anulación no equivale a borrar una factura ya registrada."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Guía revisada en julio de 2026. Si el portal cambia, prevalecen siempre las instrucciones mostradas por el Portal FACe Proveedores."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Veri*Factu es una sección propia, fuera de los pasos de FACe. -->
                <Border x:Name="VeriFactuCard" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="VeriFactuTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="VeriFactuScope" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ValidateVeriFactuButton" AutomationProperties.Name="Elegir registro XML" MinHeight="40" TabIndex="52" Click="OnValidateVeriFactuClick" />
                            <Button x:Name="ValidateVeriFactuFolderButton" AutomationProperties.Name="Elegir carpeta de registros" MinHeight="40" TabIndex="53" Click="OnValidateVeriFactuFolderClick" />
                        </StackPanel>
                        <TextBlock x:Name="VeriFactuSummary" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                        <TextBox x:Name="VeriFactuReport" AutomationProperties.Name="Informe de la comprobación Veri*Factu" TabIndex="54" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" Visibility="Collapsed" />
                        <Button x:Name="ExportVeriFactuReportButton" AutomationProperties.Name="Exportar informe Veri*Factu" MinHeight="40" TabIndex="55" Click="OnExportVeriFactuReportClick" Visibility="Collapsed" />
                        <TextBlock x:Name="VeriFactuQrTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VeriFactuQrInput" AutomationProperties.Name="URL del código QR" Grid.Column="0" MinHeight="40" TabIndex="56" TextChanged="OnVeriFactuQrTextChanged" />
                            <Button x:Name="ReadVeriFactuQrFileButton" AutomationProperties.Name="Leer desde imagen o PDF" Grid.Column="1" MinHeight="40" VerticalAlignment="Bottom" TabIndex="57" Click="OnReadVeriFactuQrFileClick" />
                        </Grid>
                        <TextBlock x:Name="VeriFactuQrNotice" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReadVeriFactuQrButton" AutomationProperties.Name="Leer datos del QR" MinHeight="40" TabIndex="58" Click="OnReadVeriFactuQrClick" />
                            <Button x:Name="QueryVeriFactuQrButton" AutomationProperties.Name="Consultar AEAT" MinHeight="40" TabIndex="59" Click="OnQueryVeriFactuQrClick" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="VeriFactuQrQueryHelp" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="VeriFactuQrReport" AutomationProperties.Name="Resultado del QR" TabIndex="60" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" />
                        <Expander x:Name="VeriFactuQrTechnical" AutomationProperties.Name="Ver respuesta técnica" TabIndex="61" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                            <TextBox x:Name="VeriFactuQrTechnicalText" AutomationProperties.Name="Ver respuesta técnica" TabIndex="62" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
                        </Expander>
                    </StackPanel>
                </Border>

                <ProgressRing
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Apertura del portal FACe en curso"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
