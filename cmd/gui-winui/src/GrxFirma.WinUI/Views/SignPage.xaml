                                            TabIndex="43"
                                            Text="{x:Bind ViewModel.SignatureLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            AutomationProperties.Name="Contacto de la firma PDF"
                                            Header="Contacto (opcional)"
                                            MaxLength="256"
                                            TabIndex="44"
                                            Text="{x:Bind ViewModel.SignatureContact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            AutomationProperties.LiveSetting="Polite"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{x:Bind ViewModel.VisibleSealPreviewMessage, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{x:Bind ViewModel.SealPreviousPageLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SealPreviousPageLabel, Mode=OneWay}"
                                                MinHeight="40" TabIndex="45"
                                                IsEnabled="{x:Bind ViewModel.CanGoToPreviousSealPage, Mode=OneWay}"
                                                Click="OnPreviousSealPageClick" />
                                            <TextBlock VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                                Text="{x:Bind ViewModel.VisibleSealPageSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                            <Button Content="{x:Bind ViewModel.SealNextPageLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SealNextPageLabel, Mode=OneWay}"
