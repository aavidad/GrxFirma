                                                                    Visibility="{x:Bind ViewModel.ShowVisibleSealMock, Mode=OneWay}"
                                                                    Width="{x:Bind ViewModel.VisibleSealPreviewContentWidth, Mode=OneWay}"
                                                                    Height="{x:Bind ViewModel.VisibleSealPreviewContentHeight, Mode=OneWay}"
