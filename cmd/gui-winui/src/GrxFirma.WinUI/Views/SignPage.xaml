<Page
    x:Class="GrxFirma.WinUI.Views.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GrxFirma.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Page.Resources>
        <controls:CertificateStatusBrushConverter x:Key="CertificateStatusBrushConverter" />
        <SolidColorBrush x:Key="CertificateSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}" />
    </Page.Resources>

    <ScrollViewer
        x:Name="SignContentScrollViewer"
        AutomationProperties.Name="Contenido de firma"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="32" />
                        <Setter Target="LayoutRoot.MaxWidth" Value="1440" />
                        <Setter Target="CertificateSidebar.(Grid.Column)" Value="1" />
                        <Setter Target="CertificateSidebar.(Grid.Row)" Value="0" />
                        <Setter Target="DocumentBrowseColumn.Width" Value="Auto" />
                        <Setter Target="DocumentBrowseRow.Height" Value="0" />
                        <Setter Target="DocumentBrowseButton.(Grid.Column)" Value="1" />
                        <Setter Target="DocumentBrowseButton.(Grid.Row)" Value="0" />
                        <Setter Target="CertificatePickerActionColumn.Width" Value="Auto" />
                        <Setter Target="CertificatePickerActionRow.Height" Value="0" />
                        <Setter Target="CertificatePickerActionButton.(Grid.Column)" Value="1" />
                        <Setter Target="CertificatePickerActionButton.(Grid.Row)" Value="0" />
                        <Setter Target="FormatColumn.Width" Value="*" />
                        <Setter Target="FormatRow.Height" Value="0" />
                        <Setter Target="FormatCombo.(Grid.Column)" Value="1" />
                        <Setter Target="FormatCombo.(Grid.Row)" Value="0" />
                        <Setter Target="SignButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="BatchSignButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="ResultButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="BatchResultButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="SignActions.Orientation" Value="Horizontal" />
                        <Setter Target="VisibleSealPreviewColumn.Width" Value="Auto" />
                        <Setter Target="VisibleSealPreviewRow.Height" Value="0" />
                        <Setter Target="VisibleSealPreviewButton.(Grid.Column)" Value="1" />
                        <Setter Target="VisibleSealPreviewButton.(Grid.Row)" Value="0" />
                        <Setter Target="VisibleSealNumberSecondColumn.Width" Value="*" />
                        <Setter Target="VisibleSealWidthRow.Height" Value="0" />
                        <Setter Target="VisibleSealHeightRow.Height" Value="0" />
                        <Setter Target="VisibleSealY.(Grid.Column)" Value="1" />
                        <Setter Target="VisibleSealY.(Grid.Row)" Value="0" />
                        <Setter Target="VisibleSealWidth.(Grid.Column)" Value="0" />
                        <Setter Target="VisibleSealWidth.(Grid.Row)" Value="1" />
                        <Setter Target="VisibleSealHeight.(Grid.Column)" Value="1" />
                        <Setter Target="VisibleSealHeight.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="LayoutRoot"
            MaxWidth="1080"
            Padding="16"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="{x:Bind ViewModel.Title}" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Description}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsAvailabilityNoticeOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.PendingMessage, Mode=OneWay}"
                Severity="Informational"
                Title="Disponibilidad de firma" />

            <Border
                x:Name="SignResultPanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="SignResultHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionTitleTextStyle}"
                        Text="Resultado" />
                    <InfoBar
                        x:Name="SignResultNotice"
                        AutomationProperties.LiveSetting="Assertive"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Success"
                        Title="Documento firmado correctamente">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Name="SignResultFileName"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SignResultVerification"
                                TextWrapping="Wrap" />
                            <TextBlock
                                AutomationProperties.Name="Detalle de validación del resultado"
                                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </InfoBar>
                    <controls:ResponsiveActionPanel Orientation="Horizontal" Spacing="8">
                        <Button MinHeight="40"
                            x:Name="ResultButton"
                            AutomationProperties.Name="Ver documento firmado"
                            Click="OnOpenResultClick"
                            Content="Ver documento firmado"
                            IsEnabled="{x:Bind ViewModel.CanOpenOutput, Mode=OneWay}"
                            TabIndex="0" />
                        <Button MinHeight="40"
                            x:Name="OpenResultFolderButton"
                            AutomationProperties.Name="Abrir carpeta del documento firmado"
                            Click="OnOpenResultFolderClick"
                            Content="Abrir carpeta"
                            IsEnabled="{x:Bind ViewModel.CanOpenOutput, Mode=OneWay}"
                            TabIndex="1" />
                        <Button MinHeight="40"
                            x:Name="ReviewSignButton"
                            AutomationProperties.Name="Revisar datos de firma para volver a intentarlo"
                            Click="OnReviewSignClick"
                            Content="Revisar y volver a firmar"
                            Visibility="Collapsed"
                            TabIndex="2" />
                    </controls:ResponsiveActionPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="SignLayoutGrid" Grid.Row="3" ColumnSpacing="20" RowSpacing="20" SizeChanged="OnSignLayoutSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CertificatePanelColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <StackPanel Spacing="20">
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Documento y operación" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="DocumentBrowseColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="DocumentBrowseRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                AutomationProperties.Name="Documento que se va a firmar"
                                Header="Documento"
                                MinHeight="40"
                                IsReadOnly="True"
                                PlaceholderText="Ningún documento seleccionado"
                                TabIndex="3"
                                Text="{x:Bind ViewModel.InputDisplayName, Mode=OneWay}" />
                            <Button MinHeight="40"
                                x:Name="DocumentBrowseButton"
                                Grid.Row="1"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="Seleccionar documento para firmar"
                                Click="OnSelectDocumentClick"
                                Content="Examinar…"
                                IsEnabled="{x:Bind ViewModel.CanSelectDocument, Mode=OneWay}"
                                TabIndex="4" />
                        </Grid>

                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <CheckBox
                                    AutomationProperties.HelpText="Permite seleccionar hasta 128 documentos mediante selección múltiple y una carpeta adicional. El motor conserva los resultados parciales por documento."
                                    AutomationProperties.Name="Activar firma por lotes"
                                    Content="Firma por lotes"
                                    IsChecked="{x:Bind ViewModel.BatchModeEnabled, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanConfigureBatch, Mode=OneWay}"
                                    TabIndex="5" />
                                <StackPanel
                                    Visibility="{x:Bind ViewModel.BatchModeEnabled, Mode=OneWay}"
                                    Spacing="12">
                                    <TextBlock
                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                        Text="El lote usa un único certificado, operación, formato y perfil. El sello visible se desactiva porque exige previsualización individual."
                                        TextWrapping="Wrap" />
                                <controls:ResponsiveActionPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button MinHeight="40"
                                        AutomationProperties.Name="Añadir documentos al lote"
                                        Click="OnSelectBatchFilesClick"
                                        Content="Añadir archivos…"
                                        IsEnabled="{x:Bind ViewModel.CanSelectBatchSources, Mode=OneWay}"
                                        TabIndex="6" />
                                    <Button MinHeight="40"
                                        AutomationProperties.Name="Añadir carpeta al lote"
                                        Click="OnSelectBatchFolderClick"
                                        Content="Elegir carpeta…"
                                        IsEnabled="{x:Bind ViewModel.CanSelectBatchSources, Mode=OneWay}"
                                        TabIndex="7" />
                                    <Button MinHeight="40"
                                        AutomationProperties.Name="Vaciar selección del lote"
                                        Click="OnClearBatchSelectionClick"
                                        Content="Vaciar lote"
                                        IsEnabled="{x:Bind ViewModel.CanSelectBatchSources, Mode=OneWay}"
                                        TabIndex="8" />
                                </controls:ResponsiveActionPanel>
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind ViewModel.BatchInputSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <controls:ResponsiveActionPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button MinHeight="40"
                                        AutomationProperties.Name="Seleccionar carpeta de salida del lote"
                                        Click="OnSelectBatchOutputClick"
                                        Content="Carpeta de salida…"
                                        IsEnabled="{x:Bind ViewModel.CanSelectBatchOutput, Mode=OneWay}"
                                        TabIndex="9" />
                                </controls:ResponsiveActionPanel>
                                <TextBlock
                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                    Text="{x:Bind ViewModel.BatchOutputSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="FormatColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="FormatRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                AutomationProperties.Name="Operación de firma"
                                DisplayMemberPath="Label"
                                Header="Operación"
                                ItemsSource="{x:Bind ViewModel.Actions}"
                                SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}"
                                TabIndex="10" />
                            <ComboBox
                                x:Name="FormatCombo"
                                Grid.Row="1"
                                AutomationProperties.Name="Formato de firma"
                                DisplayMemberPath="Label"
                                Header="Formato"
                                ItemsSource="{x:Bind ViewModel.Formats, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                                TabIndex="11" />
                        </Grid>

                        <Border
                            x:Name="CentralCertificatePickerPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="CertificatePickerActionColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="CertificatePickerActionRow" Height="Auto" />
                                    </Grid.RowDefinitions>
                                <ComboBox
                                    AutomationProperties.Name="Certificado de firma"
                                    Header="Certificado de firma"
                                    MinHeight="44"
                                    IsEnabled="{x:Bind ViewModel.IsOperationConnected, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.Certificates, Mode=OneWay}"
                                    PlaceholderText="Seleccione un certificado válido"
                                    SelectedItem="{x:Bind ViewModel.SelectedCertificate, Mode=TwoWay}"
                                    TabIndex="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel MaxWidth="760" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    Text="{Binding IssuerDisplay}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        Foreground="{Binding CardStatus, Converter={StaticResource CertificateStatusBrushConverter}}"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding CardStatusText}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                                        Text="{Binding StatusReason}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{Binding TemporaryDisplay}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                    <Button
                                        x:Name="CertificatePickerActionButton"
                                        Grid.Row="1"
                                        MinHeight="44"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Ver todos los certificados"
                                        Click="OnChangeCertificateClick"
                                        Content="⤢ Ver todos los certificados"
                                        TabIndex="13" />
                                </Grid>

                                <TextBlock
                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                    Text="Elija un certificado ya disponible, cargue un archivo solo para esta sesión o impórtelo expresamente en el almacén personal de Windows."
                                    TextWrapping="Wrap" />

                                <controls:ResponsiveActionPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button MinHeight="40"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="Vuelve a consultar los certificados aptos del almacén personal oficial de Windows."
                                        AutomationProperties.Name="Buscar certificados en Windows"
                                        Click="OnRefreshCertificatesClick"
                                        IsEnabled="{x:Bind ViewModel.CanRefreshCertificates, Mode=OneWay}"
                                        TabIndex="14">
                                        <TextBlock
                                            Text="Buscar en Windows"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Button>
                                    <Button MinHeight="40"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="Carga un P12, PFX, PEM, CER o CRT únicamente en memoria hasta cerrar la sesión."
                                        AutomationProperties.Name="Usar archivo de certificado solo durante esta sesión"
                                        Click="OnUseTemporaryCredentialClick"
                                        IsEnabled="{x:Bind ViewModel.CanUseTemporaryCredential, Mode=OneWay}"
                                        TabIndex="15">
                                        <TextBlock
                                            Text="Cargar P12/PFX…"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Button>
                                    <Button MinHeight="40"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="Importa persistentemente un P12 o PFX en Cert:\CurrentUser\My después de una confirmación explícita."
                                        AutomationProperties.Name="Importar archivo de certificado en Windows"
                                        Click="OnImportCredentialToWindowsClick"
                                        IsEnabled="{x:Bind ViewModel.CanImportCredentialToWindows, Mode=OneWay}"
                                        TabIndex="16">
                                        <TextBlock
                                            Text="Importar archivo en Windows"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Button>
                                </controls:ResponsiveActionPanel>
                                <controls:SigningMethodsHelp />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <CheckBox
                                    AutomationProperties.HelpText="Aplica primero el certificado principal y después los certificados adicionales como cofirmas secuenciales, generando una única salida."
                                    AutomationProperties.Name="Activar cofirma múltiple guiada"
                                    Content="Cofirma múltiple guiada"
                                    IsChecked="{x:Bind ViewModel.GuidedMultiCosignEnabled, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanConfigureGuidedMultiCosign, Mode=OneWay}"
                                    TabIndex="17" />
                                <StackPanel
                                    Visibility="{x:Bind ViewModel.GuidedMultiCosignEnabled, Mode=OneWay}"
                                    Spacing="10">
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                        Text="{x:Bind ViewModel.GuidedMultiCosignSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <ListView
                                    x:Name="AdditionalSignersList"
                                    MinHeight="112"
                                    MaxHeight="260"
                                    AutomationProperties.HelpText="Seleccione uno o más certificados distintos del principal. Se aplicarán en el orden mostrado."
                                    AutomationProperties.Name="Certificados adicionales para cofirma múltiple"
                                    IsEnabled="{x:Bind ViewModel.CanSelectAdditionalSigners, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.AdditionalSignerCandidates, Mode=OneWay}"
                                    SelectionChanged="OnAdditionalSignersSelectionChanged"
                                    SelectionMode="Multiple"
                                    TabIndex="18">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="2,6" Spacing="3">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    Text="{Binding IssuerDisplay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander
                            x:Name="AdvancedSignExpander"
                            AutomationProperties.Name="Opciones avanzadas de firma"
                            TabIndex="19">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Opciones avanzadas" TextWrapping="Wrap" />
                                    <TextBlock x:Name="AdvancedSignErrorCount" TextWrapping="Wrap" Foreground="{ThemeResource AppDiagnosticFailureBrush}" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Padding="0,12,0,0" Spacing="12">
                                <ComboBox
                                    AutomationProperties.Name="Perfil de firma"
                                    DisplayMemberPath="Label"
                                    Header="Perfil"
                                    ItemsSource="{x:Bind ViewModel.Profiles}"
                                    SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                    TabIndex="20" />
                                <CheckBox
                                    AutomationProperties.HelpText="Usa la geometría real obtenida del PDF y solo se habilita para PAdES o Automático."
                                    AutomationProperties.Name="Añadir sello visible en documentos PDF"
                                    Content="Añadir sello visible en PDF"
                                    IsChecked="{x:Bind ViewModel.VisibleSealEnabled, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanConfigureVisibleSeal, Mode=OneWay}"
                                    TabIndex="21" />

                                <Border
                                    Visibility="{x:Bind ViewModel.VisibleSealEnabled, Mode=OneWay}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                    <ContentControl
                                        HorizontalContentAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.CanRefreshVisibleSealPreview, Mode=OneWay}">
                                        <StackPanel x:Name="VisibleSealEditorPanel" Spacing="14">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="Configuración del sello visible"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="Elija el aspecto del sello y en qué páginas estamparlo. Después cargue la previsualización: arrastre el sello para colocarlo y su esquina para ampliarlo o reducirlo. También puede ajustarlo con el teclado: X se mide desde la izquierda e Y desde abajo."
                                            TextWrapping="Wrap" />

                                        <ComboBox
                                            AutomationProperties.HelpText="Institucional muestra el emblema de firma de la Diputación; también puede usar solo texto o una imagen propia."
                                            AutomationProperties.Name="Estilo del sello visible"
                                            DisplayMemberPath="Label"
                                            Header="Estilo del sello"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.VisibleSealStyles}"
                                            SelectedItem="{x:Bind ViewModel.SelectedVisibleSealStyle, Mode=TwoWay}"
                                            TabIndex="22" />
                                        <TextBlock
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{x:Bind ViewModel.VisibleSealStyleDescription, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Orientation="Vertical"
                                            Spacing="12"
                                            Visibility="{x:Bind ViewModel.IsVisibleSealCustomImageStyle, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button
                                                    x:Name="VisibleSealImageButton"
                                                    AutomationProperties.Name="Elegir imagen del sello"
                                                    Click="OnPickVisibleSealImageClick"
                                                    Content="Elegir imagen…"
                                                    MinHeight="40"
                                                    TabIndex="23" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind ViewModel.VisibleSealImageSummary, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="VisibleSealImageError" Foreground="{ThemeResource AppDiagnosticFailureBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>

                                        <Grid
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind ViewModel.VisibleSealEnabled, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider
                                                AutomationProperties.Name="{x:Bind ViewModel.VisibleSealLogoOpacityLabel, Mode=OneWay}"
                                                AutomationProperties.HelpText="{x:Bind ViewModel.VisibleSealOpacityHelp, Mode=OneWay}"
                                                Header="{x:Bind ViewModel.VisibleSealLogoOpacityLabel, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.VisibleSealOpacityHelp, Mode=OneWay}"
                                                LargeChange="10"
                                                Maximum="100"
                                                Minimum="0"
                                                SmallChange="1"
                                                StepFrequency="1"
                                                TabIndex="24"
                                                Value="{x:Bind ViewModel.VisibleSealLogoOpacityPercent, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.LiveSetting="Polite"
                                                Text="{x:Bind ViewModel.VisibleSealLogoOpacityDisplay, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </Grid>

                                        <CheckBox
                                            AutomationProperties.HelpText="Incluye en el sello el nombre del firmante, la fecha y el emisor del certificado; sin esta opción conserva únicamente el rótulo de firma digital."
                                            AutomationProperties.Name="Mostrar identidad ubicación y fecha en el sello"
                                            Content="Mostrar identidad, ubicación y fecha"
                                            IsChecked="{x:Bind ViewModel.VisibleSealKeepText, Mode=TwoWay}"
                                            TabIndex="25" />

                                        <CheckBox
                                            AutomationProperties.HelpText="Añade al sello un código QR que abre la dirección indicada para que cualquiera pueda comprobar el documento."
                                            AutomationProperties.Name="Añadir código QR de verificación al sello"
                                            Content="Añadir código QR de verificación"
                                            IsChecked="{x:Bind ViewModel.VisibleSealQrEnabled, Mode=TwoWay}"
                                            TabIndex="26" />
                                        <TextBox
                                            x:Name="VisibleSealQrUrlTextBox"
                                            AutomationProperties.HelpText="Dirección HTTPS completa que abrirá el QR, por ejemplo la página de verificación de su sede electrónica."
                                            AutomationProperties.Name="Dirección de verificación del QR"
                                            Header="Dirección de verificación (HTTPS)"
                                            InputScope="Url"
                                            IsEnabled="{x:Bind ViewModel.VisibleSealQrEnabled, Mode=OneWay}"
