                                Click="OnSignClick"
                                Content="Firmar documento"
                                IsEnabled="{x:Bind ViewModel.CanSign, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="51" />
                            <Button MinHeight="40"
                                x:Name="BatchSignButton"
                                Visibility="{x:Bind ViewModel.BatchModeEnabled, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="Envía la selección completa a sign_batch y conserva los resultados parciales confirmados por el motor."
                                AutomationProperties.Name="Firmar lote de documentos"
                                Click="OnSignBatchClick"
                                Content="Firmar lote"
                                IsEnabled="{x:Bind ViewModel.CanRunBatch, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="52" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Cancelar operación de firma"
                                Click="OnCancelClick"
                                Content="Cancelar operación"
                                IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                                TabIndex="53" />
                            <ProgressRing
                                Width="28"
                                Height="28"
                                AutomationProperties.Name="Operación de firma en curso"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <ProgressBar
                                Visibility="{x:Bind ViewModel.BatchModeEnabled, Mode=OneWay}"
                                MinWidth="240"
                                AutomationProperties.Name="Progreso de firma por lotes"
                                IsIndeterminate="{x:Bind ViewModel.IsBatchProgressIndeterminate, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.BatchProgressMaximum, Mode=OneWay}"
                                Value="{x:Bind ViewModel.BatchProgressValue, Mode=OneWay}" />
                        </controls:ResponsiveActionPanel>
                    </StackPanel>
                </Border>

                <Border
                    Visibility="{x:Bind ViewModel.BatchModeEnabled, Mode=OneWay}"
                    Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Resultado del lote" />
                        <InfoBar
                            AutomationProperties.LiveSetting="Assertive"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasBatchResults, Mode=OneWay}"
                            Message="{x:Bind ViewModel.BatchProgressText, Mode=OneWay}"
                            Severity="Informational"
                            Title="Estado de la firma por lotes" />
                        <ItemsControl
                            AutomationProperties.Name="Resultados de firma por documento"
                            ItemsSource="{x:Bind ViewModel.BatchItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding DocumentName}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding Status}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button MinHeight="40"
                            x:Name="BatchResultButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Abrir carpeta de resultados del lote"
                            Click="OnOpenBatchResultsClick"
                            Content="Abrir carpeta de resultados"
                            IsEnabled="{x:Bind ViewModel.CanOpenBatchOutput, Mode=OneWay}"
                            TabIndex="54" />
                    </StackPanel>
                </Border>
            </StackPanel>
