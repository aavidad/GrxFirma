                                                            Width="{x:Bind ViewModel.VisibleSealPreviewWidth, Mode=OneWay}"
                                                            Height="{x:Bind ViewModel.VisibleSealPreviewHeight, Mode=OneWay}"
                                                            Canvas.Left="{x:Bind ViewModel.VisibleSealPreviewX, Mode=OneWay}"
                                                            Canvas.Top="{x:Bind ViewModel.VisibleSealPreviewTop, Mode=OneWay}"
                                                            Background="Transparent"
                                                            BorderBrush="{ThemeResource AppSealBorderBrush}"
                                                            BorderThickness="3"
                                                            CornerRadius="4"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            PointerPressed="OnVisibleSealMovePointerPressed">
