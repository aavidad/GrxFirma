                x:Name="CertificateSidebar"
                Grid.Row="1"
                VerticalAlignment="Top"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel x:Name="CertificateExpandedPanel" Spacing="12">
                    <Button MinHeight="44"
                        AutomationProperties.Name="Ocultar panel de certificados"
                        Click="OnHideCertificatePanelClick"
                        Content="Ocultar"
                        TabIndex="55" />
                    <Button MinHeight="40"
                        AutomationProperties.Name="Importar certificados"
                        Click="OnImportCredentialToWindowsClick"
                        Content="+ Certificados"
                        IsEnabled="{x:Bind ViewModel.CanImportCredentialToWindows, Mode=OneWay}"
                        TabIndex="56" />
                    <Button MinHeight="40"
                        AutomationProperties.Name="Usar DNIe o tarjeta"
                        Click="OnUseSmartcardClick"
                        Content="Usar DNIe o tarjeta"
                        IsEnabled="{x:Bind CertificatePanel.IsOperationConnected, Mode=OneWay}"
                        TabIndex="57" />
                    <InfoBar
                        x:Name="SmartcardInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational"
                        Title="DNIe o tarjeta">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="OfficialDNIeButton"
                                MinHeight="40"
                                AutomationProperties.Name="Abrir web oficial del DNIe"
                                Click="OnOpenOfficialDNIeClick"
                                Content="Web oficial del DNIe"
                                TabIndex="58"
                                Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBox
                        AutomationProperties.Name="Buscar certificado"
                        IsEnabled="{x:Bind CertificatePanel.IsOperationConnected, Mode=OneWay}"
                        PlaceholderText="Buscar certificado"
                        TabIndex="59"
                        Text="{x:Bind CertificatePanel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource AppMutedTextBrush}"
                        Text="{x:Bind CertificatePanel.VisibleCountText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="{x:Bind CertificatePanel.IsExpiryNoticeOpen, Mode=OneWay}"
                        Message="{x:Bind CertificatePanel.ExpiryNoticeMessage, Mode=OneWay}"
                        Severity="{x:Bind CertificatePanel.ExpiryNoticeSeverity, Mode=OneWay}"
                        Title="Caducidad del certificado">
                        <InfoBar.ActionButton>
                            <Button
                                MinHeight="40"
                                AutomationProperties.Name="Renovar certificado próximo a caducar en la FNMT"
                                Click="OnRenewPanelFnmtClick"
                                Content="Renovar en la FNMT"
                                TabIndex="60"
                                Visibility="{x:Bind CertificatePanel.CanRenewExpiryNoticeCertificate, Mode=OneWay}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ListView
                        x:Name="PanelCertificateList"
                        MaxHeight="360"
                        MinHeight="120"
                        AutomationProperties.Name="Certificados para firma"
                        IsEnabled="{x:Bind CertificatePanel.IsOperationConnected, Mode=OneWay}"
                        ItemsSource="{x:Bind CertificatePanel.VisibleCertificates, Mode=OneWay}"
                        SelectedItem="{x:Bind CertificatePanel.SelectedCertificate, Mode=TwoWay}"
                        SelectionChanged="OnPanelCertificateSelectionChanged"
                        ContainerContentChanging="OnPanelCertificateContainerContentChanging"
                        SelectionMode="Single"
                        TabIndex="61">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="Transparent"
                                    Padding="2">
                                    <StackPanel
                                        AutomationProperties.HelpText="{Binding SuitabilitySummary}"
                                        Spacing="4">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding CardStatus, Converter={StaticResource CertificateStatusBrushConverter}}"
                                                Text="{Binding CardStatusText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource AppMutedTextBrush}"
                                            Text="{Binding StatusReason}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource AppDiagnosticSuccessBrush}"
                                            Text="{Binding DefaultDisplay}"
                                            TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding ExpirationDisplay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding ShortIssuerDisplay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="Seleccione un certificado para ver sus datos."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind CertificatePanel.ShowCertificateDetailHint, Mode=OneWay}" />
                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{x:Bind CertificatePanel.HasSelectedCertificate, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                FontWeight="SemiBold"
                                Text="Detalles del certificado"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind CertificatePanel.SelectedCertificateSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                IsTabStop="False"
                                ItemsSource="{x:Bind CertificatePanel.SelectedCertificateDetails, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding Label}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding Value}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind CertificatePanel.CanRenewSelectedCertificate, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                    Text="{x:Bind CertificatePanel.SelectedCertificateRenewalMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button MinHeight="40"
                                    AutomationProperties.HelpText="Abre en el navegador la página oficial de renovación del certificado de ciudadano de la FNMT."
                                    AutomationProperties.Name="Renovar el certificado en la FNMT"
                                    Click="OnRenewPanelFnmtClick"
                                    Content="Renovar en la FNMT"
                                    Style="{StaticResource AccentButtonStyle}"
                                    TabIndex="62" />
                            </StackPanel>
                            <Button MinHeight="40"
                                AutomationProperties.Name="Usar certificado como predeterminado"
                                Click="OnSetPanelDefaultCertificateClick"
                                Content="Usar como predeterminado"
                                IsEnabled="{x:Bind CertificatePanel.CanSetSelectedAsDefault, Mode=OneWay}"
                                TabIndex="63" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Quitar certificado predeterminado"
                                Click="OnClearPanelDefaultCertificateClick"
                                Content="Quitar predeterminado"
                                IsEnabled="{x:Bind CertificatePanel.CanClearDefaultCertificate, Mode=OneWay}"
                                TabIndex="64" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Verificar certificado seleccionado"
                                Click="OnShowPanelCertificateValidationClick"
                                Content="Verificar certificado"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="65" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Refrescar validez online del certificado"
                                Click="OnValidatePanelCertificateOnlineClick"
                                Content="Refrescar validez online"
                                IsEnabled="{x:Bind CertificatePanel.CanValidateSelectedCertificate, Mode=OneWay}"
                                TabIndex="66" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Abrir VALIDe"
                                Click="OnOpenPanelValideClick"
                                Content="Abrir VALIDe"
                                TabIndex="67" />
                        </StackPanel>
                    </Border>
                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind CertificatePanel.ActionStatusMessage, Mode=OneWay}"
                        Severity="{x:Bind CertificatePanel.ActionStatusSeverity, Mode=OneWay}"
                        Title="{x:Bind CertificatePanel.ActionStatusTitle, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
