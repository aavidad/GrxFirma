                                                                    AutomationProperties.HelpText="{x:Bind ViewModel.VisibleSealRotateHandleHelp, Mode=OneWay}"
                                                                    Background="{ThemeResource AppSealHandleBrush}"
                                                                    BorderBrush="{ThemeResource AppSealHandleTextBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="22"
                                                                    KeyDown="OnVisibleSealRotateKeyDown"
                                                                    PointerCanceled="OnVisibleSealPreviewPointerCanceled"
                                                                    PointerCaptureLost="OnVisibleSealPreviewPointerCaptureLost">
                                                                    <TextBlock
                                                                        FontSize="25"
                                                                        Foreground="{ThemeResource AppSealHandleTextBrush}"
                                                                        Text="↻"
                                                                        TextWrapping="Wrap" />
                                                                </controls:SealRotateButton>
                                                                <Border
                                                                    x:Name="VisibleSealResizeHandle"
                                                                    Width="36"
                                                                    Height="36"
                                                                    Margin="0,0,-3,-3"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    AutomationProperties.HelpText="Arrastre para cambiar el ancho y el alto del sello."
                                                                    AutomationProperties.Name="Redimensionar zona del sello"
                                                                    Background="{ThemeResource AppSealHandleBrush}"
                                                                    BorderBrush="{ThemeResource AppSealHandleTextBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="3"
                                                                    PointerPressed="OnVisibleSealResizePointerPressed"
                                                                    ToolTipService.ToolTip="Arrastrar para cambiar el tamaño">
                                                                    <FontIcon
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource AppSealHandleTextBrush}"
                                                                        Glyph="&#xE740;" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ContentControl x:Name="VisibleSealDrawInput" Visibility="Collapsed" IsTabStop="True" UseSystemFocusVisuals="True" TabIndex="49"
                                                            Width="{x:Bind ViewModel.PreviewCanvasWidth, Mode=OneWay}"
                                                            Height="{x:Bind ViewModel.PreviewCanvasHeight, Mode=OneWay}"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            AutomationProperties.Name="{x:Bind ViewModel.VisibleSealDrawAreaLabel, Mode=OneWay}"
                                                            AutomationProperties.HelpText="{x:Bind ViewModel.VisibleSealDrawAreaHelp, Mode=OneWay}"
                                                            KeyDown="OnVisibleSealDrawKeyDown">
                                                            <ContentControl.Template>
                                                                <ControlTemplate TargetType="ContentControl">
                                                                    <Grid Background="Transparent" />
                                                                </ControlTemplate>
                                                            </ContentControl.Template>
                                                        </ContentControl>
                                                        <Border x:Name="VisibleSealDrawRubberBand" Visibility="Collapsed"
                                                            IsHitTestVisible="False" Background="{ThemeResource AppSealTextBackgroundBrush}"
                                                            Opacity="0.6" BorderBrush="{ThemeResource AppSealBorderBrush}" BorderThickness="2" />
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                        </Viewbox>
                                        </StackPanel>
                                    </ContentControl>
                                </Border>
                                <CheckBox
                                    AutomationProperties.HelpText="Comprueba la firma generada mediante la operación verify antes de mostrar el resultado como validado."
                                    AutomationProperties.Name="Validar el resultado al terminar"
                                    Content="Validar el resultado al terminar"
                                    IsChecked="{x:Bind ViewModel.ValidateAfterSigning, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanValidateAfterSigning, Mode=OneWay}"
                                    TabIndex="50" />
                            </StackPanel>
                        </Expander>

                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />

