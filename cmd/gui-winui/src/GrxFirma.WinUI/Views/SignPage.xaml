                                                IsEnabled="{x:Bind ViewModel.CanGoToNextSealPage, Mode=OneWay}"
                                                Click="OnNextSealPageClick" />
                                        </StackPanel>
                                        <CheckBox Content="{x:Bind ViewModel.SealOneByOneLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SealOneByOneLabel, Mode=OneWay}"
                                            TabIndex="47"
                                            IsChecked="{x:Bind ViewModel.PerPageSealEnabled, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{x:Bind ViewModel.PerPageSealEnabled, Mode=OneWay}">
                                            <Button Content="{x:Bind ViewModel.SealApplyAllLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SealApplyAllLabel, Mode=OneWay}"
                                                MinHeight="40" TabIndex="48"
