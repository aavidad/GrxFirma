                            x:Name="SignActions"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button MinHeight="40"
                                x:Name="SignButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="Firma el documento mediante el motor local autenticado y el certificado seleccionado."
