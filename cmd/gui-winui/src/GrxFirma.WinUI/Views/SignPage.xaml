                                                Minimum="0"
                                                SmallChange="1"
                                                StepFrequency="1"
                                                Value="{x:Bind ViewModel.VisibleSealRotationDegrees, Mode=TwoWay}" />
                                        </Grid>

                                        <TextBox
                                            AutomationProperties.Name="Motivo de la firma PDF"
