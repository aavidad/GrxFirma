                                                                                FontSize="15"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{ThemeResource AppSealTextBrush}"
                                                                                Text="FIRMADO DIGITALMENTE"
                                                                                TextWrapping="Wrap" />
                                                                            <TextBlock
                                                                                FontSize="12"
                                                                                Foreground="{ThemeResource AppSealTextBrush}"
                                                                                Text="{x:Bind ViewModel.VisibleSealPreviewText, Mode=OneWay}"
                                                                                TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Viewbox>
