                                                                <RotateTransform Angle="{x:Bind ViewModel.VisibleSealPreviewRotation, Mode=OneWay}" />
                                                            </Border.RenderTransform>
                                                            <Grid>
                                                                <Image
                                                                    x:Name="VisibleSealStampPreview"
