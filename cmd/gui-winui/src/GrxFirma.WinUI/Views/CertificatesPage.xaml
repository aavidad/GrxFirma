<Page
    x:Class="GrxFirma.WinUI.Views.CertificatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GrxFirma.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    Background="{ThemeResource AppPageBackgroundBrush}">

    <Page.Resources>
        <controls:CertificateStatusBrushConverter x:Key="CertificateStatusBrushConverter" />
        <SolidColorBrush x:Key="CertificateSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}" />
    </Page.Resources>

    <ScrollViewer
        AutomationProperties.Name="Contenido de certificados"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Padding" Value="32" />
                        <Setter Target="FilterUpdateColumn.Width" Value="Auto" />
                        <Setter Target="FilterImportColumn.Width" Value="Auto" />
                        <Setter Target="FilterUpdateRow.Height" Value="0" />
                        <Setter Target="FilterImportRow.Height" Value="0" />
                        <Setter Target="UpdateButton.(Grid.Column)" Value="1" />
                        <Setter Target="UpdateButton.(Grid.Row)" Value="0" />
                        <Setter Target="ImportButton.(Grid.Column)" Value="2" />
                        <Setter Target="ImportButton.(Grid.Row)" Value="0" />
                        <Setter Target="CertificateActions.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid
            x:Name="LayoutRoot"
            MaxWidth="1080"
            Padding="16"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="{x:Bind ViewModel.Title}" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Description}"
                    TextWrapping="Wrap" />
                <controls:SigningMethodsHelp />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsAvailabilityNoticeOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.PendingMessage, Mode=OneWay}"
                Severity="Informational"
                Title="Disponibilidad del almacén" />

            <Border Grid.Row="2" Style="{StaticResource AppCardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="FilterUpdateColumn" Width="0" />
                            <ColumnDefinition x:Name="FilterImportColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="FilterUpdateRow" Height="Auto" />
                            <RowDefinition x:Name="FilterImportRow" Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            AutomationProperties.Name="Buscar"
                            AutomationProperties.HelpText="Filtrar certificados"
                            Header="Buscar"
                            MinHeight="40"
                            IsEnabled="{x:Bind ViewModel.IsOperationConnected, Mode=OneWay}"
                            PlaceholderText="Buscar certificado"
                            TabIndex="0"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button MinHeight="40"
                            x:Name="UpdateButton"
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Actualizar certificados"
                            Click="OnRefreshClick"
                            Content="Actualizar"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            TabIndex="1" />
                        <Button MinHeight="40"
                            x:Name="ImportButton"
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            AutomationProperties.HelpText="Selecciona una credencial sin copiar su contenido ni su contraseña a controles de texto."
                            AutomationProperties.Name="Elegir credencial…"
                            Click="OnSelectImportCredentialClick"
                            Content="Elegir credencial…"
                            IsEnabled="{x:Bind ViewModel.CanSelectCredential, Mode=OneWay}"
                            TabIndex="2"
                            ToolTipService.ToolTip="Admite P12, PFX, PEM, CER y CRT hasta 2 MiB." />
                        <Button MinHeight="40"
                            Grid.Row="3"
                            Grid.ColumnSpan="3"
                            AutomationProperties.Name="Usar DNIe o tarjeta"
                            Click="OnUseSmartcardClick"
                            Content="Usar DNIe o tarjeta"
                            IsEnabled="{x:Bind ViewModel.IsOperationConnected, Mode=OneWay}"
                            TabIndex="3" />
                        <InfoBar
                            x:Name="SmartcardInfoBar"
                            Grid.Row="4"
                            Grid.ColumnSpan="3"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Informational"
                            Title="DNIe o tarjeta">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="OfficialDNIeButton"
                                    MinHeight="40"
                                    AutomationProperties.Name="Abrir web oficial del DNIe"
                                    Click="OnOpenOfficialDNIeClick"
                                    Content="Web oficial del DNIe"
                                    TabIndex="4"
                                    Visibility="Collapsed" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Spacing="8">
                            <TextBlock x:Name="CertificateTypeFilterTitle"
                                FontWeight="SemiBold" />
                            <CheckBox x:Name="FilterPersonalCheck"
                                IsChecked="{x:Bind ViewModel.FilterPersonal, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Content, ElementName=FilterPersonalCheck}"
                                TabIndex="5" />
                            <CheckBox x:Name="FilterRepresentativeCheck"
                                IsChecked="{x:Bind ViewModel.FilterRepresentative, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Content, ElementName=FilterRepresentativeCheck}"
                                TabIndex="6" />
                            <CheckBox x:Name="FilterSealCheck"
                                IsChecked="{x:Bind ViewModel.FilterSeal, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Content, ElementName=FilterSealCheck}"
                                TabIndex="7" />
                            <CheckBox x:Name="FilterPublicEmployeeCheck"
                                IsChecked="{x:Bind ViewModel.FilterPublicEmployee, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Content, ElementName=FilterPublicEmployeeCheck}"
                                TabIndex="8" />
                            <CheckBox x:Name="RequireNifFilter"
                                IsChecked="{x:Bind ViewModel.RequireNif, Mode=TwoWay}"
                                TabIndex="9"
                            AutomationProperties.Name="{Binding Content, ElementName=RequireNifFilter}" />
                            <CheckBox x:Name="RequireOrganizationFilter"
                                IsChecked="{x:Bind ViewModel.RequireOrganization, Mode=TwoWay}"
                                TabIndex="10"
                            AutomationProperties.Name="{Binding Content, ElementName=RequireOrganizationFilter}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="2"
                                AutomationProperties.LiveSetting="Polite"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.SelectedCredentialDisplayName, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.Name="Uso y destino"
                                AutomationProperties.HelpText="Destino de la credencial"
                                Header="Uso y destino"
                                IsEnabled="{x:Bind ViewModel.CanSelectCredential, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.ImportOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedImportOption, Mode=TwoWay}"
                                TabIndex="11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel MaxWidth="680" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Label}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="La contraseña se solicita en una ventana nativa protegida y se borra al finalizar."
                                TextWrapping="Wrap" />
                            <Button MinHeight="40"
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationProperties.Name="Cargar / importar"
                                AutomationProperties.HelpText="Cargar o importar credencial"
                                Click="OnImportCredentialClick"
                                Content="Cargar / importar"
                                IsEnabled="{x:Bind ViewModel.CanImportCredential, Mode=OneWay}"
                                TabIndex="12" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" MinHeight="180" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="{x:Bind ViewModel.CatalogMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="{x:Bind ViewModel.VisibleCountText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <InfoBar
                            Grid.Row="2"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsExpiryNoticeOpen, Mode=OneWay}"
                            Message="{x:Bind ViewModel.ExpiryNoticeMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.ExpiryNoticeSeverity, Mode=OneWay}"
                            Title="Caducidad del certificado">
                            <InfoBar.ActionButton>
                                <Button
                                    MinHeight="40"
                                    AutomationProperties.Name="Renovar en la FNMT"
                                    AutomationProperties.HelpText="Renovar certificado próximo a caducar en la FNMT"
                                    Click="OnRenewFnmtClick"
                                    Content="Renovar en la FNMT"
                                    TabIndex="13"
                                    Visibility="{x:Bind ViewModel.CanRenewExpiryNoticeCertificate, Mode=OneWay}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <ListView
                            Grid.Row="3"
                            AutomationProperties.Name="Certificados disponibles"
                            ContainerContentChanging="OnCertificateContainerContentChanging"
                            IsEnabled="{x:Bind ViewModel.IsOperationConnected, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.VisibleCertificates, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCertificate, Mode=TwoWay}"
                            SelectionChanged="OnCertificateSelectionChanged"
                            SelectionMode="Single"
                            TabIndex="14">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="Transparent"
                                        Padding="2">
                                        <StackPanel
                                            AutomationProperties.HelpText="{Binding SuitabilitySummary}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Spacing="3">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding CardStatus, Converter={StaticResource CertificateStatusBrushConverter}}"
                                                    Text="{Binding CardStatusText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding StatusReason}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppDiagnosticSuccessBrush}"
                                                Text="{Binding DefaultDisplay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{Binding TemporaryDisplay}"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    Text="{Binding ExpirationDisplay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    Text="{Binding ShortIssuerDisplay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>


                        <TextBlock
                            Grid.Row="4"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Seleccione un certificado para ver todos sus datos."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ShowCertificateDetailHint, Mode=OneWay}" />
                        <Border
                            Grid.Row="4"
                            AutomationProperties.Name="Datos del certificado seleccionado"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind ViewModel.HasSelectedCertificate, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontWeight="SemiBold"
                                    Text="Detalles del certificado"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.SelectedCertificateTitle, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedCertificateSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ItemsControl
                                    AutomationProperties.Name="Ficha del certificado"
                                    IsTabStop="False"
                                    ItemsSource="{x:Bind ViewModel.SelectedCertificateDetails, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    Text="{Binding Label}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{Binding Value}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.CanRenewSelectedCertificate, Mode=OneWay}">
                                    <TextBlock
                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                        Text="{x:Bind ViewModel.SelectedCertificateRenewalMessage, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        MinHeight="40"
                                        AutomationProperties.HelpText="Abre en el navegador la página oficial de renovación del certificado de ciudadano de la FNMT."
                                        AutomationProperties.Name="Renovar en la FNMT"
                                        Click="OnRenewFnmtClick"
                                        Content="Renovar en la FNMT"
                                        Style="{StaticResource AccentButtonStyle}"
                                        TabIndex="15" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Vertical"
                        Spacing="8">
                        <controls:ResponsiveActionPanel
                            x:Name="CertificateActions"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button MinHeight="40"
                                AutomationProperties.Name="Exportar certificado público"
                                Click="OnExportPublicCertificateClick"
                                Content="Exportar certificado público…"
                                IsEnabled="{x:Bind ViewModel.HasSelectedCertificate, Mode=OneWay}"
                                TabIndex="16" />
                            <Button MinHeight="40"
                                x:Name="SetDefaultCertificateButton"
                                AutomationProperties.HelpText="Guarda la identidad estable del certificado mediante las preferencias tipadas del motor local."
                                AutomationProperties.Name="Usar como predeterminado"
                                Click="OnSetDefaultCertificateClick"
                                IsEnabled="{x:Bind ViewModel.CanSetSelectedAsDefault, Mode=OneWay}"
                                TabIndex="17">
                                <TextBlock
                                    Text="Usar como predeterminado"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button MinHeight="40"
                                x:Name="ClearDefaultCertificateButton"
                                AutomationProperties.HelpText="Quita la preferencia guardada sin modificar el resto de la configuración."
                                AutomationProperties.Name="Quitar predeterminado"
                                Click="OnClearDefaultCertificateClick"
                                IsEnabled="{x:Bind ViewModel.CanClearDefaultCertificate, Mode=OneWay}"
                                TabIndex="18">
                                <TextBlock
                                    Text="Quitar predeterminado"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button MinHeight="40"
                                x:Name="ValidateCertificateButton"
                                AutomationProperties.HelpText="Muestra la aptitud y la ficha completa del certificado seleccionado."
                                AutomationProperties.Name="Verificar certificado seleccionado"
                                Click="OnShowCertificateValidationClick"
                                IsEnabled="{x:Bind ViewModel.HasSelectedCertificate, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="19">
                                <TextBlock
                                    Text="Verificar certificado"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button MinHeight="40"
                                AutomationProperties.Name="Refrescar validez online del certificado"
                                Click="OnValidateCertificateClick"
                                Content="Refrescar validez online"
                                IsEnabled="{x:Bind ViewModel.CanValidateSelectedCertificate, Mode=OneWay}"
                                TabIndex="20" />
                            <Button MinHeight="40"
                                AutomationProperties.Name="Abrir VALIDe"
                                Click="OnOpenValideClick"
                                Content="Abrir VALIDe"
                                TabIndex="21" />
                            <Button MinHeight="40"
                                x:Name="OpenCertificateManagerButton"
                                AutomationProperties.HelpText="Abre el gestor que el motor local ha descubierto y autorizado."
                                AutomationProperties.Name="Abrir gestor de Windows"
                                Click="OnOpenCertificateManagerClick"
                                IsEnabled="{x:Bind ViewModel.CanOpenCertificateManager, Mode=OneWay}"
                                TabIndex="22">
                                <TextBlock
                                    Text="Abrir gestor de Windows"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button MinHeight="40"
                                AutomationProperties.HelpText="Retira de memoria la credencial temporal seleccionada sin modificar almacenes persistentes."
                                AutomationProperties.Name="Retirar temporal seleccionada"
                                Click="OnRemoveTemporaryCertificateClick"
                                IsEnabled="{x:Bind ViewModel.CanRemoveSelectedTemporary, Mode=OneWay}"
                                TabIndex="23">
                                <TextBlock
                                    Text="Retirar temporal seleccionada"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button MinHeight="40"
                                AutomationProperties.HelpText="Retira de memoria todas las credenciales cargadas solo para esta sesión."
                                AutomationProperties.Name="Retirar todas las temporales"
                                Click="OnClearTemporaryCertificatesClick"
                                IsEnabled="{x:Bind ViewModel.CanClearTemporaryCertificates, Mode=OneWay}"
                                TabIndex="24">
                                <TextBlock
                                    Text="Retirar todas las temporales"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <ProgressRing
                                Width="28"
                                Height="28"
                                AutomationProperties.Name="Operación de certificados en curso"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        </controls:ResponsiveActionPanel>
                        <InfoBar
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.ActionStatusMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.ActionStatusSeverity, Mode=OneWay}"
                            Title="{x:Bind ViewModel.ActionStatusTitle, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
