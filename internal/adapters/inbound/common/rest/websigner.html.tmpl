        if (!outputPath.toLowerCase().endsWith(suffix.toLowerCase())) {
          ui.outputArtifactSummary.innerHTML = '<strong>' + escapeHtml(t("outputArtifactTitle")) + ':</strong> ' + escapeHtml(t("outputArtifactMismatch") + suffix);
          return;
        }
        ui.outputArtifactSummary.innerHTML = '<strong>' + escapeHtml(t("outputArtifactTitle")) + ':</strong> ' + escapeHtml(t("outputArtifactMatch") + suffix);
      }

