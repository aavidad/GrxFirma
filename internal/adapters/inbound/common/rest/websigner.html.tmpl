<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <title>{{index .Messages "title"}} - GrxFirma</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root{
      color-scheme: light;
      --bg:#edf3f8;
      --panel:#ffffff;
      --panel-2:#f8fbfd;
      --text:#12324d;
      --muted:#5c7288;
      --line:#cedae6;
      --primary:#005ea8;
      --primary-2:#0a78d0;
      --ok:#1e8449;
      --warn:#b9770e;
      --bad:#c0392b;
      --accent:#1373c4;
      --accent-soft:rgba(19,115,196,.15);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background:
        radial-gradient(circle at top left, rgba(10,120,208,.14), transparent 20rem),
        radial-gradient(circle at bottom right, rgba(0,94,168,.10), transparent 24rem),
        var(--bg);
      color:var(--text);
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }
    .page{max-width:1380px;margin:0 auto;padding:28px}
    .hero{
      background:linear-gradient(135deg, rgba(255,255,255,.92), rgba(225,238,249,.92));
      border:1px solid var(--line);
      border-radius:20px;
      padding:24px;
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:18px;
      box-shadow:0 22px 48px rgba(18,50,77,.08);
    }
    h1{margin:0 0 8px;font-size:2rem;color:var(--primary)}
    p{margin:0}
    .muted{color:var(--muted)}
    .hero-actions{display:flex;gap:10px;flex-wrap:wrap}
    .language-picker{
      min-width:220px;
      display:flex;
      flex-direction:column;
      gap:6px;
    }
    .btn,.link-btn,button{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      border:none;
      border-radius:12px;
      padding:11px 16px;
      font:inherit;
      font-weight:700;
      cursor:pointer;
      text-decoration:none;
      background:var(--primary);
      color:#fff;
    }
    .btn.secondary, .link-btn.secondary, button.secondary{
      background:#0f172a;
    }
    button.light{
      background:#dbe8f4;
      color:#173550;
    }
    .status{
      margin-top:16px;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid transparent;
      font-weight:600;
    }
    .status.ok{background:#e9f8ef;border-color:#b7e5c9;color:#166534}
    .status.warn{background:#fff5e7;border-color:#f3d3ac;color:#9a5a09}
    .status.bad{background:#fdecec;border-color:#f4c3bf;color:#9a2f22}
    .grid{
      margin-top:22px;
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:18px;
    }
    .stack{display:flex;flex-direction:column;gap:18px}
    .card{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:20px;
      padding:20px;
      box-shadow:0 12px 32px rgba(18,50,77,.06);
    }
    .card h2{margin:0 0 12px;font-size:1.15rem}
    .field{display:flex;flex-direction:column;gap:6px;margin-bottom:12px}
    .field-row{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
    }
    label{
      font-size:.9rem;
      font-weight:700;
      color:var(--muted);
    }
    input[type="text"],input[type="number"],select{
      width:100%;
      border:1px solid var(--line);
      border-radius:12px;
      padding:11px 12px;
      background:#fff;
      color:var(--text);
      font:inherit;
    }
    input[type="checkbox"]{transform:scale(1.1)}
    .check{display:flex;align-items:center;gap:8px;font-weight:600}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .dropzone{
      border:2px dashed #9ec3e3;
      border-radius:18px;
      background:linear-gradient(180deg, rgba(240,247,252,.94), rgba(248,251,253,.94));
      padding:28px 20px;
      text-align:center;
      color:var(--muted);
      font-weight:600;
      cursor:pointer;
      transition:.15s ease;
    }
    .dropzone.drag{border-color:var(--primary);background:#eef6fd;color:var(--primary)}
    .meta{
      margin-top:12px;
      padding:12px;
      background:var(--panel-2);
      border:1px solid var(--line);
      border-radius:14px;
      font-size:.92rem;
    }
    .cert-summary{margin-top:10px;padding:12px;border-radius:14px;background:var(--panel-2);border:1px solid var(--line)}
    .seal-controls[hidden]{display:none}
    .preview-shell{
      margin-top:12px;
      padding:16px;
      border-radius:18px;
      background:linear-gradient(180deg, #f5f9fc, #eef5fb);
      border:1px solid var(--line);
    }
    .preview-stage{
      position:relative;
      width:min(100%, 540px);
      aspect-ratio:595.28 / 841.89;
      margin:0 auto;
      border:1px solid #6d8197;
      border-radius:10px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,251,253,.96)),
        repeating-linear-gradient(180deg, transparent, transparent 39px, rgba(19,115,196,.035) 40px);
      overflow:hidden;
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.8);
    }
    .preview-seal{
      position:absolute;
      background:rgba(19,115,196,.14);
      border:2px solid var(--accent);
      border-radius:10px;
      cursor:move;
      min-width:44px;
      min-height:28px;
      user-select:none;
      touch-action:none;
    }
    .preview-seal-inner{
      height:100%;
      padding:8px;
    }
    .preview-seal-layout{
      height:100%;
      display:flex;
      align-items:center;
      gap:8px;
      overflow:hidden;
    }
    .preview-seal-main{
      min-width:0;
      flex:1 1 auto;
      display:flex;
      flex-direction:column;
      justify-content:center;
      gap:2px;
      overflow:hidden;
      text-align:center;
    }
    .preview-seal-title{
      font-size:clamp(10px, 1.3vw, 14px);
      font-weight:800;
      color:var(--accent);
    }
    .preview-seal-subtitle{
      font-size:clamp(9px, 1.1vw, 12px);
      color:#2d465d;
      line-height:1.2;
    }
    .preview-seal-qr{
      flex:0 0 auto;
      width:clamp(36px, 24%, 74px);
      aspect-ratio:1;
      border-radius:8px;
      border:1px solid rgba(19,115,196,.55);
      background:
        linear-gradient(45deg, rgba(19,115,196,.15) 25%, transparent 25%, transparent 50%, rgba(19,115,196,.15) 50%, rgba(19,115,196,.15) 75%, transparent 75%, transparent),
        linear-gradient(-45deg, rgba(19,115,196,.11) 25%, transparent 25%, transparent 50%, rgba(19,115,196,.11) 50%, rgba(19,115,196,.11) 75%, transparent 75%, transparent),
        #fff;
      background-size:10px 10px;
      display:none;
      align-items:center;
      justify-content:center;
      color:var(--accent);
      font-size:clamp(9px, 1vw, 12px);
      font-weight:800;
      letter-spacing:.08em;
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.9);
    }
    .preview-seal.has-qr .preview-seal-qr{
      display:flex;
    }
    .resize-handle{
      position:absolute;
      width:16px;
      height:16px;
      right:-8px;
      bottom:-8px;
      border-radius:999px;
      background:var(--accent);
      border:2px solid #fff;
      cursor:nwse-resize;
      touch-action:none;
    }
    .result{
      min-height:90px;
      padding:14px;
      border-radius:16px;
      background:#eef4f9;
      border:1px solid var(--line);
      white-space:pre-wrap;
      word-break:break-word;
    }
    .hint{
      margin-top:8px;
      font-size:.9rem;
      color:var(--muted);
    }
    @media (max-width: 1080px){
      .grid{grid-template-columns:1fr}
      .hero{flex-direction:column}
      .field-row{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <div class="page">
    <section class="hero">
      <div>
        <h1>{{index .Messages "title"}}</h1>
        <p class="muted">{{index .Messages "subtitle"}}</p>
        <div id="globalStatus" class="status warn">{{index .Messages "connectionChecking"}}</div>
      </div>
      <div class="hero-actions">
        <div class="language-picker">
          <label for="languageSelect">{{index .Messages "languageSelector"}}</label>
          <select id="languageSelect">
            {{range .Languages}}
            <option value="{{.Code}}"{{if eq $.Lang .Code}} selected{{end}}>{{.Name}}</option>
            {{end}}
          </select>
        </div>
        <a class="link-btn secondary" href="/?lang={{.Lang}}">{{index .Messages "openConsole"}}</a>
        <a class="link-btn secondary" href="/validator?lang={{.Lang}}">{{index .Messages "openValidator"}}</a>
        <a class="link-btn secondary" href="/?lang={{.Lang}}#hashToolsCard">{{index .Messages "openHashTools"}}</a>
        <a class="link-btn" href="/openapi.json?lang={{.Lang}}" target="_blank" rel="noopener">{{index .Messages "openOpenAPI"}}</a>
      </div>
    </section>

    <div class="grid">
      <div class="stack">
        <section class="card">
          <h2>{{index .Messages "fileCardTitle"}}</h2>
          <p class="muted">{{index .Messages "fileHelp"}}</p>
          <label id="dropzone" class="dropzone" for="fileInput">{{index .Messages "dropLabel"}}</label>
          <input id="fileInput" type="file" multiple hidden>
          <input id="directoryInput" type="file" webkitdirectory directory multiple hidden>
          <div class="actions" style="margin-top:12px">
            <button id="pickFileBtn" type="button">{{index .Messages "selectFile"}}</button>
            <button id="pickDirectoryBtn" class="secondary" type="button">{{index .Messages "selectDirectory"}}</button>
            <button id="clearFileBtn" class="light" type="button">{{index .Messages "clearFile"}}</button>
          </div>
          <div id="fileMeta" class="meta"></div>
          <div class="field-row" style="margin-top:12px">
            <div class="field">
              <label for="localPathInput">{{index .Messages "localPath"}}</label>
              <input id="localPathInput" type="text" placeholder="{{index .Messages "localPathPlaceholder"}}">
              <div class="hint">{{index .Messages "localPathHelp"}}</div>
            </div>
            <div class="field">
              <label for="localOutputPathInput">{{index .Messages "outputPath"}}</label>
              <input id="localOutputPathInput" type="text" placeholder="{{index .Messages "outputPathPlaceholder"}}">
            </div>
          </div>
          <div class="actions">
            <label class="check"><input id="saveToDisk" type="checkbox" checked> {{index .Messages "saveToDisk"}}</label>
            <label class="check"><input id="returnB64" type="checkbox" checked> {{index .Messages "returnB64"}}</label>
            <label class="check"><input id="overwriteOutput" type="checkbox"> {{index .Messages "overwrite"}}</label>
          </div>
          <div id="selectionTypeSummary" class="cert-summary" style="margin-top:14px"></div>
        </section>

        <section class="card">
          <h2>{{index .Messages "certificateCardTitle"}}</h2>
          <div class="actions" style="margin-bottom:12px">
            <button id="refreshCertificatesBtn" type="button">{{index .Messages "refreshCertificates"}}</button>
            <button id="autoSelectCertificateBtn" class="light" type="button">{{index .Messages "autoSelectCertificate"}}</button>
            <button id="clearSelectedCertificateBtn" class="light" type="button">{{index .Messages "clearSelectedCertificate"}}</button>
          </div>

          <div id="certificateInventoryStatus" class="cert-summary"></div>

          <div class="field-row" style="margin-top:14px">
            <div class="field">
              <label for="certificateSubjectFilter">{{index .Messages "certificateSubjectFilter"}}</label>
              <input id="certificateSubjectFilter" type="text" placeholder="{{index .Messages "certificateSubjectFilterPlaceholder"}}">
            </div>
            <div class="field">
              <label for="certificateIssuerFilter">{{index .Messages "certificateIssuerFilter"}}</label>
              <input id="certificateIssuerFilter" type="text" placeholder="{{index .Messages "certificateIssuerFilterPlaceholder"}}">
            </div>
          </div>
          <div class="actions" style="margin-top:4px">
            <label class="check"><input id="onlyUsableCertificates" type="checkbox"> {{index .Messages "onlyUsableCertificates"}}</label>
            <label class="check"><input id="onlyValidCertificates" type="checkbox"> {{index .Messages "onlyValidCertificates"}}</label>
            <button id="clearCertificateFiltersBtn" class="light" type="button">{{index .Messages "clearCertificateFilters"}}</button>
          </div>
          <div id="certificateFilterMeta" class="hint"></div>
          <div id="certificateFilterSummary" class="cert-summary"></div>
          <div class="actions" style="margin-top:10px">
            <label class="check"><input id="rememberSelectedCertificate" type="checkbox" checked> {{index .Messages "rememberSelectedCertificate"}}</label>
          </div>
          <div id="certificatePreferenceSummary" class="cert-summary"></div>
          <div id="certificateAutoSelectSummary" class="cert-summary"></div>

          <div class="field">
            <label for="certificateSelect">{{index .Messages "certificate"}}</label>
            <select id="certificateSelect"></select>
          </div>

          <div id="certificateStatus" class="cert-summary"></div>
          <div id="certificateExpiryStatus" class="cert-summary"></div>
          <div id="certificateDetailsSummary" class="cert-summary"></div>
          <div id="certificateExportSummary" class="cert-summary"></div>
          <div id="certificateSummary" class="cert-summary"></div>

          <div class="field-row" style="margin-top:14px">
            <div class="field">
              <label for="formatSelect">{{index .Messages "format"}}</label>
              <select id="formatSelect">
                <option value="AUTO">{{index .Messages "formatOptionAuto"}}</option>
                <option value="PAdES">{{index .Messages "formatOptionPAdES"}}</option>
                <option value="CAdES">{{index .Messages "formatOptionCAdES"}}</option>
                <option value="XAdES">{{index .Messages "formatOptionXAdES"}}</option>
                <option value="XMLdSig">{{index .Messages "formatOptionXMLdSig"}}</option>
                <option value="ODF">{{index .Messages "formatOptionODF"}}</option>
                <option value="OOXML">{{index .Messages "formatOptionOOXML"}}</option>
                <option value="FacturaE">{{index .Messages "formatOptionFacturaE"}}</option>
                <option value="ASiC-XAdES">{{index .Messages "formatOptionASiCXAdES"}}</option>
              </select>
            </div>
            <div class="field">
              <label for="actionSelect">{{index .Messages "action"}}</label>
              <select id="actionSelect">
                <option value="sign">{{index .Messages "actionSign"}}</option>
                <option value="cosign">{{index .Messages "actionCosign"}}</option>
                <option value="countersign">{{index .Messages "actionCountersign"}}</option>
              </select>
              <div class="hint">{{index .Messages "actionHelp"}}</div>
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <label class="check"><input id="strictCompat" type="checkbox"> {{index .Messages "strictCompat"}}</label>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="signProfile">{{index .Messages "signProfile"}}</label>
              <select id="signProfile">
                <option value="baseline">{{index .Messages "signProfileBaseline"}}</option>
                <option value="t">{{index .Messages "signProfileT"}}</option>
                <option value="lt">{{index .Messages "signProfileLT"}}</option>
                <option value="lta">{{index .Messages "signProfileLTA"}}</option>
              </select>
              <div class="hint">{{index .Messages "signProfileHelp"}}</div>
            </div>
            <div class="field">
              <label for="tsaUrl">{{index .Messages "tsaUrl"}}</label>
              <input id="tsaUrl" type="text" placeholder="{{index .Messages "tsaUrlPlaceholder"}}">
              <div class="hint">{{index .Messages "tsaUrlHelp"}}</div>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="padesSubFilter">{{index .Messages "padesSubFilter"}}</label>
              <select id="padesSubFilter">
                <option value="etsi">{{index .Messages "padesSubFilterETSI"}}</option>
                <option value="adobe">{{index .Messages "padesSubFilterAdobe"}}</option>
              </select>
              <div class="hint">{{index .Messages "padesSubFilterHelp"}}</div>
            </div>
          </div>

          <div class="field" style="margin-top:14px">
            <label class="check"><input id="enableMultiCosign" type="checkbox"> {{index .Messages "enableMultiCosign"}}</label>
            <div class="hint">{{index .Messages "enableMultiCosignHelp"}}</div>
          </div>
          <div id="multiCosignControls" class="field" hidden>
            <label for="multiCosignSelect">{{index .Messages "multiCosignAdditionalSigners"}}</label>
            <select id="multiCosignSelect" multiple size="5"></select>
            <div class="actions" style="margin-top:10px">
              <button id="multiCosignSelectAllBtn" class="light" type="button">{{index .Messages "multiCosignSelectAll"}}</button>
              <button id="multiCosignClearBtn" class="light" type="button">{{index .Messages "multiCosignClear"}}</button>
            </div>
          </div>

          <div id="signPlanSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="guidedAssistantSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="multiCosignSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="multiCosignOutputNotice" class="cert-summary" style="margin-top:14px"></div>
          <div id="certificateRoleSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="operationStrategySummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="formatConfigSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="verificationPlanSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="outputDeliverySummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="outputArtifactSummary" class="cert-summary" style="margin-top:14px"></div>
          <div id="proxySecretStoreSummary" class="cert-summary" style="margin-top:14px"></div>

          <div class="actions" style="margin-top:16px">
            <button id="signBtn" type="button">{{index .Messages "signNow"}}</button>
          </div>
        </section>
      </div>

      <div class="stack">
        <section class="card">
          <h2>{{index .Messages "sealCardTitle"}}</h2>
          <p class="muted">{{index .Messages "sealHelp"}}</p>
          <div class="field" style="margin-top:12px">
            <label class="check"><input id="enableVisibleSeal" type="checkbox" checked> {{index .Messages "enableVisibleSeal"}}</label>
          </div>

          <div id="sealControls" class="seal-controls">
            <div class="field-row">
              <div class="field">
                <label for="sealPosition">{{index .Messages "position"}}</label>
                <select id="sealPosition">
                  <option value="bottom-right">{{index .Messages "bottomRight"}}</option>
                  <option value="bottom-left">{{index .Messages "bottomLeft"}}</option>
                  <option value="top-right">{{index .Messages "topRight"}}</option>
                  <option value="top-left">{{index .Messages "topLeft"}}</option>
                  <option value="custom">{{index .Messages "custom"}}</option>
                </select>
              </div>
              <div class="field">
                <label for="sealPage">{{index .Messages "pageRange"}}</label>
                <input id="sealPage" type="text" value="1" placeholder="{{index .Messages "pageRangePlaceholder"}}">
                <label class="check" style="margin-top:8px"><input id="sealAllPages" type="checkbox"> {{index .Messages "allPages"}}</label>
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="sealX">{{index .Messages "xAxis"}}</label>
                <input id="sealX" type="number" min="0" max="1" step="0.0001" value="0.6200">
              </div>
              <div class="field">
                <label for="sealY">{{index .Messages "yAxis"}}</label>
                <input id="sealY" type="number" min="0" max="1" step="0.0001" value="0.0400">
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="sealW">{{index .Messages "width"}}</label>
                <input id="sealW" type="number" min="0.05" max="1" step="0.0001" value="0.3400">
              </div>
              <div class="field">
                <label for="sealH">{{index .Messages "height"}}</label>
                <input id="sealH" type="number" min="0.04" max="1" step="0.0001" value="0.1200">
              </div>
            </div>

            <div class="field">
              <label>{{index .Messages "signatureImage"}}</label>
              <input id="sealImageInput" type="file" accept="image/png,image/jpeg" hidden>
              <div class="actions">
                <button id="selectSealImageBtn" type="button">{{index .Messages "selectImage"}}</button>
                <button id="removeSealImageBtn" class="light" type="button">{{index .Messages "removeImage"}}</button>
              </div>
              <img id="sealImagePreview" hidden alt="" style="max-width:100%;max-height:96px;border-radius:10px;border:1px solid var(--line);background:#fff;padding:6px">
              <label class="check"><input id="keepSealText" type="checkbox" checked> {{index .Messages "keepText"}}</label>
              <div class="hint">{{index .Messages "imageNotPersisted"}}</div>
            </div>

            <div class="field">
              <label for="signatureQRContent">{{index .Messages "signatureQR"}}</label>
              <input id="signatureQRContent" type="text" placeholder="{{index .Messages "signatureQRPlaceholder"}}">
              <div class="hint">{{index .Messages "signatureQRHelp"}}</div>
            </div>

            <div class="field">
              <label style="font-weight:700;color:var(--text)">{{index .Messages "metadataTitle"}}</label>
              <div class="hint" style="margin:0 0 6px">{{index .Messages "metadataHelp"}}</div>
              <div class="field-row">
                <div class="field">
                  <label for="signatureReason">{{index .Messages "signatureReason"}}</label>
                  <input id="signatureReason" type="text" placeholder="{{index .Messages "signatureReasonPlaceholder"}}">
                </div>
                <div class="field">
                  <label for="signatureLocation">{{index .Messages "signatureLocation"}}</label>
                  <input id="signatureLocation" type="text" placeholder="{{index .Messages "signatureLocationPlaceholder"}}">
                </div>
              </div>
            <div class="field">
              <label for="signatureContact">{{index .Messages "signatureContact"}}</label>
              <input id="signatureContact" type="text" placeholder="{{index .Messages "signatureContactPlaceholder"}}">
            </div>
            <div class="field" style="margin-top:12px">
              <label style="font-weight:700;color:var(--text)">{{index .Messages "facturaeAdvancedTitle"}}</label>
              <div class="hint" style="margin:0 0 6px">{{index .Messages "facturaeAdvancedHelp"}}</div>
              <div class="field-row">
                <div class="field">
                  <label for="facturaePolicyVersion">{{index .Messages "facturaePolicyVersion"}}</label>
                  <select id="facturaePolicyVersion">
                    <option value="">-</option>
                    <option value="3.1">3.1</option>
                    <option value="3.0">3.0</option>
                  </select>
                </div>
                <div class="field">
                  <label for="facturaeSignerRole">{{index .Messages "facturaeSignerRole"}}</label>
                  <input id="facturaeSignerRole" type="text" placeholder="{{index .Messages "facturaeSignerRolePlaceholder"}}">
                </div>
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="facturaePolicyIdentifier">{{index .Messages "facturaePolicyIdentifier"}}</label>
                  <input id="facturaePolicyIdentifier" type="text" placeholder="{{index .Messages "facturaePolicyIdentifierPlaceholder"}}">
                </div>
                <div class="field">
                  <label for="facturaePolicyIdentifierHash">{{index .Messages "facturaePolicyIdentifierHash"}}</label>
                  <input id="facturaePolicyIdentifierHash" type="text" placeholder="{{index .Messages "facturaePolicyIdentifierHashPlaceholder"}}">
                </div>
              </div>
              <div class="field-row">
                <div class="field">
