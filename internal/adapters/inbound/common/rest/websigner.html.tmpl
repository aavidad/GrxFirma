        clearSupportDownloadUrls();
        state.lastSupportIncidentJSON = "";
        ui.supportExportSummary.innerHTML = '<span class="muted">' + escapeHtml(t("supportExportPending")) + '</span>';
      }

      async function apiFetch(path, options) {
        const response = await fetch(path, options || {});
        let data = null;
        try {
          data = await response.json();
        } catch (err) {
          data = null;
        }
        if (!response.ok) {
          const msg = data && data.error ? data.error : ("HTTP " + response.status);
          const error = new Error(msg);
          error.diagnostic = data && data.diagnostic && typeof data.diagnostic === "object"
            ? data.diagnostic
            : null;
          state.lastGuidedDiagnostic = error.diagnostic;
          throw error;
        }
        return data;
      }

