      function applyWebLanguage(lang) {
        const target = String(lang || "").trim() || "es";
        try {
          localStorage.setItem(WEB_LANGUAGE_KEY, target);
        } catch (_) {}
        const url = new URL(window.location.href);
        if (url.searchParams.get("lang") === target) {
          return;
        }
        url.searchParams.set("lang", target);
        window.location.href = url.toString();
      }

      if (ui.languageSelect) {
        ui.languageSelect.value = CURRENT_LANG;
        ui.languageSelect.addEventListener("change", function() {
          applyWebLanguage(ui.languageSelect.value);
        });
        try {
          const storedLang = localStorage.getItem(WEB_LANGUAGE_KEY);
          const requestedLang = new URL(window.location.href).searchParams.get("lang");
          if (storedLang && !requestedLang && storedLang !== CURRENT_LANG) {
            applyWebLanguage(storedLang);
            return;
          }
        } catch (_) {}
      }

      function t(key) {
        return MSG[key] || key;
      }

      function clamp01(v) {
        const num = Number(v);
        if (!Number.isFinite(num)) return 0;
        if (num < 0) return 0;
        if (num > 1) return 1;
        return num;
      }

      function clampMinMax(v, min, max) {
        const num = Number(v);
        if (!Number.isFinite(num)) return min;
        return Math.max(min, Math.min(max, num));
      }

      function normalizePageSelection(raw) {
        const value = String(raw == null ? "" : raw).trim().replace(/\s+/g, "");
        return value === "" ? "1" : value;
      }

      function parsePageSelection(raw) {
        const value = normalizePageSelection(raw);
        if (value === "1") {
          return { ok: true, normalized: "1", previewPage: 1 };
        }
        if (/^(all|todas|todos|\*)$/i.test(value)) {
          return { ok: true, normalized: "all", previewPage: 1 };
        }
        const parts = value.split(",");
        let previewPage = 1;
        let previewAssigned = false;
        for (const part of parts) {
          if (!/^\d+(?:-\d+)?$/.test(part)) {
            return { ok: false, normalized: value, previewPage: 1 };
          }
          if (part.includes("-")) {
            const [startRaw, endRaw] = part.split("-", 2);
            const start = Number(startRaw);
            const end = Number(endRaw);
            if (!Number.isInteger(start) || !Number.isInteger(end) || start < 1 || end < 1 || start > end) {
              return { ok: false, normalized: value, previewPage: 1 };
            }
            if (!previewAssigned) {
              previewPage = start;
              previewAssigned = true;
            }
            continue;
          }
          const page = Number(part);
          if (!Number.isInteger(page) || page < 1) {
            return { ok: false, normalized: value, previewPage: 1 };
          }
          if (!previewAssigned) {
            previewPage = page;
            previewAssigned = true;
          }
        }
        return { ok: true, normalized: value, previewPage };
      }

      function previewPageFromSelection(raw) {
        const parsed = parsePageSelection(raw);
        return parsed.ok ? parsed.previewPage : 1;
      }

      function applyPageSelectionValidity() {
        if (ui.sealAllPages.checked) {
          ui.sealPage.setCustomValidity("");
          return true;
        }
        const parsed = parsePageSelection(ui.sealPage.value);
        if (!parsed.ok) {
          ui.sealPage.setCustomValidity(t("invalidPageSelection"));
          return false;
        }
        ui.sealPage.value = parsed.normalized;
        ui.sealPage.setCustomValidity("");
        return true;
      }

      function escapeHtml(value) {
        return String(value == null ? "" : value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function setStatus(kind, message) {
        ui.globalStatus.className = "status " + kind;
        ui.globalStatus.textContent = message;
        renderSupportSummary();
      }

      function setResult(message, kind) {
        const klass = kind || "warn";
        ui.resultBox.innerHTML = '<div class="status ' + klass + '">' + escapeHtml(message) + '</div>';
        renderSupportSummary();
      }

      function clearDownloadUrl() {
