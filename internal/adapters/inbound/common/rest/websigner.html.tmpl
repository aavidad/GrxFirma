      function buildSupportIncidentText() {
        const selectedFiles = state.selectedFiles.length;
        const localPath = ui.localPathInput.value.trim();
        const verifyPath = ui.quickVerifyPathInput.value.trim();
        const cert = state.certificates.find((item) => item.id === state.selectedCertificateId);
        const owner = supportProbableOwner();
        const lines = [];
        lines.push(t("supportSummaryTitle") + ": " + (ui.globalStatus.textContent || t("notAvailable")));
        lines.push(t("action") + ": " + supportCurrentActionLabel());
        lines.push(t("format") + ": " + currentFormat());
        if (selectedFiles > 0) {
          lines.push(t("supportFilesLoaded") + ": " + String(selectedFiles));
        } else if (localPath) {
          lines.push(t("localPath") + ": " + localPath);
        }
        if (verifyPath) {
          lines.push(t("quickVerifyPath") + ": " + verifyPath);
        }
        lines.push(t("certificate") + ": " + (cert ? (cert.subjectName || cert.id || t("certificateUnknown")) : t("notAvailable")));
        lines.push(owner.label + ": " + (owner.reason || t("notAvailable")));
        lines.push(t("supportSuggestedStep") + ": " + ui.guidedAssistantSummary.textContent.trim());
        if (ui.supportExpertMode.checked && state.lastRequestId) {
          lines.push("RequestId: " + state.lastRequestId);
        }
        if (ui.resultBox.textContent.trim()) {
          lines.push(t("supportVisibleResult") + ": " + ui.resultBox.textContent.trim());
        }
        return lines.join("\n");
      }

