      function describeRuntimeProxyMode(mode) {
        const normalized = String(mode || "").trim().toLowerCase();
        switch (normalized) {
          case "":
            return t("notAvailable");
          case "none":
          case "direct":
          case "disabled":
            return t("proxyRuntimeModeNone");
          case "system":
          case "auto":
          case "pac":
            return t("proxyRuntimeModeSystem");
          case "configured":
          case "manual":
          case "explicit":
            return t("proxyRuntimeModeConfigured");
          case "authenticated":
          case "auth":
          case "secure":
          case "secret-store":
          case "secret_store":
            return t("proxyRuntimeModeAuthenticated");
          default:
            return normalized.replaceAll("_", " ").replaceAll("-", " ");
        }
      }

