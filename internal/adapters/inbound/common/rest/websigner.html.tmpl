      function expectedSignedArtifactSuffix() {
        const normalized = String(currentFormat() || "").toUpperCase();
        if (normalized === "PADES") return ".pdf";
        if (normalized === "CADES") return ".csig";
        if (normalized === "XADES") return ".xsig";
        if (normalized === "XMLDSIG") return ".dsig";
        if (normalized === "ODF") return ".odt";
        if (normalized === "OOXML") return ".docx";
        if (normalized === "FACTURAE") return ".xml";
        if (normalized === "ASIC-XADES") return ".asics";
        const localPath = ui.localPathInput.value.trim().toLowerCase();
        if (localPath.endsWith(".pdf")) return ".pdf";
        if (localPath.endsWith(".odt")) return ".odt";
        if (localPath.endsWith(".docx")) return ".docx";
        if (localPath.endsWith(".xml")) return ".xml";
        return "";
      }

