        const headline = available ? t("proxySecretStoreReady") : t("proxySecretStoreNotReady");
        let runtimeProxyModeSummary = "";
        if (runtimeProxyMode) {
          runtimeProxyModeSummary =
            escapeHtml(t("proxySecretStoreRuntimeModeLabel")) + ": " + escapeHtml(describeRuntimeProxyMode(runtimeProxyMode)) + " · ";
