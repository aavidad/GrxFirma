      async function checkHealth() {
        setStatus("warn", t("connectionChecking"));
        try {
          const health = await apiFetch("/health");
          if (!health || !health.ok) throw new Error(t("connectionError"));
          setStatus("ok", t("connectionReady"));
        } catch (err) {
          setStatus("bad", t("connectionError") + " " + err.message);
        }
      }

      function certificateIsExpired(cert) {
        const status = String(cert && cert.status || "").toLowerCase();
        return status.includes("caduc") || status.includes("expir");
      }

      function isCertificateVisible(cert) {
        if (!cert) return false;
        const subjectFilter = ui.certificateSubjectFilter.value.trim().toLowerCase();
        const issuerFilter = ui.certificateIssuerFilter.value.trim().toLowerCase();
        const subject = String(cert.subjectName || cert.id || "").toLowerCase();
        const issuer = String(cert.issuerName || "").toLowerCase();
        if (subjectFilter && !subject.includes(subjectFilter)) {
          return false;
        }
        if (issuerFilter && !issuer.includes(issuerFilter)) {
          return false;
        }
        if (ui.onlyUsableCertificates.checked && !cert.canSign) {
          return false;
        }
        if (ui.onlyValidCertificates.checked && certificateIsExpired(cert)) {
          return false;
        }
        return true;
      }

      function renderCertificateFilterMeta(visibleCount, totalCount) {
        ui.certificateFilterMeta.textContent = t("certificateFilterMeta")
          .replace("%visible%", String(visibleCount))
          .replace("%total%", String(totalCount));
      }

      function renderCertificateFilterSummary(visibleCerts) {
        if (!state.certificates.length) {
          ui.certificateFilterSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateFilterEmptyCatalog")) + '</span>';
          return;
        }
        if (!visibleCerts.length) {
          ui.certificateFilterSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateFilterNoMatches")) + '</span>';
          return;
        }
        if (state.selectedCertificateId && !visibleCerts.some((cert) => cert.id === state.selectedCertificateId)) {
          ui.certificateFilterSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateFilterSelectionHidden")) + '</span>';
          return;
        }
        ui.certificateFilterSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateFilterSelectionVisible")) + '</span>';
      }

      function clearCertificateFilters() {
        ui.certificateSubjectFilter.value = "";
        ui.certificateIssuerFilter.value = "";
        ui.onlyUsableCertificates.checked = false;
        ui.onlyValidCertificates.checked = false;
        renderCertificateInventory();
        persistPreferences();
      }

      function renderCertificatePreferenceSummary(activeCert, restored) {
        if (!ui.rememberSelectedCertificate.checked) {
          ui.certificatePreferenceSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificatePreferenceDisabled")) + '</span>';
          return;
        }
        if (!state.selectedCertificateId) {
          ui.certificatePreferenceSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificatePreferenceNoSelection")) + '</span>';
          return;
        }
        if (!activeCert) {
          ui.certificatePreferenceSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificatePreferenceMissing")) + '</span>';
          return;
        }
        const prefix = restored ? t("certificatePreferenceRestored") : t("certificatePreferenceStored");
        ui.certificatePreferenceSummary.innerHTML =
          '<strong>' + escapeHtml(t("certificatePreferenceTitle")) + ':</strong> ' +
          escapeHtml(prefix) + '<br><span class="muted">' +
          escapeHtml(activeCert.subjectName || activeCert.id || t("certificateUnknown")) +
          '</span>';
      }

      function renderCertificateAutoSelectSummary(kind, message) {
        const css = kind ? ('status ' + kind) : 'muted';
        ui.certificateAutoSelectSummary.innerHTML = '<span class="' + css + '">' + escapeHtml(message) + '</span>';
      }

      function renderCertificateExportSummary(cert) {
        if (!cert) {
          state.lastCertificateJSON = "";
          state.lastCertificateFingerprint = "";
          ui.certificateExportSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateExportPending")) + '</span>';
          return;
        }
        const payload = {
          id: cert.id || "",
          subjectName: cert.subjectName || "",
          issuerName: cert.issuerName || "",
          validTo: cert.validTo || "",
          fingerprint: cert.fingerprint || "",
          serialNumber: cert.serialNumber || "",
          status: cert.status || "",
          canSign: !!cert.canSign
        };
        state.lastCertificateJSON = JSON.stringify(payload, null, 2);
        state.lastCertificateFingerprint = String(cert.fingerprint || "");
        const href = "data:application/json;charset=utf-8," + encodeURIComponent(state.lastCertificateJSON);
        const filename = sourceFileBasename(cert.subjectName || cert.id || t("certificateExportFilenameFallback")).replace(/[\\/:*?\"<>|]+/g, "_") + t("certificateExportFilenameSuffix");
        const copyButton = navigator.clipboard && typeof navigator.clipboard.writeText === "function"
          ? ' <button type="button" class="link-btn light" data-copy-certificate-json="1">' + escapeHtml(t("certificateCopyReady")) + '</button>'
          : "";
        const copyFingerprintButton = navigator.clipboard && typeof navigator.clipboard.writeText === "function" && state.lastCertificateFingerprint
          ? ' <button type="button" class="link-btn light" data-copy-certificate-fingerprint="1">' + escapeHtml(t("certificateFingerprintCopyReady")) + '</button>'
          : "";
        ui.certificateExportSummary.innerHTML =
          '<a class="link-btn secondary" href="' + href + '" download="' + escapeHtml(filename) + '">' +
          escapeHtml(t("certificateExportReady")) +
          '</a>' + copyButton + copyFingerprintButton;
      }

      function describeCertificate(cert) {
        if (!cert) {
          ui.certificateStatus.innerHTML = '<span class="muted">' + escapeHtml(t("certificateStatusNone")) + '</span>';
          ui.certificateExpiryStatus.innerHTML = '<span class="muted">' + escapeHtml(t("certificateExpiryEmpty")) + '</span>';
          ui.certificateDetailsSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateDetailsEmpty")) + '</span>';
          renderCertificateExportSummary(null);
          ui.certificateSummary.innerHTML = '<span class="muted">' + escapeHtml(t("noCertificates")) + '</span>';
          ui.previewSealSubtitle.textContent = t("signaturePreviewSubtitle");
          renderSignPlanSummary();
          renderCertificateRoleSummary();
          renderOperationStrategySummary();
          renderVerificationPlanSummary();
          renderOutputDeliverySummary();
          return;
        }
        const status = String(cert.status || "").toLowerCase();
        const expired = status.includes("caduc") || status.includes("expir");
        const canSign = !!cert.canSign;
        if (!canSign) {
          ui.certificateStatus.innerHTML = '<strong>' + escapeHtml(t("certificateStatusTitle")) + ':</strong> ' + escapeHtml(t("certificateStatusNotUsable"));
        } else if (expired) {
          ui.certificateStatus.innerHTML = '<strong>' + escapeHtml(t("certificateStatusTitle")) + ':</strong> ' + escapeHtml(t("certificateStatusExpired"));
        } else {
          ui.certificateStatus.innerHTML = '<strong>' + escapeHtml(t("certificateStatusTitle")) + ':</strong> ' + escapeHtml(t("certificateStatusReady"));
        }
        const validToRaw = String(cert.validTo || "");
        const validToTs = Date.parse(validToRaw);
        if (!Number.isNaN(validToTs)) {
          const daysLeft = Math.ceil((validToTs - Date.now()) / (24 * 60 * 60 * 1000));
          if (daysLeft >= 0 && daysLeft <= 30) {
            ui.certificateExpiryStatus.innerHTML = '<strong>' + escapeHtml(t("certificateExpiryTitle")) + ':</strong> ' + escapeHtml(t("certificateExpirySoon") + String(daysLeft));
          } else {
            ui.certificateExpiryStatus.innerHTML = '<strong>' + escapeHtml(t("certificateExpiryTitle")) + ':</strong> ' + escapeHtml(t("certificateExpiryOk"));
          }
        } else {
          ui.certificateExpiryStatus.innerHTML = '<strong>' + escapeHtml(t("certificateExpiryTitle")) + ':</strong> ' + escapeHtml(t("notAvailable"));
        }
        ui.certificateDetailsSummary.innerHTML =
          '<strong>' + escapeHtml(t("certificateValidity")) + ':</strong> ' + escapeHtml(cert.validTo || t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("certificateSerial")) + ':</strong> ' + escapeHtml(cert.serialNumber || t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("certificateFingerprint")) + ':</strong> <code>' + escapeHtml(cert.fingerprint || t("notAvailable")) + '</code>';
        renderCertificateExportSummary(cert);
        ui.certificateSummary.innerHTML =
          '<strong>' + escapeHtml(cert.subjectName || cert.id || t("certificateUnknown")) + '</strong><br>' +
          '<span class="muted">' + escapeHtml(cert.issuerName || "") + '</span><br>' +
          '<span class="muted">' + escapeHtml(cert.status || "") + '</span>';
        ui.previewSealSubtitle.textContent = cert.subjectName || t("certificateUnknown");
        renderSignPlanSummary();
        renderCertificateRoleSummary();
        renderOperationStrategySummary();
        renderVerificationPlanSummary();
      }

      function renderCertificateInventoryStatus() {
        const total = state.certificates.length;
        const usable = state.certificates.filter((cert) => !!cert.canSign).length;
        if (total === 0) {
          ui.certificateInventoryStatus.innerHTML = '<span class="muted">' + escapeHtml(t("certificateInventoryEmpty")) + '</span>';
          return;
        }
        ui.certificateInventoryStatus.innerHTML =
          '<strong>' + escapeHtml(t("certificateInventoryTitle")) + ':</strong> ' +
          escapeHtml(String(total) + " " + t("certificateInventoryLoaded")) + '<br>' +
          '<span class="muted">' + escapeHtml(t("certificateInventoryUsable") + String(usable)) + '</span>';
      }

      async function loadCertificates() {
        ui.refreshCertificatesBtn.disabled = true;
        ui.certificateSelect.innerHTML = '<option value="">' + escapeHtml(t("loadingCertificates")) + '</option>';
        try {
          const payload = await apiFetch("/certificates?check=1");
          state.certificates = Array.isArray(payload.certificates) ? payload.certificates : [];
          renderCertificateAutoSelectSummary("", t("certificateAutoSelectIdle"));
          renderCertificateInventory(true);
        } catch (err) {
          ui.certificateSelect.innerHTML = '<option value="">' + escapeHtml(err.message) + '</option>';
          ui.certificateInventoryStatus.innerHTML = '<span class="muted">' + escapeHtml(err.message) + '</span>';
          ui.certificateFilterMeta.textContent = "";
          ui.certificateFilterSummary.innerHTML = '<span class="muted">' + escapeHtml(err.message) + '</span>';
          ui.certificatePreferenceSummary.innerHTML = '<span class="muted">' + escapeHtml(err.message) + '</span>';
          ui.certificateAutoSelectSummary.innerHTML = '<span class="muted">' + escapeHtml(err.message) + '</span>';
          describeCertificate(null);
        } finally {
          ui.refreshCertificatesBtn.disabled = false;
        }
      }

      function renderCertificateInventory(isInitialLoad) {
        const selected = state.selectedCertificateId;
        const visibleCerts = state.certificates.filter(isCertificateVisible);
        ui.certificateSelect.innerHTML = "";
        if (state.certificates.length === 0) {
          const option = document.createElement("option");
          option.value = "";
          option.textContent = t("noCertificates");
          ui.certificateSelect.appendChild(option);
          state.selectedCertificateId = "";
          renderCertificateInventoryStatus();
          renderCertificateFilterMeta(0, 0);
          renderCertificateFilterSummary([]);
          renderCertificatePreferenceSummary(null, false);
          renderMultiCosignCandidates();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          describeCertificate(null);
          return;
        }
        if (!visibleCerts.length) {
          const option = document.createElement("option");
          option.value = "";
          option.textContent = t("certificateFilterNoMatchesShort");
          ui.certificateSelect.appendChild(option);
        } else {
          for (const cert of visibleCerts) {
            const option = document.createElement("option");
            option.value = cert.id || "";
            option.textContent = cert.subjectName || cert.id || t("certificateUnknown");
            if (selected && option.value === selected) {
              option.selected = true;
            }
            ui.certificateSelect.appendChild(option);
          }
        }
        if (!ui.certificateSelect.value && !visibleCerts.some((cert) => cert.id === selected)) {
          const preferred = visibleCerts.find((cert) => cert.canSign && !certificateIsExpired(cert)) || visibleCerts.find((cert) => cert.canSign) || visibleCerts[0];
          if (!selected && preferred) {
            ui.certificateSelect.value = preferred.id || "";
            state.selectedCertificateId = ui.certificateSelect.value;
          }
        } else if (ui.certificateSelect.value) {
          state.selectedCertificateId = ui.certificateSelect.value;
        }
        renderCertificateInventoryStatus();
        renderCertificateFilterMeta(visibleCerts.length, state.certificates.length);
        renderCertificateFilterSummary(visibleCerts);
        renderMultiCosignCandidates();
        updateMultiCosignVisibility();
        const activeCert = state.certificates.find((item) => item.id === state.selectedCertificateId) || visibleCerts[0] || null;
        renderCertificatePreferenceSummary(activeCert, !!(isInitialLoad && selected && activeCert && activeCert.id === selected));
        describeCertificate(activeCert);
      }

      async function autoSelectCertificate() {
        ui.autoSelectCertificateBtn.disabled = true;
        renderCertificateAutoSelectSummary("warn", t("certificateAutoSelectRunning"));
        try {
          const payload = await apiFetch("/select-certificate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              subject_filter: ui.certificateSubjectFilter.value.trim(),
              issuer_filter: ui.certificateIssuerFilter.value.trim(),
              solo_no_caducados: ui.onlyValidCertificates.checked
            })
          });
          state.selectedCertificateId = String(payload.certificate_id || "");
          renderCertificateInventory(false);
          persistPreferences();
          renderCertificateAutoSelectSummary("ok", t("certificateAutoSelectDone") + " " + String(payload.subject || payload.certificate_id || ""));
        } catch (err) {
          renderCertificateAutoSelectSummary("bad", t("certificateAutoSelectError") + " " + String(err.message || err));
        } finally {
          ui.autoSelectCertificateBtn.disabled = false;
        }
      }

      function updateFileMeta() {
        const localPath = ui.localPathInput.value.trim();
        if (state.selectedFiles.length === 0) {
          if (!localPath) {
            ui.fileMeta.innerHTML = '<span class="muted">' + escapeHtml(t("needFile")) + '</span>';
            renderSignPlanSummary();
            renderVerificationPlanSummary();
            renderOutputDeliverySummary();
            renderOperationStrategySummary();
            renderSelectionTypeSummary();
            renderMetadataDeliverySummary();
            return;
          }
          ui.fileMeta.innerHTML =
            '<strong>' + escapeHtml(t("selectedFile")) + ':</strong> <code>' + escapeHtml(localPath) + '</code>';
          renderSignPlanSummary();
          renderVerificationPlanSummary();
          renderOutputDeliverySummary();
          renderOutputArtifactSummary();
          renderOperationStrategySummary();
          renderSelectionTypeSummary();
          renderMetadataDeliverySummary();
          return;
        }
        const items = state.selectedFiles.map((file) => {
          const size = file.size > 0 ? (file.size / 1024).toFixed(1) + " KB" : "0 KB";
          return '<li><strong>' + escapeHtml(sourceFileName(file)) + '</strong> <span class="muted">(' + escapeHtml(size + " · " + (file.type || "application/octet-stream")) + ')</span></li>';
        }).join("");
        const countLabel = String(t("selectedFilesCount") || "%d fichero(s)").replace("%d", String(state.selectedFiles.length));
        ui.fileMeta.innerHTML =
          '<strong>' + escapeHtml(t("selectedFile")) + ':</strong> ' + escapeHtml(countLabel) +
          '<ul style="margin:8px 0 0 18px;padding:0">' + items + '</ul>';
        renderSignPlanSummary();
        renderVerificationPlanSummary();
        renderOutputDeliverySummary();
        renderOutputArtifactSummary();
        renderOperationStrategySummary();
        renderSelectionTypeSummary();
        renderMetadataDeliverySummary();
      }

      function currentActionLabel() {
        switch (currentAction()) {
          case "cosign":
            return t("actionCosign");
          case "countersign":
            return t("actionCountersign");
          default:
            return t("actionSign");
        }
      }

      function supportsGuidedMultiCosign() {
        const singleSource = state.selectedFiles.length <= 1 && !(state.selectedFiles.length === 0 && !ui.localPathInput.value.trim());
        const supportedFormat = ["PAdES", "ODF", "OOXML"].includes(currentFormat());
        return singleSource && supportedFormat && (currentAction() === "sign" || currentAction() === "cosign");
      }

      function activeGuidedMultiCosign() {
        return ui.enableMultiCosign.checked && supportsGuidedMultiCosign();
      }

      function updateMultiCosignOutputPolicy() {
        const active = activeGuidedMultiCosign();
        if (active) {
          if (!state.multiCosignOutputPrefs) {
            state.multiCosignOutputPrefs = {
              saveToDisk: ui.saveToDisk.checked,
              returnB64: ui.returnB64.checked,
              overwriteOutput: ui.overwriteOutput.checked
            };
          }
          ui.saveToDisk.checked = false;
          ui.returnB64.checked = true;
          ui.overwriteOutput.checked = false;
          ui.saveToDisk.disabled = true;
          ui.returnB64.disabled = true;
          ui.overwriteOutput.disabled = true;
          ui.localOutputPathInput.disabled = true;
          ui.multiCosignOutputNotice.innerHTML =
            '<strong>' + escapeHtml(t("multiCosignOutputPolicyTitle")) + ':</strong> ' + escapeHtml(t("multiCosignOutputPolicyActive")) + '<br>' +
            '<span class="muted">' + escapeHtml(t("multiCosignOutputPolicyRestore")) + '</span>';
          return;
        }
        if (state.multiCosignOutputPrefs) {
          ui.saveToDisk.checked = !!state.multiCosignOutputPrefs.saveToDisk;
          ui.returnB64.checked = !!state.multiCosignOutputPrefs.returnB64;
          ui.overwriteOutput.checked = !!state.multiCosignOutputPrefs.overwriteOutput;
          state.multiCosignOutputPrefs = null;
        }
        ui.saveToDisk.disabled = false;
        ui.returnB64.disabled = false;
        ui.overwriteOutput.disabled = false;
        ui.localOutputPathInput.disabled = false;
        ui.multiCosignOutputNotice.innerHTML = '<span class="muted">' + escapeHtml(t("multiCosignOutputPolicyInactive")) + '</span>';
      }

      function multiCosignAdditionalIds() {
        return Array.from(ui.multiCosignSelect.selectedOptions || []).map((option) => option.value).filter(Boolean);
      }

      function selectAllMultiCosignCandidates() {
        Array.from(ui.multiCosignSelect.options || []).forEach((option) => {
          option.selected = true;
        });
        renderMultiCosignSummary();
        persistPreferences();
      }

      function clearMultiCosignCandidates() {
        Array.from(ui.multiCosignSelect.options || []).forEach((option) => {
          option.selected = false;
        });
        renderMultiCosignSummary();
        persistPreferences();
      }

      function renderMultiCosignCandidates() {
        const previous = new Set(multiCosignAdditionalIds().concat(state.restoredMultiCosignIds || []));
        const primaryId = state.selectedCertificateId;
        const candidates = state.certificates.filter((cert) => {
          const id = cert.id || "";
          return id && id !== primaryId && cert.canSign && !certificateIsExpired(cert);
        });
        ui.multiCosignSelect.innerHTML = candidates.map((cert) => {
          const id = cert.id || "";
          const selected = previous.has(id) ? ' selected' : '';
          return '<option value="' + escapeHtml(id) + '"' + selected + '>' +
            escapeHtml((cert.subjectName || id) + (cert.issuerName ? " · " + cert.issuerName : "")) +
          '</option>';
        }).join("");
        state.restoredMultiCosignIds = [];
      }

      function updateMultiCosignVisibility() {
        const enabled = ui.enableMultiCosign.checked;
        const supported = supportsGuidedMultiCosign();
        ui.multiCosignControls.hidden = !(enabled && supported);
        updateMultiCosignOutputPolicy();
      }

      function renderMultiCosignSummary() {
        const enabled = ui.enableMultiCosign.checked;
        const additionalIds = multiCosignAdditionalIds();
        const primary = state.certificates.find((item) => item.id === state.selectedCertificateId) || null;
        if (!enabled) {
          ui.multiCosignSummary.innerHTML = '<span class="muted">' + escapeHtml(t("multiCosignDisabled")) + '</span>';
          return;
        }
        if (!supportsGuidedMultiCosign()) {
          ui.multiCosignSummary.innerHTML = '<span class="muted">' + escapeHtml(t("multiCosignUnsupported")) + '</span>';
          return;
        }
        if (!primary) {
          ui.multiCosignSummary.innerHTML = '<span class="muted">' + escapeHtml(t("multiCosignNeedPrimary")) + '</span>';
          return;
        }
        if (!additionalIds.length) {
          ui.multiCosignSummary.innerHTML = '<span class="muted">' + escapeHtml(t("multiCosignNoAdditional")) + '</span>';
          return;
        }
        const labels = additionalIds.map((id) => {
          const cert = state.certificates.find((item) => item.id === id);
          return cert ? (cert.subjectName || cert.id || id) : id;
        });
        ui.multiCosignSummary.innerHTML =
          '<strong>' + escapeHtml(t("multiCosignTitle")) + '</strong><br>' +
          '<strong>' + escapeHtml(t("multiCosignPrimary")) + ':</strong> ' + escapeHtml(primary.subjectName || primary.id || t("certificateUnknown")) + '<br>' +
          '<strong>' + escapeHtml(t("multiCosignAdditional")) + ':</strong> ' + escapeHtml(labels.join(" · "));
      }

      function renderSignPlanSummary() {
        const cert = state.certificates.find((item) => item.id === state.selectedCertificateId);
        const localPath = ui.localPathInput.value.trim();
        let sourceText = t("pendingSelection");
        if (state.selectedFiles.length > 0) {
          sourceText = t("uploadedSelection");
        } else if (localPath) {
          sourceText = t("localPathMode");
        }
        let deliveryText = t("deliveryMemoryOnly");
        if (ui.saveToDisk.checked && ui.returnB64.checked) {
          deliveryText = t("deliveryDiskAndBase64");
        } else if (ui.saveToDisk.checked) {
          deliveryText = t("deliveryDiskOnly");
        } else if (ui.returnB64.checked) {
          deliveryText = t("deliveryMemoryAndBase64");
        }
        const sealActive = ui.enableVisibleSeal.checked && currentFormat() === "PAdES";
        const formatUpper = currentFormat();
        const profileApplies = formatUpper === "PAdES" || formatUpper === "CAdES" || formatUpper === "XAdES";
        const profileText = profileApplies ? ui.signProfile.value : t("notAvailable");
        let tsaText = t("notAvailable");
        if (profileApplies) {
          tsaText = ui.tsaUrl.value.trim() ? ui.tsaUrl.value.trim() : t("tsaUrlNotConfigured");
        }
        const padesSubFilterText = formatUpper === "PAdES" ? ui.padesSubFilter.value : t("notAvailable");
        const multiCosignText = ui.enableMultiCosign.checked
          ? (supportsGuidedMultiCosign() ? t("multiCosignEnabled") : t("multiCosignUnsupported"))
          : t("multiCosignDisabledShort");
        ui.signPlanSummary.innerHTML =
          '<strong>' + escapeHtml(t("signingPlan")) + '</strong><br>' +
          '<strong>' + escapeHtml(t("certificate")) + ':</strong> ' + escapeHtml(cert ? (cert.subjectName || cert.id || t("certificateUnknown")) : t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("action")) + ':</strong> ' + escapeHtml(currentActionLabel()) + '<br>' +
          '<strong>' + escapeHtml(t("format")) + ':</strong> ' + escapeHtml(currentFormat()) + '<br>' +
          '<strong>' + escapeHtml(t("signProfile")) + ':</strong> ' + escapeHtml(profileText) + '<br>' +
          '<strong>' + escapeHtml(t("tsaUrl")) + ':</strong> ' + escapeHtml(tsaText) + '<br>' +
          '<strong>' + escapeHtml(t("padesSubFilter")) + ':</strong> ' + escapeHtml(padesSubFilterText) + '<br>' +
          '<strong>' + escapeHtml(t("multiCosignLabel")) + ':</strong> ' + escapeHtml(multiCosignText) + '<br>' +
          '<strong>' + escapeHtml(t("source")) + ':</strong> ' + escapeHtml(sourceText) + '<br>' +
          '<strong>' + escapeHtml(t("outputMode")) + ':</strong> ' + escapeHtml(deliveryText) + '<br>' +
          '<strong>' + escapeHtml(t("sealStatus")) + ':</strong> ' + escapeHtml(sealActive ? t("sealEnabled") : t("sealDisabled"));
        renderGuidedAssistantSummary();
        renderMultiCosignSummary();
      }

      function renderGuidedAssistantSummary() {
        let message = t("guidedAssistantNeedSource");
        let detail = t("guidedAssistantNeedSourceHelp");
        if (state.selectedFiles.length === 0 && !ui.localPathInput.value.trim()) {
          message = t("guidedAssistantNeedSource");
          detail = t("guidedAssistantNeedSourceHelp");
        } else if (!state.selectedCertificateId) {
          message = t("guidedAssistantNeedCertificate");
          detail = t("guidedAssistantNeedCertificateHelp");
        } else if (ui.enableMultiCosign.checked && supportsGuidedMultiCosign() && multiCosignAdditionalIds().length === 0) {
          message = t("guidedAssistantNeedCoSigner");
          detail = t("guidedAssistantNeedCoSignerHelp");
        } else if (ui.enableVisibleSeal.checked && currentFormat() !== "PAdES") {
          message = t("guidedAssistantNeedPades");
          detail = t("guidedAssistantNeedPadesHelp");
        } else if (ui.enableVisibleSeal.checked && !ui.sealAllPages.checked && !parsePageSelection(ui.sealPage.value).ok) {
          message = t("guidedAssistantInvalidPages");
          detail = t("guidedAssistantInvalidPagesHelp");
        } else {
          message = t("guidedAssistantReady");
          detail = t("guidedAssistantReadyHelp");
        }
        ui.guidedAssistantSummary.innerHTML =
          '<strong>' + escapeHtml(t("guidedAssistantTitle")) + '</strong><br>' +
          escapeHtml(message) + '<br>' +
          '<span class="muted">' + escapeHtml(detail) + '</span>';
      }

      function renderCertificateRoleSummary() {
        const cert = state.certificates.find((item) => item.id === state.selectedCertificateId);
        if (!cert) {
          ui.certificateRoleSummary.innerHTML = '<span class="muted">' + escapeHtml(t("certificateRolePending")) + '</span>';
          renderMultiCosignSummary();
          return;
        }
        const status = String(cert.status || "").toLowerCase();
        const canOperate = !!cert.canSign && !status.includes("caduc") && !status.includes("expir");
        let roleText = t("certificateRoleNotUsable");
        if (canOperate) {
          switch (currentAction()) {
            case "cosign":
              roleText = t("certificateRoleCosign");
              break;
            case "countersign":
              roleText = t("certificateRoleCountersign");
              break;
            default:
              roleText = t("certificateRoleSign");
