      function buildSupportDownloadLinkFromJSON(content, filename, label) {
        if (!content) return "";
        const blob = new Blob([content], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        state.supportDownloadUrls.push(url);
        return '<a class="link-btn secondary" href="' + url + '" download="' + escapeHtml(filename) + '">' + escapeHtml(label) + '</a>';
      }

      function parseSupportJSON(value) {
        if (!value) return null;
        try {
          return JSON.parse(value);
        } catch (_) {
          return null;
        }
      }

      function supportIncidentFileName(value) {
        const raw = String(value || "").trim().replace(/\\/g, "/");
        if (!raw) return "";
        const parts = raw.split("/").filter(Boolean);
        return String(parts.length ? parts[parts.length - 1] : "[PATH]").slice(0, 255);
      }

      function supportIncidentSafeText(value) {
        return String(value || "")
          .replace(/\bBearer\s+[A-Za-z0-9._~+/=-]+/gi, "Bearer [REDACTED]")
          .replace(/\b(token|password|passwd|secret|authorization|dat)\s*[=:]\s*[^\s,;&]+/gi, "$1=[REDACTED]")
          .replace(/\bfile:(?:\/\/)?[^\s"'<>]+/gi, "[PATH]")
          .replace(/(?:\b[A-Z]:[\\/]|\\\\)[^\r\n"'<>|]+/gi, "[PATH]")
          .replace(/(^|[\s(])\/(?:[^\s"'<>]+\/?)+/g, "$1[PATH]")
          .slice(0, 4096);
      }

      function supportIncidentSafeRequestId(value) {
        const requestId = String(value || "").trim();
        return /^[A-Za-z0-9._:-]{1,128}$/.test(requestId) ? requestId : "";
      }

      function supportIncidentSafeDiagnostics(value) {
        const diagnostics = value && typeof value === "object" ? value : {};
        return {
          ok: !!diagnostics.ok,
          certificate_count: Number(diagnostics.certificateCount || 0),
          can_sign_count: Number(diagnostics.canSignCount || 0),
          endpoint_store_count: Number(diagnostics.endpointStoreCount || 0)
        };
      }

      function supportIncidentSafeProxyStatus(value) {
        const status = value && typeof value === "object" ? value : {};
        return {
          available: !!status.available,
          platform: supportIncidentSafeText(status.platform || ""),
          backend: supportIncidentSafeText(status.backend || ""),
          runtime_mode: supportIncidentSafeText(status.runtimeProxyMode || "")
        };
      }

      function supportIncidentSafeGuidedDiagnostic(value) {
        const diagnostic = value && typeof value === "object" ? value : {};
        const allowedCategories = new Set([
          "app_local",
          "certificate_store",
          "network_proxy",
          "local_web_service",
          "remote_service",
          "government_afirma",
          "unknown"
        ]);
        const category = String(diagnostic.category || "unknown").trim();
        const failureCode = String(diagnostic.failureCode || "").trim();
        return {
          category: allowedCategories.has(category) ? category : "unknown",
          failure_code: /^[A-Z0-9_-]{1,32}$/.test(failureCode) ? failureCode : "",
          likely_owner: supportIncidentSafeText(diagnostic.likelyOwner || ""),
          user_can_resolve_directly: diagnostic.userCanResolveDirectly === true,
          user_message: supportIncidentSafeText(diagnostic.userMessage || ""),
          responsibility_message: supportIncidentSafeText(diagnostic.responsibilityMessage || ""),
          suggested_action: supportIncidentSafeText(diagnostic.suggestedAction || "")
        };
      }

      function buildSupportIncidentPayload(diagnostics) {
        const cert = state.certificates.find((item) => item.id === state.selectedCertificateId) || null;
        const selectedFiles = state.selectedFiles.map((file) => sourceFileName(file) || file.name || "").filter(Boolean);
        const quickVerifyArtifact = state.quickVerifyFile
          ? (sourceFileName(state.quickVerifyFile) || state.quickVerifyFile.name || "")
          : supportIncidentFileName(ui.quickVerifyPathInput.value);
        const quickVerifyOriginal = state.quickVerifyOriginalFile
          ? (sourceFileName(state.quickVerifyOriginalFile) || state.quickVerifyOriginalFile.name || "")
          : supportIncidentFileName(ui.quickVerifyOriginalPathInput.value);
        const owner = supportProbableOwner();
        return {
          generated_at: new Date().toISOString(),
          page: "/signer",
          locale: CURRENT_LANG,
          request_id: supportIncidentSafeRequestId(state.lastRequestId),
          signer: {
            global_status: supportIncidentSafeText(ui.globalStatus.textContent),
            action: currentAction(),
            action_label: supportIncidentSafeText(supportCurrentActionLabel()),
            format: currentFormat(),
            local_file: supportIncidentFileName(ui.localPathInput.value),
            output_file: supportIncidentFileName(ui.localOutputPathInput.value),
            selected_files: selectedFiles.map(supportIncidentFileName).slice(0, 128),
            certificate: cert ? {
              selected: true,
              status: supportIncidentSafeText(cert.status || ""),
              can_sign: !!cert.canSign
            } : null,
            visible_seal_enabled: !!ui.enableVisibleSeal.checked,
            visible_seal_pages: ui.sealAllPages.checked ? "all" : ui.sealPage.value.trim(),
            multi_cosign_enabled: !!ui.enableMultiCosign.checked,
            multi_cosign_count: multiCosignAdditionalIds().length,
            quick_verify: {
              artifact: supportIncidentFileName(quickVerifyArtifact),
              original: supportIncidentFileName(quickVerifyOriginal),
              source_summary: supportIncidentSafeText(ui.quickVerifySourceSummary.textContent),
              original_summary: supportIncidentSafeText(ui.quickVerifyOriginalSummary.textContent),
              pair_summary: supportIncidentSafeText(ui.quickVerifyPairSummary.textContent),
              plan_summary: supportIncidentSafeText(ui.quickVerifyPlanSummary.textContent),
              result_summary: supportIncidentSafeText(ui.quickVerifyResultSummary.textContent)
            },
            proxy_secret_store: supportIncidentSafeProxyStatus(state.lastProxySecretStoreStatus),
            exported_artifacts: {
              verification_report_available: !!parseSupportJSON(state.lastVerificationJSON),
              certificate_report_available: !!parseSupportJSON(state.lastCertificateJSON)
            },
            support_mode: ui.supportExpertMode.checked ? "expert" : "user",
            guided_diagnostic: supportIncidentSafeGuidedDiagnostic(state.lastGuidedDiagnostic),
            probable_owner: owner,
            non_technical_summary: supportIncidentSafeText(supportNonTechnicalSummary()),
            visible_summaries: {
              selection_type: supportIncidentSafeText(ui.selectionTypeSummary.textContent),
              certificate_status: supportIncidentSafeText(ui.certificateStatus.textContent),
              certificate_details: supportIncidentSafeText(ui.certificateDetailsSummary.textContent),
              sign_plan: supportIncidentSafeText(ui.signPlanSummary.textContent),
              suggested_next_step: supportIncidentSafeText(ui.guidedAssistantSummary.textContent),
              multi_cosign: supportIncidentSafeText(ui.multiCosignSummary.textContent),
              operation_strategy: supportIncidentSafeText(ui.operationStrategySummary.textContent),
              verification_plan: supportIncidentSafeText(ui.verificationPlanSummary.textContent),
              output_delivery: supportIncidentSafeText(ui.outputDeliverySummary.textContent),
              output_artifact: supportIncidentSafeText(ui.outputArtifactSummary.textContent),
              proxy_secret_store: supportIncidentSafeText(ui.proxySecretStoreSummary.textContent),
              result_artifact: supportIncidentSafeText(ui.resultArtifactSummary.textContent)
            },
            suggested_next_step: supportIncidentSafeText(ui.guidedAssistantSummary.textContent),
            visible_result: supportIncidentSafeText(ui.resultBox.textContent)
          },
          diagnostics: supportIncidentSafeDiagnostics(diagnostics)
        };
      }

      function renderSupportExportSummary(payload) {
        clearSupportDownloadUrls();
        state.lastSupportIncidentJSON = JSON.stringify(payload, null, 2);
        const filename = "grxfirma_signer_incident.json";
        const owner = payload && payload.signer && payload.signer.probable_owner ? payload.signer.probable_owner : supportProbableOwner();
        const nextStep = payload && payload.signer ? String(payload.signer.suggested_next_step || "").trim() : "";
        const downloadHtml = buildSupportDownloadLinkFromJSON(
          state.lastSupportIncidentJSON,
          filename,
          t("Descargar informe"),
        );
        const copyButton = navigator.clipboard && typeof navigator.clipboard.writeText === "function"
          ? ' <button type="button" class="link-btn light" data-copy-support-incident="1">' + escapeHtml(t("Copiar diagnóstico")) + '</button>'
          : "";
        ui.supportExportSummary.innerHTML =
          '<strong>' + escapeHtml(t("supportPrepareIncident")) + '</strong><br>' +
          '<span class="muted">' + escapeHtml(t("supportExportReady")) + '</span><br>' +
          '<span class="muted">' + escapeHtml(owner.label || t("title")) + ': ' + escapeHtml((owner && owner.reason) || supportNonTechnicalSummary()) + '</span>' +
          (nextStep ? '<br><span class="muted">' + escapeHtml(t("supportSuggestedStep")) + ': ' + escapeHtml(nextStep) + '</span>' : '') +
          '<div class="actions" style="margin-top:10px">' + downloadHtml + copyButton + '</div>';
      }

      async function prepareSupportIncident() {
        ui.supportExportSummary.innerHTML = '<span class="muted">' + escapeHtml(t("supportPrepareRunning")) + '</span>';
        try {
          const diagnostics = await apiFetch("/diagnostics/report");
          renderSupportExportSummary(buildSupportIncidentPayload(diagnostics));
          setStatus("ok", t("supportPrepareDone"));
        } catch (err) {
          clearSupportExportSummary();
          ui.supportExportSummary.innerHTML = '<span class="muted">' + escapeHtml(err.message || t("notAvailable")) + '</span>';
          setStatus("bad", err.message || t("notAvailable"));
        }
      }

      function inferMimeType(file) {
        if (file && file.type) return file.type;
        const name = (file && file.name ? file.name : "").toLowerCase();
        if (name.endsWith(".pdf")) return "application/pdf";
        if (name.endsWith(".odt")) return "application/vnd.oasis.opendocument.text";
        if (name.endsWith(".ods")) return "application/vnd.oasis.opendocument.spreadsheet";
        if (name.endsWith(".odp")) return "application/vnd.oasis.opendocument.presentation";
        if (name.endsWith(".odg")) return "application/vnd.oasis.opendocument.graphics";
        if (name.endsWith(".docx")) return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        if (name.endsWith(".xlsx")) return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
        if (name.endsWith(".pptx")) return "application/vnd.openxmlformats-officedocument.presentationml.presentation";
        if (name.endsWith(".ppsx")) return "application/vnd.openxmlformats-officedocument.presentationml.slideshow";
        if (name.endsWith(".xml") || name.endsWith(".xsig")) return "application/xml";
        if (name.endsWith(".p7s") || name.endsWith(".csig")) return "application/pkcs7-signature";
        return "application/octet-stream";
      }

      function sourceFileName(file) {
        if (!file) return "";
        return String(file.webkitRelativePath || file.name || "");
      }

      function sourceFileBasename(name) {
        return String(name || "").split(/[\\/]/).pop() || "";
      }

      function inferSelectionTypeFromName(name) {
        const lower = String(name || "").toLowerCase();
        if (lower.endsWith(".pdf")) return t("selectionTypePDF");
        if (lower.endsWith(".xml") || lower.endsWith(".xsig")) return t("selectionTypeXML");
        if (lower.endsWith(".odt")) return t("selectionTypeODF");
        if (lower.endsWith(".docx")) return t("selectionTypeOOXML");
        if (lower.endsWith(".p7s") || lower.endsWith(".csig") || lower.endsWith(".p7m")) return t("selectionTypeCMS");
        return t("selectionTypeGeneric");
      }

      function detectVerifyArtifactKind(nameOrPath) {
        return inferSelectionTypeFromName(nameOrPath);
      }

      function renderSelectionTypeSummary() {
        const localPath = ui.localPathInput.value.trim();
        if (state.selectedFiles.length > 1) {
          ui.selectionTypeSummary.innerHTML = '<strong>' + escapeHtml(t("selectionTypeTitle")) + ':</strong> ' + escapeHtml(t("selectionTypeBatch"));
          return;
        }
        if (state.selectedFiles.length === 1) {
          ui.selectionTypeSummary.innerHTML = '<strong>' + escapeHtml(t("selectionTypeTitle")) + ':</strong> ' + escapeHtml(inferSelectionTypeFromName(sourceFileName(state.selectedFiles[0])));
          return;
        }
        if (localPath) {
          ui.selectionTypeSummary.innerHTML = '<strong>' + escapeHtml(t("selectionTypeTitle")) + ':</strong> ' + escapeHtml(inferSelectionTypeFromName(localPath));
          return;
        }
        ui.selectionTypeSummary.innerHTML = '<span class="muted">' + escapeHtml(t("selectionTypePending")) + '</span>';
      }

      function signedMimeTypeForFormat(format, fallbackName) {
        const normalized = String(format || "").toUpperCase();
        if (normalized === "PADES") return "application/pdf";
        if (normalized === "ODF") return "application/vnd.oasis.opendocument.text";
        if (normalized === "OOXML") return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        if (normalized === "FACTURAE") return "application/xml";
        if (normalized === "ASIC-XADES") return "application/vnd.etsi.asic-s+zip";
        if (normalized === "XADES") return "application/xml";
        if (normalized === "XMLDSIG") return "application/xmldsig+xml";
        const lowerName = String(fallbackName || "").toLowerCase();
        if (lowerName.endsWith(".pdf")) return "application/pdf";
        if (lowerName.endsWith(".odt")) return "application/vnd.oasis.opendocument.text";
        if (lowerName.endsWith(".docx")) return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        if (lowerName.endsWith(".xml") || lowerName.endsWith(".xsig")) return "application/xml";
        return "application/pkcs7-signature";
      }

      function currentFormat() {
        return ui.formatSelect.value;
      }

      function currentAction() {
        return ui.actionSelect.value || "sign";
      }

      function isPDFSelection() {
        if (currentFormat() !== "PAdES") return false;
        if (state.selectedFiles.length === 0) {
          const localPath = ui.localPathInput.value.trim();
          return !!localPath && /\.pdf$/i.test(localPath);
        }
        return state.selectedFiles.every((file) => {
          const mime = inferMimeType(file).toLowerCase();
          return mime === "application/pdf" || String(file.name || "").toLowerCase().endsWith(".pdf");
        });
      }

      function updateSealVisibility() {
        const showSeal = ui.enableVisibleSeal.checked && currentFormat() === "PAdES" && isPDFSelection();
        ui.sealControls.hidden = !showSeal;
        ui.sealDisabledHint.hidden = currentFormat() === "PAdES";
        updateSealPageMode();
      }

      function updateSealPageMode() {
        ui.sealPage.disabled = !!ui.sealAllPages.checked;
      }

      function applyPreset(position) {
        switch (position) {
          case "bottom-left":
            state.preview.x = 0.04;
            state.preview.y = 0.04;
            state.preview.w = 0.34;
            state.preview.h = 0.12;
            break;
          case "bottom-right":
            state.preview.x = 0.62;
            state.preview.y = 0.04;
            state.preview.w = 0.34;
            state.preview.h = 0.12;
            break;
          case "top-left":
            state.preview.x = 0.04;
            state.preview.y = 0.84;
            state.preview.w = 0.34;
            state.preview.h = 0.12;
            break;
          case "top-right":
            state.preview.x = 0.62;
            state.preview.y = 0.84;
            state.preview.w = 0.34;
            state.preview.h = 0.12;
            break;
          default:
            break;
        }
        syncInputsFromPreview();
        renderPreview();
      }

      function syncInputsFromPreview() {
        ui.sealX.value = clamp01(state.preview.x).toFixed(4);
        ui.sealY.value = clamp01(state.preview.y).toFixed(4);
        ui.sealW.value = clamp01(state.preview.w).toFixed(4);
        ui.sealH.value = clamp01(state.preview.h).toFixed(4);
      }

      function syncPreviewFromInputs() {
        applyPageSelectionValidity();
        state.preview.page = previewPageFromSelection(ui.sealPage.value);
        state.preview.x = clamp01(ui.sealX.value);
        state.preview.y = clamp01(ui.sealY.value);
        state.preview.w = clampMinMax(ui.sealW.value, 0.05, 1);
        state.preview.h = clampMinMax(ui.sealH.value, 0.04, 1);
        state.preview.x = Math.min(state.preview.x, 1 - state.preview.w);
        state.preview.y = Math.min(state.preview.y, 1 - state.preview.h);
        syncInputsFromPreview();
        renderPreview();
      }

      function renderPreview() {
        ui.previewSeal.style.left = (state.preview.x * 100) + "%";
        ui.previewSeal.style.top = ((1 - state.preview.y - state.preview.h) * 100) + "%";
        ui.previewSeal.style.width = (state.preview.w * 100) + "%";
        ui.previewSeal.style.height = (state.preview.h * 100) + "%";
        const showQR = !!ui.signatureQRContent.value.trim() && !state.sealImageDataUrl;
        ui.previewSeal.classList.toggle("has-qr", showQR);
        ui.previewSealQR.title = showQR ? ui.signatureQRContent.value.trim() : "";
      }

      function pointerRatio(event) {
        const rect = ui.previewStage.getBoundingClientRect();
        const x = clampMinMax((event.clientX - rect.left) / rect.width, 0, 1);
        const yTop = clampMinMax((event.clientY - rect.top) / rect.height, 0, 1);
        return { x, yTop };
      }

      function installDragAndResize() {
        let mode = "";
        let start = null;
        let initial = null;

        function onMove(event) {
          if (!mode || !start || !initial) return;
          const current = pointerRatio(event);
          const dx = current.x - start.x;
          const dyTop = current.yTop - start.yTop;
          if (mode === "drag") {
            state.preview.x = clamp01(initial.x + dx);
            const newTop = clampMinMax((1 - initial.y - initial.h) + dyTop, 0, 1 - initial.h);
            state.preview.y = clamp01(1 - newTop - initial.h);
          } else if (mode === "resize") {
            state.preview.w = clampMinMax(initial.w + dx, 0.05, 1 - initial.x);
            const newTop = clampMinMax((1 - initial.y - initial.h), 0, 1);
            const newHeight = clampMinMax(initial.h + dyTop, 0.04, 1 - newTop);
            state.preview.h = newHeight;
            state.preview.y = clamp01(1 - newTop - newHeight);
          }
          syncInputsFromPreview();
          ui.sealPosition.value = "custom";
          renderPreview();
        }

        function onUp() {
          mode = "";
          start = null;
          initial = null;
          persistPreferences();
          window.removeEventListener("pointermove", onMove);
          window.removeEventListener("pointerup", onUp);
        }

        ui.previewSeal.addEventListener("pointerdown", (event) => {
          if (event.target === ui.resizeHandle) return;
          mode = "drag";
          start = pointerRatio(event);
          initial = Object.assign({}, state.preview);
          window.addEventListener("pointermove", onMove);
          window.addEventListener("pointerup", onUp);
        });

        ui.resizeHandle.addEventListener("pointerdown", (event) => {
          event.stopPropagation();
          mode = "resize";
          start = pointerRatio(event);
          initial = Object.assign({}, state.preview);
          window.addEventListener("pointermove", onMove);
          window.addEventListener("pointerup", onUp);
        });
      }

      function buildSignOptions() {
        const options = {};
        if (ui.enableVisibleSeal.checked && currentFormat() === "PAdES" && isPDFSelection()) {
          if (!applyPageSelectionValidity()) {
            throw new Error(t("invalidPageSelection"));
          }
          options.visibleSeal = "true";
          options.visibleSealRectX = String((state.preview.x * A4_WIDTH).toFixed(2));
          options.visibleSealRectY = String((state.preview.y * A4_HEIGHT).toFixed(2));
          options.visibleSealRectW = String((state.preview.w * A4_WIDTH).toFixed(2));
          options.visibleSealRectH = String((state.preview.h * A4_HEIGHT).toFixed(2));
          options.page = ui.sealAllPages.checked ? "all" : normalizePageSelection(ui.sealPage.value);
          options.visibleSealKeepText = ui.keepSealText.checked ? "true" : "false";
          if (state.sealImageDataUrl) {
            const comma = state.sealImageDataUrl.indexOf(",");
            options.visibleSealImageBase64 = comma >= 0 ? state.sealImageDataUrl.slice(comma + 1) : state.sealImageDataUrl;
          }
          if (ui.signatureQRContent.value.trim()) {
            options.qrContent = ui.signatureQRContent.value.trim();
          }
        }
        if (currentFormat() === "PAdES") {
          if (ui.padesSubFilter.value.trim()) options.subfilter = ui.padesSubFilter.value.trim();
          if (ui.signatureReason.value.trim()) options.reason = ui.signatureReason.value.trim();
          if (ui.signatureLocation.value.trim()) options.location = ui.signatureLocation.value.trim();
          if (ui.signatureContact.value.trim()) options.contactInfo = ui.signatureContact.value.trim();
        }
        if (currentFormat() === "FacturaE") {
          if (ui.facturaePolicyVersion.value.trim()) options.facturaePolicyVersion = ui.facturaePolicyVersion.value.trim();
          if (ui.facturaePolicyIdentifier.value.trim()) options.policyIdentifier = ui.facturaePolicyIdentifier.value.trim();
          if (ui.facturaePolicyIdentifierHash.value.trim()) options.policyIdentifierHash = ui.facturaePolicyIdentifierHash.value.trim();
          if (ui.facturaePolicyQualifier.value.trim()) options.policyQualifier = ui.facturaePolicyQualifier.value.trim();
          if (ui.facturaeSignerRole.value.trim()) options.signerClaimedRole = ui.facturaeSignerRole.value.trim();
          if (ui.facturaeSignatureCity.value.trim()) options.signatureProductionCity = ui.facturaeSignatureCity.value.trim();
          if (ui.facturaeSignatureProvince.value.trim()) options.signatureProductionProvince = ui.facturaeSignatureProvince.value.trim();
          if (ui.facturaeSignaturePostalCode.value.trim()) options.signatureProductionPostalCode = ui.facturaeSignaturePostalCode.value.trim();
          if (ui.facturaeSignatureCountry.value.trim()) options.signatureProductionCountry = ui.facturaeSignatureCountry.value.trim();
        }
        if (currentFormat() === "PAdES" || currentFormat() === "CAdES" || currentFormat() === "XAdES") {
          if (ui.signProfile.value.trim()) options.profile = ui.signProfile.value.trim();
          if (ui.tsaUrl.value.trim()) options.tsaURL = ui.tsaUrl.value.trim();
        }
        return options;
      }

      function stripVisualOptionsForCoSign(options) {
        const out = { ...(options || {}) };
        [
          "visibleSeal",
          "visibleSealRectX",
          "visibleSealRectY",
          "visibleSealRectW",
          "visibleSealRectH",
          "page",
          "rotation",
          "visibleSealKeepText",
          "visibleSealImagePath",
          "visibleSealImageBase64",
          "visibleSealSignerSummary",
          "qrContent",
          "visibleSealQRContent"
        ].forEach((key) => delete out[key]);
        return out;
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = String(reader.result || "");
            const comma = result.indexOf(",");
            resolve(comma >= 0 ? result.slice(comma + 1) : result);
          };
          reader.onerror = () => reject(reader.error || new Error("file reader error"));
          reader.readAsDataURL(file);
        });
      }

      function base64ToFile(base64, name, mimeType) {
        const binary = atob(base64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i += 1) {
          bytes[i] = binary.charCodeAt(i);
        }
        return new File([bytes], name || "documento", { type: mimeType || "application/octet-stream" });
      }

      function loadExtensionDocument(payload) {
        if (!payload || !payload.contentBase64) {
          throw new Error(t("extensionDocumentError"));
        }
        state.selectedFiles = [base64ToFile(payload.contentBase64, payload.name, payload.mimeType)];
        if (/\.pdf$/i.test(String(payload.name || ""))) {
          ui.formatSelect.value = "PAdES";
        }
        updateFileMeta();
        updateSealVisibility();
        syncPreviewFromInputs();
        persistPreferences();
        setResult(t("extensionDocumentLoaded"), "ok");
      }

      function installExtensionBridge() {
        window.addEventListener("message", (event) => {
          if (event.origin !== window.location.origin) return;
          const data = event.data || {};
          if (data.type === "grxfirma-extension-document") {
            try {
              loadExtensionDocument(data.document);
            } catch (err) {
              setResult((err && err.message) || t("extensionDocumentError"), "bad");
            }
            return;
          }
          if (data.type === "grxfirma-extension-document-error") {
            setResult(t("extensionDocumentError") + " " + String(data.error || ""), "bad");
          }
        });
      }

      async function buildBatchResultsHTML(results, originalItems, format) {
        const extension = format === "PAdES" ? ".pdf" : (format === "XAdES" ? ".xsig" : (format === "XMLdSig" ? ".dsig" : (format === "ODF" ? ".odt" : (format === "OOXML" ? ".docx" : (format === "FacturaE" ? ".xml" : (format === "ASiC-XAdES" ? ".asics" : ".csig"))))));
        const rows = await Promise.all(results.map(async (item, index) => {
          let downloadHtml = "";
          if (item && item.ok && item.signed_content_base64) {
            const raw = Uint8Array.from(atob(item.signed_content_base64), (c) => c.charCodeAt(0));
            const blob = new Blob([raw], { type: format === "PAdES" ? "application/pdf" : "application/octet-stream" });
            const url = URL.createObjectURL(blob);
            state.signDownloadUrls.push(url);
            const filenameBase = sourceFileBasename(String(item.name || ("documento_" + (index + 1)))).replace(/\.[^.]+$/, "");
            downloadHtml = ' <a class="link-btn" href="' + url + '" download="' + escapeHtml(filenameBase + "_firmado" + extension) + '">' + escapeHtml(t("downloadSignedBatch")) + '</a>';
          }
          const originalItem = Array.isArray(originalItems) ? originalItems[index] : null;
          const verification = item && item.ok
            ? await verifySignedPayload(
                item.signed_content_base64 || "",
                originalItem && originalItem.content_base64,
                item.name || (originalItem && originalItem.name) || ("documento_" + (index + 1)),
                signedMimeTypeForFormat(item && item.format ? item.format : format, item && item.name ? item.name : (originalItem && originalItem.name)),
                item && item.outputPath ? item.outputPath : ""
              )
            : null;
          const badgeClass = item && item.ok ? "ok" : "bad";
          const statusText = item && item.ok ? t("signSuccess") : (item && item.error ? item.error : t("batchResultError"));
          return '<li><span class="status ' + badgeClass + '">' + escapeHtml(String(item && item.name ? item.name : ("#" + (index + 1)))) + ': ' + escapeHtml(statusText) + '</span>' + downloadHtml + buildVerificationHTML(verification) + '</li>';
        }));
        return '<ul style="margin:12px 0 0 18px;padding:0">' + rows.join("") + '</ul>';
      }

      async function verifySignedPayload(signedContentBase64, originalContentBase64, filename, mimeType, inputPath, originalPath) {
        if (!signedContentBase64 && !inputPath) return null;
        try {
          const payload = {
            name: filename || "documento",
            mime_type: mimeType || "application/octet-stream",
            original_content_base64: originalContentBase64 || undefined
          };
          if (signedContentBase64) {
            payload.content_base64 = signedContentBase64;
          } else if (inputPath) {
            payload.inputPath = inputPath;
          }
          if (originalPath) {
            payload.originalPath = originalPath;
          }
          return await apiFetch("/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
        } catch (err) {
          return {
            valid: false,
            reason: err.message || String(err),
            details: [],
            signers: [],
            result: {
              valid: false,
              reason: err.message || String(err),
              details: [],
              signers: [],
              integrity: { status: "invalid", reason: err.message || String(err), details: [] },
              certificate: { status: "unknown", details: [] },
              trust: { status: "unknown", details: [] },
              warnings: [],
              errors: [err.message || String(err)],
              evidence: []
            }
          };
        }
      }

      function verificationData(verification) {
        if (!verification) return null;
        if (verification.result && typeof verification.result === "object") return verification.result;
        return verification;
      }

      function verificationStatusText(status) {
        switch (String(status || "").toLowerCase()) {
          case "valid":
            return t("verificationStatusValid");
          case "invalid":
            return t("verificationStatusInvalid");
          case "warning":
            return t("verificationStatusWarning");
          default:
            return t("verificationStatusUnknown");
        }
      }

      function verificationStatusClass(status) {
        switch (String(status || "").toLowerCase()) {
          case "valid":
            return "ok";
          case "invalid":
            return "bad";
          case "warning":
            return "warn";
          default:
            return "";
        }
      }

      function verificationPostureInfo(rich) {
        const integrityStatus = String(rich && rich.integrity && rich.integrity.status || "").toLowerCase();
        const trustStatus = String(rich && rich.trust && rich.trust.status || "").toLowerCase();
        const certificateStatus = String(rich && rich.certificate && rich.certificate.status || "").toLowerCase();
        const warnings = Array.isArray(rich && rich.warnings) ? rich.warnings : [];
        const errors = Array.isArray(rich && rich.errors) ? rich.errors : [];
        let kind = "ok";
        let text = t("verificationPostureTrusted");
        if (!rich || rich.valid === false || integrityStatus === "invalid" || errors.length > 0) {
          kind = "bad";
          text = t("verificationPostureInvalid");
        } else if (trustStatus === "warning" || trustStatus === "invalid" || certificateStatus === "warning" || certificateStatus === "invalid" || warnings.length > 0) {
          kind = "warn";
          text = t("verificationPostureWarning");
        }
        return { kind, text };
      }

      function buildAspectHTML(title, aspect) {
        if (!aspect || typeof aspect !== "object") return "";
        const details = Array.isArray(aspect.details) ? aspect.details : [];
        const reason = aspect.reason || "";
        return '<div class="meta" style="margin-top:12px">' +
          '<strong>' + escapeHtml(title) + '</strong><br>' +
          '<strong>' + escapeHtml(t("verificationStatus")) + ':</strong> ' +
            '<span class="status ' + verificationStatusClass(aspect.status) + '">' + escapeHtml(verificationStatusText(aspect.status)) + '</span><br>' +
          '<strong>' + escapeHtml(t("verificationReason")) + ':</strong> ' + escapeHtml(reason || t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationDetails")) + ':</strong> ' + escapeHtml(details.length ? details.join("\n") : t("notAvailable")) +
        '</div>';
      }

      function buildStringListHTML(title, values) {
        const items = Array.isArray(values) ? values.filter(Boolean) : [];
        return '<div class="meta" style="margin-top:12px">' +
          '<strong>' + escapeHtml(title) + '</strong><br>' +
          escapeHtml(items.length ? items.join("\n") : t("notAvailable")) +
        '</div>';
      }

      function buildSignerSummariesHTML(items) {
        const rows = Array.isArray(items) ? items : [];
        if (!rows.length) return buildStringListHTML(t("verificationSignerSummary"), []);
        return '<div class="meta" style="margin-top:12px">' +
          '<strong>' + escapeHtml(t("verificationSignerSummary")) + '</strong><br>' +
          rows.map((item) => {
            const parts = [];
            if (item.subject) parts.push(item.subject);
            if (item.issuer) parts.push(item.issuer);
            if (item.fingerprint) parts.push(item.fingerprint);
            if (!parts.length && item.id) parts.push(item.id);
            return escapeHtml(parts.join(" | "));
          }).join("<br>") +
        '</div>';
      }

      function buildEvidenceHTML(items) {
        const rows = Array.isArray(items) ? items : [];
        if (!rows.length) return buildStringListHTML(t("verificationEvidence"), []);
        return '<div class="meta" style="margin-top:12px">' +
          '<strong>' + escapeHtml(t("verificationEvidence")) + '</strong><br>' +
          rows.map((item) => {
            const type = item && item.type ? String(item.type) : t("notAvailable");
            const summary = item && item.summary ? String(item.summary) : "";
            return '<strong>' + escapeHtml(t("verificationType")) + ':</strong> ' + escapeHtml(type) +
              (summary ? ' · ' + escapeHtml(summary) : '');
          }).join("<br>") +
        '</div>';
      }

      function buildVerificationPostureHTML(rich) {
        const posture = verificationPostureInfo(rich);
        return '<div class="status ' + posture.kind + '" style="margin-top:12px"><strong>' +
          escapeHtml(t("verificationPosture")) + ':</strong> ' + escapeHtml(posture.text) + '</div>';
      }

      function renderQuickVerifyResultSummary(verification) {
        if (!verification) {
          ui.quickVerifyResultSummary.innerHTML = '<span class="muted">' + escapeHtml(t("quickVerifyResultPending")) + '</span>';
          return;
        }
        const rich = verificationData(verification);
        const posture = verificationPostureInfo(rich);
        const signers = Array.isArray(rich && rich.signers) ? rich.signers : [];
        ui.quickVerifyResultSummary.innerHTML =
          '<strong>' + escapeHtml(t("quickVerifyResultTitle")) + '</strong><br>' +
          '<span class="status ' + posture.kind + '">' + escapeHtml(posture.text) + '</span><br>' +
          '<strong>' + escapeHtml(t("verificationStatus")) + ':</strong> ' + escapeHtml(rich && rich.valid ? t("verificationValid") : t("verificationInvalid")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationFormat")) + ':</strong> ' + escapeHtml(rich && rich.format ? rich.format : t("notAvailable")) + ' · ' +
            '<strong>' + escapeHtml(t("verificationCoverage")) + ':</strong> ' + escapeHtml(rich && rich.coverage ? rich.coverage : t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationIntegrity")) + ':</strong> ' + escapeHtml(verificationStatusText(rich && rich.integrity && rich.integrity.status)) + ' · ' +
            '<strong>' + escapeHtml(t("verificationCertificate")) + ':</strong> ' + escapeHtml(verificationStatusText(rich && rich.certificate && rich.certificate.status)) + ' · ' +
            '<strong>' + escapeHtml(t("verificationTrust")) + ':</strong> ' + escapeHtml(verificationStatusText(rich && rich.trust && rich.trust.status)) + '<br>' +
          '<strong>' + escapeHtml(t("verificationSigners")) + ':</strong> ' + escapeHtml(signers.length ? String(signers.length) : t("notAvailable"));
      }

      function renderVerificationExportSummary(verification, baseName) {
        if (!verification) {
          state.lastVerificationJSON = "";
          ui.verificationExportSummary.innerHTML = '<span class="muted">' + escapeHtml(t("quickVerifyExportPending")) + '</span>';
          return;
        }
        state.lastVerificationJSON = JSON.stringify(verification, null, 2);
        const filename = sourceFileBasename(baseName || "verificacion").replace(/\.[^.]+$/, "") + "_verificacion.json";
        const blob = new Blob([state.lastVerificationJSON], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        state.signDownloadUrls.push(url);
        const copyButton = navigator.clipboard && typeof navigator.clipboard.writeText === "function"
          ? ' <button type="button" class="link-btn light" data-copy-verification-json="1">' + escapeHtml(t("quickVerifyCopyReady")) + '</button>'
          : "";
        ui.verificationExportSummary.innerHTML =
          '<a class="link-btn secondary" href="' + url + '" download="' + escapeHtml(filename) + '">' +
          escapeHtml(t("quickVerifyExportReady")) +
          '</a>' + copyButton;
      }

      function buildVerificationHTML(verification) {
        if (!verification) return "";
        const rich = verificationData(verification);
        const signers = Array.isArray(rich.signers) ? rich.signers : [];
        const details = Array.isArray(rich.details) ? rich.details : [];
        const valid = !!rich.valid;
        return buildVerificationPostureHTML(rich) +
        '<div class="meta" style="margin-top:12px">' +
          '<strong>' + escapeHtml(t("verifyAfterSign")) + '</strong><br>' +
          '<strong>' + escapeHtml(t("verificationStatus")) + ':</strong> ' + escapeHtml(valid ? t("verificationValid") : t("verificationInvalid")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationReason")) + ':</strong> ' + escapeHtml(rich.reason || t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationSigners")) + ':</strong> ' + escapeHtml(signers.length ? signers.join("\n") : t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationDetails")) + ':</strong> ' + escapeHtml(details.length ? details.join("\n") : t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationFormat")) + ':</strong> ' + escapeHtml(rich.format || t("notAvailable")) + '<br>' +
          '<strong>' + escapeHtml(t("verificationCoverage")) + ':</strong> ' + escapeHtml(rich.coverage || t("notAvailable")) +
        '</div>' +
        buildAspectHTML(t("verificationIntegrity"), rich.integrity) +
        buildAspectHTML(t("verificationCertificate"), rich.certificate) +
        buildAspectHTML(t("verificationTrust"), rich.trust) +
        buildStringListHTML(t("verificationWarnings"), rich.warnings) +
        buildStringListHTML(t("verificationErrors"), rich.errors) +
        buildSignerSummariesHTML(rich.signerSummaries) +
        buildEvidenceHTML(rich.evidence);
      }

      async function performSignRequest(payload) {
        const requestId = newSignRequestId();
        const requestPayload = { ...payload, request_id: requestId };
        state.lastRequestId = requestId;
        const response = await apiFetch("/sign", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(requestPayload)
        });
        state.lastRequestId = supportIncidentSafeRequestId(response.request_id) || requestId;
        return response;
      }

      function newSignRequestId() {
        if (!window.crypto || typeof window.crypto.getRandomValues !== "function") {
          throw new Error(t("notAvailable"));
        }
        const bytes = new Uint8Array(16);
        window.crypto.getRandomValues(bytes);
        return "web-" + Array.from(bytes, (value) => value.toString(16).padStart(2, "0")).join("");
      }

      async function signDocument() {
        clearDownloadUrl();
        state.lastGuidedDiagnostic = null;
        renderResultArtifactSummary(null);
        const localPath = ui.localPathInput.value.trim();
        const outputPath = ui.localOutputPathInput.value.trim();
        if (state.selectedFiles.length === 0 && !localPath) {
          setResult(t("needFile"), "bad");
          return;
        }
        if (!state.selectedCertificateId) {
          setResult(t("needCertificate"), "bad");
          return;
        }
        setResult(t("signing"), "warn");
        try {
          if (state.selectedFiles.length === 1 || (state.selectedFiles.length === 0 && localPath)) {
            const file = state.selectedFiles[0];
            const inputName = file ? (sourceFileName(file) || file.name) : (localPath.split(/[\\/]/).pop() || "documento");
            const inputMime = file ? inferMimeType(file) : inferMimeType(null, localPath);
            const payload = {
              name: inputName,
              mime_type: inputMime,
              format: currentFormat(),
              action: currentAction(),
              certificate_id: state.selectedCertificateId,
              options: buildSignOptions(),
              saveToDisk: ui.saveToDisk.checked,
              returnSignatureB64: ui.returnB64.checked,
              strictCompat: ui.strictCompat.checked
            };
            if (outputPath) {
              payload.outputPath = outputPath;
            }
            if (ui.overwriteOutput.checked) {
              payload.overwrite = "true";
            }
            if (file) {
              payload.content_base64 = await fileToBase64(file);
            } else {
              payload.inputPath = localPath;
            }
            const initialOriginalBase64 = payload.content_base64 || "";
            let response;
            let multiInfoHtml = "";
            if (ui.enableMultiCosign.checked) {
              if (!supportsGuidedMultiCosign()) {
                throw new Error(t("multiCosignUnsupported"));
              }
              const additionalIds = multiCosignAdditionalIds();
              if (!additionalIds.length) {
                throw new Error(t("multiCosignNoAdditional"));
              }
              let workingResponse = await performSignRequest({
                ...payload,
                saveToDisk: false,
                returnSignatureB64: true,
                outputPath: ""
              });
              const followingCoSignOptions = stripVisualOptionsForCoSign(payload.options);
              const appliedSigners = [state.selectedCertificateId];
              for (const additionalId of additionalIds) {
                workingResponse = await performSignRequest({
                  name: inputName,
                  mime_type: signedMimeTypeForFormat(workingResponse.format || currentFormat(), inputName),
                  content_base64: workingResponse.signed_content_base64,
                  format: currentFormat(),
                  action: "cosign",
                  certificate_id: additionalId,
                  options: followingCoSignOptions,
                  saveToDisk: false,
                  returnSignatureB64: true,
                  strictCompat: ui.strictCompat.checked
                });
                appliedSigners.push(additionalId);
              }
              response = workingResponse;
              const signerLabels = appliedSigners.map((id) => {
                const cert = state.certificates.find((item) => item.id === id);
                return cert ? (cert.subjectName || cert.id || id) : id;
              });
              multiInfoHtml =
                '<div class="meta" style="margin-top:12px">' +
                  '<strong>' + escapeHtml(t("multiCosignExecutedTitle")) + ':</strong> ' + escapeHtml(String(signerLabels.length)) + '<br>' +
                  '<strong>' + escapeHtml(t("multiCosignExecutedChain")) + ':</strong> ' + escapeHtml(signerLabels.join(" · ")) +
                  (ui.saveToDisk.checked ? '<br><span class="muted">' + escapeHtml(t("multiCosignMemoryOnlyNotice")) + '</span>' : '') +
                '</div>';
            } else {
              response = await performSignRequest(payload);
            }

            const verification = await verifySignedPayload(
              response.signed_content_base64 || "",
              currentAction() === "sign" ? initialOriginalBase64 : "",
              payload.name,
              inputMime,
              response.outputPath || payload.inputPath || ""
            );
            renderVerificationExportSummary(verification, payload.name || response.outputPath || "firmado");

            const mime = signedMimeTypeForFormat(response.format || currentFormat(), payload.name);
            let downloadHtml = "";
            if (response.signed_content_base64) {
              const raw = Uint8Array.from(atob(response.signed_content_base64), (c) => c.charCodeAt(0));
              const blob = new Blob([raw], { type: mime });
              const url = URL.createObjectURL(blob);
              state.signDownloadUrls.push(url);
              const extension = currentFormat() === "PAdES" ? ".pdf" : (currentFormat() === "XAdES" ? ".xsig" : (currentFormat() === "XMLdSig" ? ".dsig" : (currentFormat() === "ODF" ? ".odt" : (currentFormat() === "OOXML" ? ".docx" : (currentFormat() === "FacturaE" ? ".xml" : (currentFormat() === "ASiC-XAdES" ? ".asics" : ".csig"))))));
              const filename = sourceFileBasename(payload.name || "firmado").replace(/\.[^.]+$/, "") + "_firmado" + extension;
              downloadHtml = '<div style="margin-top:12px"><a class="link-btn" href="' + url + '" download="' + escapeHtml(filename) + '">' + escapeHtml(t("downloadSigned")) + '</a></div>';
            }
            let delivery = t("resultArtifactMemoryOnly");
            if (response.outputPath && response.signed_content_base64) {
              delivery = t("resultArtifactStoredAndDownload");
            } else if (response.outputPath) {
              delivery = t("resultArtifactStored");
            } else if (response.signed_content_base64) {
              delivery = t("resultArtifactDownloadReady");
            }
            renderResultArtifactSummary({
              mode: "single",
              format: response.format || currentFormat(),
              algorithm: response.algorithm || "",
              outputPath: response.outputPath || "",
              delivery: delivery
            });
            ui.resultBox.innerHTML =
              '<div class="status ok">' + escapeHtml(t("signSuccess")) + '</div>' +
              '<div class="meta">' +
                '<strong>' + escapeHtml(t("verificationFormat")) + ':</strong> ' + escapeHtml(response.format || "") + '<br>' +
                '<strong>' + escapeHtml(t("verificationAlgorithm")) + ':</strong> ' + escapeHtml(response.algorithm || "") + '<br>' +
                '<strong>' + escapeHtml(t("verificationCertificate")) + ':</strong> ' + escapeHtml(response.certificate_id || "") + '<br>' +
                '<strong>' + escapeHtml(t("outputPath")) + ':</strong> ' + escapeHtml(response.outputPath || t("memoryOutput")) +
              '</div>' +
              multiInfoHtml +
              buildVerificationHTML(verification) +
              downloadHtml;
            return;
          }

          const items = [];
          for (const file of state.selectedFiles) {
            items.push({
              name: sourceFileName(file) || file.name,
              mime_type: inferMimeType(file),
              content_base64: await fileToBase64(file)
            });
          }
          const payload = {
            request_id: newSignRequestId(),
            items,
            format: currentFormat(),
            action: currentAction(),
            certificate_id: state.selectedCertificateId,
            options: buildSignOptions(),
            saveToDisk: ui.saveToDisk.checked,
            returnSignatureB64: ui.returnB64.checked,
            strictCompat: ui.strictCompat.checked
          };
          state.lastRequestId = payload.request_id;
          if (ui.overwriteOutput.checked) {
            payload.overwrite = "true";
          }
          const response = await apiFetch("/sign-batch", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          state.lastRequestId = supportIncidentSafeRequestId(response.request_id) || payload.request_id;
          renderResultArtifactSummary({
            mode: "batch",
            format: currentFormat(),
            total: response.total || state.selectedFiles.length,
            success: response.successCount || 0,
            failure: response.failureCount || 0,
            downloadable: Array.isArray(response.results) ? response.results.filter((item) => item && item.ok && item.signed_content_base64).length : 0
          });
          const successClass = response.failureCount > 0 ? "warn" : "ok";
          const headline = response.failureCount > 0 ? t("batchSignPartial") : t("batchSignSuccess");
          ui.resultBox.innerHTML =
            '<div class="status ' + successClass + '">' + escapeHtml(headline) + '</div>' +
            '<div class="meta">' +
              '<strong>' + escapeHtml(t("batchResultTotal")) + ':</strong> ' + escapeHtml(String(response.total || state.selectedFiles.length)) + '<br>' +
              '<strong>' + escapeHtml(t("batchResultOk")) + ':</strong> ' + escapeHtml(String(response.successCount || 0)) + '<br>' +
              '<strong>' + escapeHtml(t("batchResultKo")) + ':</strong> ' + escapeHtml(String(response.failureCount || 0)) +
            '</div>' +
            await buildBatchResultsHTML(Array.isArray(response.results) ? response.results : [], payload.items, currentFormat());
        } catch (err) {
          setResult(err.message || String(err), "bad");
        }
      }

      async function quickVerify() {
        const path = ui.quickVerifyPathInput.value.trim();
        const originalPath = ui.quickVerifyOriginalPathInput.value.trim();
        if (!state.quickVerifyFile && !path) {
          setResult(t("quickVerifyNeedArtifact"), "bad");
          return;
        }
        setResult(t("quickVerifyRunning"), "warn");
        try {
          const verification = await verifySignedPayload(
            state.quickVerifyFile ? await fileToBase64(state.quickVerifyFile) : "",
            state.quickVerifyOriginalFile ? await fileToBase64(state.quickVerifyOriginalFile) : "",
            state.quickVerifyFile ? (sourceFileName(state.quickVerifyFile) || state.quickVerifyFile.name || "documento") : (path.split(/[\\/]/).pop() || "documento"),
            state.quickVerifyFile ? inferMimeType(state.quickVerifyFile) : signedMimeTypeForFormat("AUTO", path),
            path,
            originalPath
          );
          renderQuickVerifyResultSummary(verification);
          renderVerificationExportSummary(verification, state.quickVerifyFile ? (sourceFileName(state.quickVerifyFile) || state.quickVerifyFile.name || "verificacion") : (path.split(/[\\/]/).pop() || "verificacion"));
          ui.resultBox.innerHTML = buildVerificationHTML(verification);
        } catch (err) {
          renderQuickVerifyResultSummary({
            valid: false,
            result: {
              valid: false,
              integrity: { status: "invalid" },
              certificate: { status: "unknown" },
              trust: { status: "unknown" },
              errors: [err.message || String(err)]
            }
          });
          renderVerificationExportSummary(null);
          setResult(err.message || String(err), "bad");
        }
      }

      function bindEvents() {
        ui.pickFileBtn.addEventListener("click", () => ui.fileInput.click());
        ui.pickDirectoryBtn.addEventListener("click", () => ui.directoryInput.click());
        ui.dropzone.addEventListener("click", () => ui.fileInput.click());
        ui.fileInput.addEventListener("change", () => {
          ui.directoryInput.value = "";
          ui.localPathInput.value = "";
          state.selectedFiles = Array.from(ui.fileInput.files || []);
          updateFileMeta();
          updateSealVisibility();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          syncPreviewFromInputs();
          persistPreferences();
        });
        ui.directoryInput.addEventListener("change", () => {
          ui.fileInput.value = "";
          ui.localPathInput.value = "";
          state.selectedFiles = Array.from(ui.directoryInput.files || []);
          updateFileMeta();
          updateSealVisibility();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          syncPreviewFromInputs();
          persistPreferences();
        });
        ui.clearFileBtn.addEventListener("click", () => {
          ui.fileInput.value = "";
          ui.directoryInput.value = "";
          ui.localPathInput.value = "";
          state.selectedFiles = [];
          updateFileMeta();
          updateSealVisibility();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          syncPreviewFromInputs();
          persistPreferences();
        });
        ["dragenter", "dragover"].forEach((name) => {
          ui.dropzone.addEventListener(name, (event) => {
            event.preventDefault();
            ui.dropzone.classList.add("drag");
          });
        });
        ["dragleave", "drop"].forEach((name) => {
          ui.dropzone.addEventListener(name, (event) => {
            event.preventDefault();
            ui.dropzone.classList.remove("drag");
          });
        });
        ui.dropzone.addEventListener("drop", (event) => {
          ui.fileInput.value = "";
          ui.directoryInput.value = "";
          ui.localPathInput.value = "";
          const files = event.dataTransfer && event.dataTransfer.files;
          state.selectedFiles = Array.from(files || []);
          updateFileMeta();
          updateSealVisibility();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          syncPreviewFromInputs();
          persistPreferences();
        });
        ui.refreshCertificatesBtn.addEventListener("click", loadCertificates);
        ui.certificateExportSummary.addEventListener("click", async (event) => {
          const copyJSON = event.target && event.target.closest ? event.target.closest("[data-copy-certificate-json]") : null;
          const copyFingerprint = event.target && event.target.closest ? event.target.closest("[data-copy-certificate-fingerprint]") : null;
          if (!copyJSON && !copyFingerprint) return;
          event.preventDefault();
          if (!(navigator.clipboard && typeof navigator.clipboard.writeText === "function")) {
            setStatus("warn", copyFingerprint ? t("certificateFingerprintCopyError") : t("certificateCopyError"));
            return;
          }
          try {
            if (copyFingerprint) {
              if (!state.lastCertificateFingerprint) {
                setStatus("warn", t("certificateExportPending"));
                return;
              }
              await navigator.clipboard.writeText(state.lastCertificateFingerprint);
              setStatus("ok", t("certificateFingerprintCopyDone"));
              return;
            }
            if (!state.lastCertificateJSON) {
              setStatus("warn", t("certificateExportPending"));
              return;
            }
            await navigator.clipboard.writeText(state.lastCertificateJSON);
            setStatus("ok", t("certificateCopyDone"));
          } catch (err) {
            setStatus("bad", copyFingerprint ? t("certificateFingerprintCopyError") : t("certificateCopyError"));
          }
        });
        ui.verificationExportSummary.addEventListener("click", async (event) => {
          const trigger = event.target && event.target.closest ? event.target.closest("[data-copy-verification-json]") : null;
          if (!trigger) return;
          event.preventDefault();
          if (!state.lastVerificationJSON) {
            setStatus("warn", t("quickVerifyExportPending"));
            return;
          }
          if (!(navigator.clipboard && typeof navigator.clipboard.writeText === "function")) {
            setStatus("warn", t("quickVerifyCopyError"));
            return;
          }
          try {
            await navigator.clipboard.writeText(state.lastVerificationJSON);
            setStatus("ok", t("quickVerifyCopyDone"));
          } catch (err) {
            setStatus("bad", t("quickVerifyCopyError"));
          }
        });
        ui.supportCopyBtn.addEventListener("click", async () => {
          if (!(navigator.clipboard && typeof navigator.clipboard.writeText === "function")) {
            setStatus("warn", t("supportCopyUnavailable"));
            return;
          }
          try {
            await navigator.clipboard.writeText(buildSupportIncidentText());
            setStatus("ok", t("supportCopyDone"));
          } catch (err) {
            setStatus("bad", t("supportCopyError"));
          }
        });
        ui.supportExpertMode.addEventListener("change", () => {
          renderSupportSummary();
          persistPreferences();
        });
        ui.prepareIncidentBtn.addEventListener("click", prepareSupportIncident);
        ui.supportExportSummary.addEventListener("click", async (event) => {
          const trigger = event.target && event.target.closest ? event.target.closest("[data-copy-support-incident]") : null;
          if (!trigger) return;
          event.preventDefault();
          if (!state.lastSupportIncidentJSON) {
            setStatus("warn", t("supportExportPending"));
            return;
          }
          if (!(navigator.clipboard && typeof navigator.clipboard.writeText === "function")) {
            setStatus("warn", t("supportCopyUnavailable"));
            return;
          }
          try {
            await navigator.clipboard.writeText(state.lastSupportIncidentJSON);
            setStatus("ok", t("supportExportCopyDone"));
          } catch (err) {
            setStatus("bad", t("supportExportCopyError"));
          }
        });
        ui.autoSelectCertificateBtn.addEventListener("click", autoSelectCertificate);
        ui.clearSelectedCertificateBtn.addEventListener("click", () => {
          state.selectedCertificateId = "";
          if (ui.certificateSelect) {
            ui.certificateSelect.value = "";
          }
          renderCertificatePreferenceSummary(null, false);
          renderCertificateAutoSelectSummary("", t("certificateAutoSelectIdle"));
          renderMultiCosignCandidates();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          describeCertificate(null);
          persistPreferences();
        });
        [ui.localPathInput, ui.localOutputPathInput].forEach((element) => {
          element.addEventListener("input", () => {
            if (element === ui.localPathInput && element.value.trim()) {
              ui.fileInput.value = "";
              ui.directoryInput.value = "";
              state.selectedFiles = [];
            }
            updateFileMeta();
            updateSealVisibility();
            updateMultiCosignVisibility();
            renderMultiCosignSummary();
            persistPreferences();
          });
        });
        [ui.saveToDisk, ui.returnB64, ui.overwriteOutput].forEach((element) => {
          element.addEventListener("change", () => {
            renderSignPlanSummary();
            renderVerificationPlanSummary();
            renderOutputDeliverySummary();
            persistPreferences();
          });
        });
        ui.certificateSelect.addEventListener("change", () => {
          state.selectedCertificateId = ui.certificateSelect.value;
          renderCertificatePreferenceSummary(state.certificates.find((item) => item.id === state.selectedCertificateId) || null, false);
          renderMultiCosignCandidates();
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          persistPreferences();
          describeCertificate(state.certificates.find((item) => item.id === state.selectedCertificateId));
        });
        ui.rememberSelectedCertificate.addEventListener("change", () => {
          renderCertificatePreferenceSummary(state.certificates.find((item) => item.id === state.selectedCertificateId) || null, false);
          persistPreferences();
        });
        [ui.certificateSubjectFilter, ui.certificateIssuerFilter].forEach((element) => {
          element.addEventListener("input", () => {
            renderCertificateInventory();
            persistPreferences();
          });
        });
        ui.clearCertificateFiltersBtn.addEventListener("click", () => {
          clearCertificateFilters();
        });
        [ui.onlyUsableCertificates, ui.onlyValidCertificates].forEach((element) => {
          element.addEventListener("change", () => {
            renderCertificateInventory();
            persistPreferences();
          });
        });
        ui.formatSelect.addEventListener("change", () => {
          updateSealVisibility();
          updateMultiCosignVisibility();
          renderSignPlanSummary();
          renderVerificationPlanSummary();
          renderOutputDeliverySummary();
          renderOutputArtifactSummary();
          renderMetadataApplicabilitySummary();
          renderMetadataDeliverySummary();
          persistPreferences();
        });
        ui.actionSelect.addEventListener("change", () => {
          updateMultiCosignVisibility();
          renderSignPlanSummary();
          renderCertificateRoleSummary();
          renderOperationStrategySummary();
          renderVerificationPlanSummary();
          renderOutputDeliverySummary();
          persistPreferences();
        });
        ui.enableMultiCosign.addEventListener("change", () => {
          updateMultiCosignVisibility();
          renderMultiCosignSummary();
          renderSignPlanSummary();
          renderOperationStrategySummary();
          renderOutputDeliverySummary();
          persistPreferences();
        });
        ui.multiCosignSelect.addEventListener("change", () => {
          renderMultiCosignSummary();
          persistPreferences();
        });
        ui.multiCosignSelectAllBtn.addEventListener("click", selectAllMultiCosignCandidates);
        ui.multiCosignClearBtn.addEventListener("click", clearMultiCosignCandidates);
        [ui.signProfile, ui.tsaUrl, ui.padesSubFilter].forEach((element) => {
          const evt = element.tagName === "SELECT" ? "change" : "input";
          element.addEventListener(evt, () => {
            renderSignPlanSummary();
            persistPreferences();
          });
        });
        ui.strictCompat.addEventListener("change", persistPreferences);
        ui.keepSealText.addEventListener("change", persistPreferences);
        [ui.signatureQRContent, ui.signatureReason, ui.signatureLocation, ui.signatureContact].forEach((element) => {
          element.addEventListener("input", () => {
            persistPreferences();
            renderMetadataSummary();
            renderMetadataApplicabilitySummary();
            renderMetadataDeliverySummary();
            renderPreview();
          });
        });
        [ui.facturaePolicyVersion, ui.facturaeSignerRole, ui.facturaePolicyIdentifier, ui.facturaePolicyIdentifierHash, ui.facturaePolicyQualifier, ui.facturaeSignatureCity, ui.facturaeSignatureProvince, ui.facturaeSignaturePostalCode, ui.facturaeSignatureCountry].forEach((element) => {
          const evt = element.tagName === "SELECT" ? "change" : "input";
          element.addEventListener(evt, persistPreferences);
        });
        ui.enableVisibleSeal.addEventListener("change", () => {
          updateSealVisibility();
          renderSignPlanSummary();
          renderMetadataDeliverySummary();
          persistPreferences();
        });
        ui.sealAllPages.addEventListener("change", () => {
          updateSealPageMode();
          applyPageSelectionValidity();
          persistPreferences();
        });
        ui.sealPosition.addEventListener("change", () => {
          if (ui.sealPosition.value !== "custom") {
            applyPreset(ui.sealPosition.value);
          }
          persistPreferences();
        });
        [ui.sealPage, ui.sealX, ui.sealY, ui.sealW, ui.sealH].forEach((element) => {
          element.addEventListener("change", () => {
            syncPreviewFromInputs();
            ui.sealPosition.value = "custom";
            persistPreferences();
          });
        });
        ui.sealPage.addEventListener("blur", () => {
          applyPageSelectionValidity();
          persistPreferences();
        });
        ui.selectSealImageBtn.addEventListener("click", () => ui.sealImageInput.click());
        ui.sealImageInput.addEventListener("change", () => {
          const file = ui.sealImageInput.files && ui.sealImageInput.files[0] ? ui.sealImageInput.files[0] : null;
          if (!file) return;
          const reader = new FileReader();
          reader.onload = () => {
            state.sealImageDataUrl = String(reader.result || "");
            ui.sealImagePreview.src = state.sealImageDataUrl;
            ui.sealImagePreview.hidden = !state.sealImageDataUrl;
            renderPreview();
          };
          reader.readAsDataURL(file);
        });
        ui.removeSealImageBtn.addEventListener("click", () => {
          ui.sealImageInput.value = "";
          state.sealImageDataUrl = "";
          ui.sealImagePreview.src = "";
          ui.sealImagePreview.hidden = true;
          renderPreview();
        });
        ui.signBtn.addEventListener("click", signDocument);
        ui.quickVerifyPickBtn.addEventListener("click", () => ui.quickVerifyFileInput.click());
        ui.quickVerifyPickOriginalBtn.addEventListener("click", () => ui.quickVerifyOriginalFileInput.click());
        ui.quickVerifyFileInput.addEventListener("change", () => {
          state.quickVerifyFile = ui.quickVerifyFileInput.files && ui.quickVerifyFileInput.files[0] ? ui.quickVerifyFileInput.files[0] : null;
          if (state.quickVerifyFile) {
            ui.quickVerifyPathInput.value = "";
          }
          renderQuickVerifySummary();
          persistPreferences();
        });
        ui.quickVerifyOriginalFileInput.addEventListener("change", () => {
          state.quickVerifyOriginalFile = ui.quickVerifyOriginalFileInput.files && ui.quickVerifyOriginalFileInput.files[0] ? ui.quickVerifyOriginalFileInput.files[0] : null;
          if (state.quickVerifyOriginalFile) {
            ui.quickVerifyOriginalPathInput.value = "";
          }
          renderQuickVerifySummary();
          persistPreferences();
        });
        ui.quickVerifyClearBtn.addEventListener("click", () => {
          ui.quickVerifyFileInput.value = "";
          ui.quickVerifyOriginalFileInput.value = "";
          ui.quickVerifyPathInput.value = "";
          ui.quickVerifyOriginalPathInput.value = "";
          state.quickVerifyFile = null;
          state.quickVerifyOriginalFile = null;
          renderQuickVerifySummary();
          persistPreferences();
        });
        ui.quickVerifyPathInput.addEventListener("input", () => {
          if (ui.quickVerifyPathInput.value.trim()) {
            ui.quickVerifyFileInput.value = "";
            state.quickVerifyFile = null;
          }
          renderQuickVerifySummary();
          persistPreferences();
        });
        ui.quickVerifyOriginalPathInput.addEventListener("input", () => {
          if (ui.quickVerifyOriginalPathInput.value.trim()) {
            ui.quickVerifyOriginalFileInput.value = "";
            state.quickVerifyOriginalFile = null;
          }
          renderQuickVerifySummary();
          persistPreferences();
        });
        ui.quickVerifyBtn.addEventListener("click", quickVerify);
        installDragAndResize();
      }

      async function init() {
        restorePreferences();
        installExtensionBridge();
        bindEvents();
        updateFileMeta();
        syncPreviewFromInputs();
        updateSealVisibility();
        updateSealPageMode();
        updateMultiCosignVisibility();
        renderSignPlanSummary();
        renderMultiCosignSummary();
        renderCertificateRoleSummary();
        renderOperationStrategySummary();
        renderVerificationPlanSummary();
        renderOutputDeliverySummary();
        renderOutputArtifactSummary();
        renderProxySecretStoreSummary(null);
        renderQuickVerifySummary();
        renderResultArtifactSummary(null);
        renderSupportSummary();
        renderSelectionTypeSummary();
        renderMetadataSummary();
        renderMetadataApplicabilitySummary();
        renderMetadataDeliverySummary();
        clearSupportExportSummary();
        setResult(t("checking"), "warn");
        await checkHealth();
        await loadCertificates();
        await loadProxySecretStoreStatus();
      }

      init().catch((err) => {
        setStatus("bad", err.message || String(err));
      });
    })();
  </script>
</body>
</html>
