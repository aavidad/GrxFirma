      function supportProbableOwner() {
        const noSource = state.selectedFiles.length === 0 && !ui.localPathInput.value.trim();
        const invalidSealPages = ui.enableVisibleSeal.checked && !ui.sealAllPages.checked && !parsePageSelection(ui.sealPage.value).ok;
        if (noSource) {
          return {
            id: "input",
            label: t("fileCardTitle"),
            reason: ui.guidedAssistantSummary.textContent.trim()
          };
        }
        if (!state.selectedCertificateId) {
          return {
            id: "certificate",
            label: t("certificateCardTitle"),
            reason: ui.certificateStatus.textContent.trim() || ui.guidedAssistantSummary.textContent.trim()
          };
        }
        if (state.lastGuidedDiagnostic) {
          const diagnostic = state.lastGuidedDiagnostic;
          return {
            id: String(diagnostic.category || "unknown"),
            label: guidedDiagnosticCategoryLabel(diagnostic.category),
            reason: String(diagnostic.responsibilityMessage || diagnostic.userMessage || "").trim()
              || ui.resultBox.textContent.trim()
              || ui.guidedAssistantSummary.textContent.trim()
          };
        }
        if (ui.enableMultiCosign.checked && supportsGuidedMultiCosign() && multiCosignAdditionalIds().length === 0) {
          return {
            id: "multi_cosign",
            label: t("multiCosignLabel"),
            reason: ui.multiCosignSummary.textContent.trim() || ui.guidedAssistantSummary.textContent.trim()
          };
        }
        if (ui.enableVisibleSeal.checked && (currentFormat() !== "PAdES" || invalidSealPages)) {
          return {
            id: "visible_seal",
            label: t("sealCardTitle"),
            reason: ui.guidedAssistantSummary.textContent.trim()
          };
        }
        if (state.lastProxySecretStoreStatus && state.lastProxySecretStoreStatus.available === false) {
          return {
            id: "proxy_secret_store",
            label: t("proxySecretStoreTitle"),
            reason: ui.proxySecretStoreSummary.textContent.trim()
          };
        }
        if (ui.quickVerifyResultSummary.textContent.trim() && ui.quickVerifyResultSummary.textContent.trim() !== t("quickVerifyResultPending")) {
          return {
            id: "quick_verify",
            label: t("quickVerifyTitle"),
            reason: ui.quickVerifyResultSummary.textContent.trim()
          };
        }
        if (ui.resultBox.textContent.trim()) {
          return {
            id: "result",
            label: t("results"),
            reason: ui.resultBox.textContent.trim()
          };
        }
        return {
          id: "signer",
          label: t("title"),
          reason: ui.guidedAssistantSummary.textContent.trim() || ui.globalStatus.textContent.trim()
        };
      }

