{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aavidad/GrxFirma/blob/main/docs/schemas/desktop-ipc-v1.schema.json",
  "title": "GrxFirma desktop IPC v1",
  "description": "Contrato NDJSON del IPC local. Omitir protocol mantiene la compatibilidad legacy. get/save/diagnose_token_settings y las acciones unsafe_exceptions_* y unsafe_operation_retry requieren un frontend local autorizado; nunca son opciones web. Sus parámetros rechazan claves duplicadas incluso escapadas, algo que JSON Schema no representa.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "request": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "protocol": {
          "const": "desktop-ipc-v1"
        },
        "requestId": {
          "$ref": "#/$defs/correlationId"
        },
        "traceId": {
          "$ref": "#/$defs/correlationId"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "params": {}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "certificate_export_public"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["certificateId"], "properties": {"certificateId": {"type": "string", "minLength": 1}, "outputPath": {"type": "string"}, "format": {"enum": ["der", "pem"]}, "overwriteConfirmed": {"type": "boolean"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "protection_recipient_import"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "protection_recipient_remove"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "unsafe_exceptions_list"}}, "required": ["action"]},
          "then": {"properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"action": {"const": "unsafe_exceptions_set"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["id", "enabled"], "properties": {"id": {"type": "string", "minLength": 1}, "enabled": {"const": false}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "unsafe_exceptions_activate"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["id", "accepted", "acceptanceVersion"], "properties": {"id": {"type": "string", "minLength": 1}, "accepted": {"const": true}, "acceptanceVersion": {"const": "2026-11-15.3"}, "retryId": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "unsafe_operation_retry"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["retryId"], "properties": {"retryId": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "save_token_settings"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"$ref": "#/$defs/tokenSettingsUpdate"}}}
        },
        {
          "if": {"properties": {"action": {"const": "seal_preview"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["visibleSeal"], "properties": {"visibleSeal": {"type": "object"}, "certificateId": {"type": "string"}, "qrContent": {"type": "string"}, "reason": {"type": "string"}, "location": {"type": "string"}, "contactInfo": {"type": "string"}, "extraOptions": {"type": "object", "additionalProperties": {"type": "string"}}}}}}
        },
        {
          "if": {"properties": {"action": {"const": "facturae_create"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["draft"], "properties": {"draft": {"type": "object"}, "outputPath": {"type": "string"}, "overwriteConfirmed": {"type": "boolean"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "cosign_original_check"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["inputPath", "action"], "properties": {"inputPath": {"type": "string", "minLength": 1}, "format": {"type": "string"}, "action": {"type": "string"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "forced_trust_accept"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}, "fingerprint": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "forced_trust_remove"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}, "fingerprint": {"type": "string"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "validate_invoice"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["inputPath"], "properties": {"inputPath": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"enum": ["validate_verifactu", "detect_verifactu"]}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["inputPath"], "properties": {"inputPath": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "read_verifactu_qr"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "minProperties": 1, "maxProperties": 1, "properties": {"url": {"type": "string", "minLength": 1, "maxLength": 2048}, "inputPath": {"type": "string", "minLength": 1}, "imageB64": {"type": "string", "contentEncoding": "base64", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "query_verifactu_qr"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "minLength": 1, "maxLength": 2048}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "validate_eni"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["inputPath"], "properties": {"inputPath": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "generate_eni_document"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["inputPath", "outputPath", "options"], "properties": {"inputPath": {"type": "string", "minLength": 1}, "originalPath": {"type": ["string", "null"]}, "outputPath": {"type": "string", "minLength": 1}, "options": {"type": "object", "additionalProperties": {"type": "string"}}, "overwriteConfirmed": {"type": "boolean"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "generate_eni_file"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["directoryPath", "outputPath", "certificateId", "options"], "properties": {"directoryPath": {"type": "string", "minLength": 1}, "outputPath": {"type": "string", "minLength": 1}, "certificateId": {"type": "string", "minLength": 1}, "options": {"type": "object", "additionalProperties": {"type": "string"}}, "overwriteConfirmed": {"type": "boolean"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "smartcard_status"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"action": {"const": "afirma_handler_select"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["handler"], "properties": {"handler": {"enum": ["grxfirma", "autofirma", "preguntar"]}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"enum": ["csc_status", "csc_connect", "csc_disconnect"]}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"action": {"const": "csc_configure"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["serviceUrl", "clientId"], "properties": {"serviceUrl": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://"}, "clientId": {"type": "string", "minLength": 1, "maxLength": 256}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "csc_send_otp"}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "required": ["certificateId"], "properties": {"certificateId": {"type": "string", "pattern": "^[0-9a-f]{1,128}$"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"enum": ["get_token_settings", "diagnose_token_settings"]}}, "required": ["action"]},
          "then": {"required": ["params"], "properties": {"params": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {
            "required": [
              "protocol"
            ]
          },
          "then": {
            "required": [
              "requestId",
              "traceId",
              "params"
            ],
            "properties": {
              "params": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "ok",
        "action",
        "errorCode",
        "phase",
        "retryable",
        "outcome"
      ],
      "properties": {
        "protocol": {
          "const": "desktop-ipc-v1"
        },
        "requestId": {
          "$ref": "#/$defs/correlationId"
        },
        "traceId": {
          "$ref": "#/$defs/correlationId"
        },
        "ok": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "errorCode": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "admission",
            "protocol",
            "operation"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "partial"
          ]
        },
        "data": {},
        "error": {
          "type": "string"
        },
        "warnings": {"type": "array", "items": {"type": "string"}},
        "exceptionId": {"type": "string"},
        "blockKey": {"type": "string"},
        "settingKey": {"type": "string"},
        "exception": {"$ref": "#/$defs/unsafeExceptionBlock"},
        "activable": {"type": "boolean"},
        "titleKey": {"type": "string"},
        "riskKey": {"type": "string"},
        "acceptanceKey": {"type": "string"},
        "helpKey": {"type": "string"},
        "acceptanceVersion": {"type": "string"},
        "retryId": {"type": "string"},
        "diagnostic": {
          "$ref": "#/$defs/diagnostic"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"errorCode": {"const": "unsafe_exception_blocked"}}, "required": ["errorCode"]},
          "then": {"required": ["exceptionId", "blockKey", "settingKey", "exception", "activable", "titleKey", "riskKey", "acceptanceKey", "helpKey", "acceptanceVersion"], "properties": {"ok": {"const": false}, "outcome": {"const": "failure"}}, "not": {"required": ["data"]}, "description": "Un bloqueo de excepción insegura es siempre un fallo, también al verificar: nunca llega ok:true con este errorCode ni datos de la operación."}
        },
        {
          "if": {"properties": {"action": {"enum": ["unsafe_exceptions_list", "unsafe_exceptions_set"]}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/$defs/unsafeExceptionState"}}}}
        },
        {
          "if": {"properties": {"action": {"const": "unsafe_exceptions_activate"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"$ref": "#/$defs/unsafeAcceptance"}}}
        },
        {
          "if": {"properties": {"action": {"const": "facturae_create"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["total"], "properties": {"total": {"type": "string"}, "xml": {"type": "string"}, "outputPath": {"type": "string"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "validate_invoice"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["format", "valid", "errors", "warnings", "issues", "report"], "properties": {"format": {"enum": ["FacturaE", "UBL", "CII"]}, "valid": {"type": "boolean"}, "errors": {"type": "integer"}, "warnings": {"type": "integer"}, "issues": {"type": "array"}, "report": {"type": "string"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "validate_verifactu"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["format", "valid", "errors", "warnings", "records", "report"], "properties": {"format": {"const": "VeriFactu"}, "valid": {"type": "boolean"}, "errors": {"type": "integer"}, "warnings": {"type": "integer"}, "records": {"type": "array"}, "report": {"type": "string"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "detect_verifactu"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["inputPath", "isVerifactu"], "properties": {"inputPath": {"type": "string"}, "isVerifactu": {"type": "boolean"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "read_verifactu_qr"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["url", "nif", "numserie", "fecha", "importe", "verifiable", "test"], "properties": {"url": {"type": "string"}, "nif": {"type": "string"}, "numserie": {"type": "string"}, "fecha": {"type": "string"}, "importe": {"type": "string"}, "verifiable": {"type": "boolean"}, "test": {"type": "boolean"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "query_verifactu_qr"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["response"], "properties": {"response": {}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "validate_eni"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["format", "valid", "errors", "warnings", "issues", "report"], "properties": {"format": {"const": "ENI"}, "valid": {"type": "boolean"}, "errors": {"type": "integer"}, "warnings": {"type": "integer"}, "issues": {"type": "array"}, "report": {"type": "string"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"enum": ["generate_eni_document", "generate_eni_file"]}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["outputPath"], "properties": {"outputPath": {"type": "string"}, "documents": {"type": "integer"}}, "additionalProperties": false}}}
        },
        {
          "if": {"properties": {"action": {"const": "smartcard_status"}, "ok": {"const": true}}, "required": ["action", "ok"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "object", "required": ["readers"], "properties": {"readers": {"type": "array", "items": {"type": "object", "required": ["name", "present", "isDnie"], "properties": {"name": {"type": "string"}, "present": {"type": "boolean"}, "isDnie": {"type": "boolean"}}, "additionalProperties": false}}}, "additionalProperties": false}}}
        },
        {
          "if": {
            "properties": {"action": {"enum": ["sign", "sign_multicosign"]}, "ok": {"const": true}},
            "required": ["action", "ok"]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "outputPath": {"type": "string"},
                  "signature_b64": {"type": "string"},
                  "format": {
                    "type": "string",
                    "description": "Formato real devuelto por el motor de firma. Opcional por compatibilidad; su ausencia no permite inferirlo de la extensión ni del formato solicitado. Presente tanto en respuestas por ruta como base64."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "failure"
              },
              "errorCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "enum": [
                  "success",
                  "partial"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "success"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "errorCode": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "partial"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "ok": {
                "const": true
              },
              "errorCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "protocol"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "requestId",
                  "traceId"
                ]
              },
              {
                "properties": {
                  "ok": {
                    "const": false
                  },
                  "phase": {
                    "enum": [
                      "admission",
                      "protocol"
                    ]
                  }
                },
                "required": [
                  "ok",
                  "phase"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "requestId"
                      ]
                    },
                    {
                      "required": [
                        "traceId"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "unsafeExceptionBlock": {
      "type": "object",
      "required": ["id", "block_key", "setting_key", "policy_key", "title_key", "risk_key", "acceptance_key", "help_key", "organization_key", "acceptance_version", "activable"],
      "properties": {
        "id": {"type": "string"},
        "block_key": {"type": "string"},
        "setting_key": {"type": "string"},
        "policy_key": {"type": "string"},
        "title_key": {"type": "string"},
        "risk_key": {"type": "string"},
        "acceptance_key": {"type": "string"},
        "help_key": {"type": "string"},
        "organization_key": {"type": "string"},
        "acceptance_version": {"const": "2026-11-15.3"},
        "activable": {"type": "boolean"},
        "config_unavailable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "unsafeAcceptance": {
      "type": "object",
      "required": ["id", "accepted_at", "text_version", "origin", "channel"],
      "properties": {
        "id": {"type": "string"},
        "accepted_at": {"type": "string", "format": "date-time"},
        "text_version": {"type": "string", "minLength": 1, "description": "Version accepted at that time; historical receipts remain visible but do not enable an exception."},
        "origin": {"const": "aceptado desde el aviso"},
        "channel": {"type": "string"}
      },
      "additionalProperties": false
    },
    "unsafeExceptionState": {
      "type": "object",
      "required": ["id", "user_key", "policy_key", "warning_key", "block_key", "setting_key", "title_key", "risk_key", "acceptance_key", "help_key", "organization_key", "acceptance_version", "activable", "enabled", "fixed", "user_enabled", "policy_unreadable"],
      "properties": {
        "id": {"type": "string"},
        "user_key": {"type": "string"},
        "policy_key": {"type": "string"},
        "warning_key": {"type": "string"},
        "block_key": {"type": "string"},
        "setting_key": {"type": "string"},
        "title_key": {"type": "string"},
        "risk_key": {"type": "string"},
        "acceptance_key": {"type": "string"},
        "help_key": {"type": "string"},
        "organization_key": {"type": "string"},
        "acceptance_version": {"const": "2026-11-15.3"},
        "activable": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "fixed": {"type": "boolean"},
        "user_enabled": {"type": "boolean"},
        "policy_unreadable": {"type": "boolean"},
        "config_unavailable": {"type": "boolean"},
        "last_acceptance": {"$ref": "#/$defs/unsafeAcceptance"}
      },
      "additionalProperties": false
    },
    "tokenSettingsUpdate": {
      "description": "Máximo 64 KiB de JSON UTF-8. Se guarda solo con confirmación y revisión vigente. Las rutas absolutas, permisos, propietarios y alias de módulos se validan localmente. Deshabilitar permite retirar un controlador ausente. No contiene PIN, comandos, helper ni entorno.",
      "type": "object",
      "required": ["enabled", "modules", "revision", "confirmed", "replaceInvalid"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "confirmed": {"const": true},
        "replaceInvalid": {"type": "boolean"},
        "revision": {"type": "string", "pattern": "^([0-9a-fA-F]{64})?$"},
        "modules": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {
            "type": "object", "required": ["path"], "additionalProperties": false,
            "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"}}
          }
        }
      }
    },
    "action": {
      "enum": [
        "afirma_handler_select",
        "afirma_handler_status",
        "certificate_access_options",
        "certificate_export_public",
        "certificates",
        "check_certificates",
        "check_updates",
        "clear_temporary_certificates",
        "clear_tls_trust",
        "clock_diagnostics",
        "cosign_original_check",
        "csc_configure",
        "csc_connect",
        "csc_disconnect",
        "csc_send_otp",
        "csc_status",
        "diagnose_token_settings",
        "export_diagnostic",
        "facturae_create",
        "forced_trust_accept",
        "forced_trust_list",
        "forced_trust_remove",
        "validate_invoice",
        "validate_verifactu",
        "read_verifactu_qr",
        "query_verifactu_qr",
        "detect_verifactu",
        "validate_eni",
        "generate_eni_document",
        "generate_eni_file",
        "get_settings",
        "get_token_settings",
        "getcertificates",
        "hash_check",
        "hash_create",
        "hello",
        "import_certificate",
