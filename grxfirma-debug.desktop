[Desktop Entry]
Name=GrxFirma (debug)
Name[es]=GrxFirma (debug)
GenericName=Aplicacion de firma electronica
GenericName[es]=Aplicacion de firma electronica
Comment=Modo debug de GrxFirma con log privado en el directorio de estado del usuario
Comment[es]=Modo debug de GrxFirma con log privado en el directorio de estado del usuario
# make desktop-user-debug sustituye @GRXFIRMA_DEBUG_LOG@ por
# ${XDG_STATE_HOME:-$HOME/.local/state}/grxfirma/grxfirma-debug.log y crea ese
# directorio con permisos 0700. No se usa /tmp: es una ruta predecible en un
# directorio compartido.
Exec=env GRXFIRMA_DEBUG=1 "GRXFIRMA_LOG_FILE=@GRXFIRMA_DEBUG_LOG@" GRXFIRMA_PROTOCOL_UI=1 grxfirma-afirmauri %u
Terminal=false
Type=Application
Icon=grxfirma
Categories=Office;Security;
MimeType=x-scheme-handler/afirma;
Keywords=firma;electronica;certificado;digital;debug;
StartupNotify=false
