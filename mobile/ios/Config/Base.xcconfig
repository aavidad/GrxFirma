IPHONEOS_DEPLOYMENT_TARGET = 16.0
SWIFT_VERSION = 5.9
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = YES
SWIFT_STRICT_CONCURRENCY = targeted
GCC_C_LANGUAGE_STANDARD = gnu17
CLANG_CXX_LANGUAGE_STANDARD = gnu++20
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(PROJECT_DIR)/Frameworks"
CODE_SIGN_ENTITLEMENTS = GrxFirma/GrxFirma.entitlements
GRXFIRMA_APP_BUNDLE_IDENTIFIER = io.github.aavidad.grxfirma
GRXFIRMA_SHARE_BUNDLE_IDENTIFIER = io.github.aavidad.grxfirma.share
PRODUCT_BUNDLE_IDENTIFIER = $(GRXFIRMA_APP_BUNDLE_IDENTIFIER)
GRXFIRMA_APP_GROUP = group.io.github.aavidad.grxfirma
GRXFIRMA_KEYCHAIN_GROUP = io.github.aavidad.grxfirma.keys
GRXFIRMA_CORE_MODE = verification
GRXFIRMA_SHARE_PROVISIONING_PROFILE = __SHARE_PROVISIONING_PROFILE_REQUIRED__
DEVELOPMENT_TEAM = __APPLE_TEAM_ID_REQUIRED__
PROVISIONING_PROFILE_SPECIFIER = __APP_PROVISIONING_PROFILE_REQUIRED__
MARKETING_VERSION = 2.0.0
CURRENT_PROJECT_VERSION = 1
INFOPLIST_KEY_CFBundleDisplayName = GrxFirma
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
