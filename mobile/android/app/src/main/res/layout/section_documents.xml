<!-- Veri*Factu y documentos ENI. Se incluye en activity_main. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/documentsSectionTitle"
        style="@style/TextAppearance.Material3.TitleLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_spacing"
        android:text="@string/documents_section"
        android:textColor="@color/on_surface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/documentsHelper"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/documents_helper"
        android:textColor="@color/on_surface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleVerifactuButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/verifactu_title"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="end" />

    <LinearLayout
        android:id="@+id/verifactuGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/verifactu_helper"
            android:textColor="@color/on_surface" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/verifactu_sign_hint"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectVerifactuButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:minHeight="48dp"
            android:text="@string/verifactu_choose" />

        <TextView
        android:id="@+id/verifactuSummary"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/verifactu_none"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearVerifactuButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/verifactu_clear"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkVerifactuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/verifactu_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportVerifactuButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/verifactu_export"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/qrGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/qrTitle"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/qr_title"
                android:textColor="@color/on_surface" />

            <TextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/qr_notice"
                android:textColor="@color/on_surface" />

            <!-- La foto y la imagen se leen en el núcleo, sin red; la foto
                 temporal se borra en cuanto se lee. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/takeQrPhotoButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_spacing"
                android:minHeight="48dp"
                android:text="@string/qr_take_photo"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chooseQrImageButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/qr_choose_image"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/qrUrlLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_spacing"
                android:hint="@string/qr_url_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/qrUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLength="2048"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readQrButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/qr_read" />

            <TextView
                android:id="@+id/qrResult"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/on_surface"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queryAeatButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/qr_query" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleEniButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/eni_title"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="end" />

    <LinearLayout
        android:id="@+id/eniGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/eni_helper"
            android:textColor="@color/on_surface" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniOrgansLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_organ"
            app:helperText="@string/eni_organ_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/eniOrgans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="160"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniOriginLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_origin">

            <es.dipgra.grxfirma.android.ui.DropdownField
                android:id="@+id/eniOrigin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniStateLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_state">

            <es.dipgra.grxfirma.android.ui.DropdownField
                android:id="@+id/eniState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniDocumentTypeLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_doc_type">

            <es.dipgra.grxfirma.android.ui.DropdownField
                android:id="@+id/eniDocumentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniSourceLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_source">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/eniSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLength="64"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniIdentifierLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_identifier">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/eniIdentifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLength="64"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eniContentFormatLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/eni_content_format">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/eniContentFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="32"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
        android:id="@+id/eniCaptureDateSummary"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:text="@string/eni_capture_date_now"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/eniCaptureDateButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/eni_capture_date_choose" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/eniCaptureDateClearButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/eni_capture_date_clear"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/eni_original_hint"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createEniButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/eni_create" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:text="@string/eni_validate_scope"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/validateEniButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/eni_validate" />

    </LinearLayout>

    <include
        android:id="@+id/expediente"
        layout="@layout/section_expediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
