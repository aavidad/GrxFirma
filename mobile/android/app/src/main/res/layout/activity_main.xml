<!-- Recorrido en pasos: 1. Documento, 2. Certificado, 3. Firmar o verificar
     y resultado justo debajo. Lo avanzado y las demás herramientas, plegado. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/primary"
            android:elevation="0dp"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:title="@string/app_name"
            app:titleTextColor="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/contentColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <com.google.android.material.card.MaterialCardView
                    android:visibility="gone"
                    android:id="@+id/backendStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/section_spacing"
                    app:cardBackgroundColor="@color/status_warning_container"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/status_warning"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/backendStatusTitle"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/backend_unavailable_title"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/backendStatusDetail"
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/backend_loading_detail"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/documentSectionTitle"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_document"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/document_helper"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectDocumentButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:minHeight="48dp"
                    android:text="@string/select_document" />

                <TextView
                    android:id="@+id/documentSummary"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_document"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true" />

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:text="@string/original_document_helper"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectOriginalDocumentButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/select_original_document" />

                <TextView
                    android:id="@+id/originalDocumentSummary"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_original_document"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearOriginalDocumentButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="@string/clear_original_document"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/certificateSectionTitle"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/step_certificate"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/certificate_helper"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectCertificateFileButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:minHeight="48dp"
                    android:text="@string/select_pkcs12" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectDnieNfcButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/dnie_nfc_choice" />

                <TextView
                    android:id="@+id/dnieHint"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/on_surface"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dnieScanStatus"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="@string/dnie_scan_instruction"
                    android:textColor="@color/on_surface"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_nfc_card" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelDnieScanButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/dnie_cancel"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/certificateFileSummary"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_certificate_file"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/certificatePasswordLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:hint="@string/certificate_password"
                    android:visibility="gone"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/certificate_password_helper">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/certificatePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="noExcludeDescendants"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword|textNoSuggestions"
                        android:saveEnabled="false"
                        android:maxLength="256"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/importCertificateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/import_certificate"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/certificateSummary"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_certificate"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true" />

                <include
                    android:id="@+id/certificatePanel"
                    layout="@layout/section_certificate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgetCertificateButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="@string/forget_certificate"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/operationSectionTitle"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/step_sign"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/visibleSealCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/seal_visible"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editVisibleSealButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/seal_edit"
                    android:visibility="gone" />

                <!-- Aviso y acción por separado: primero el hecho, después qué se puede hacer. -->
                <TextView
                    android:id="@+id/cosignNotice"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cosign_notice"
                    android:textColor="@color/on_surface"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/useCosignButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/suggest_cosign" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggleSigningOptionsButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/signing_options_title"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="end" />

                <TextView
                    android:id="@+id/signingOptionsSummary"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/on_surface" />

                <LinearLayout
                    android:id="@+id/signingOptionsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/signatureActionLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:hint="@string/signature_action">

                    <io.github.aavidad.grxfirma.android.ui.DropdownField
                        android:id="@+id/signatureAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/signature_actions"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/signatureProfileLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:hint="@string/signature_profile">

                    <io.github.aavidad.grxfirma.android.ui.DropdownField
                        android:id="@+id/signatureProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/signature_profiles"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/tsaEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tsa_enabled" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tsaUrlLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/tsa_url"
                    android:visibility="gone"
                    app:helperText="@string/tsa_helper"
                    app:placeholderText="@string/tsa_url_example">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tsaUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLength="2048"
                        android:minHeight="48dp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/signatureFormatLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:hint="@string/signature_format">

                    <io.github.aavidad.grxfirma.android.ui.DropdownField
                        android:id="@+id/signatureFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/signature_formats"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/openCertificateStatus"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/on_surface"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:minHeight="48dp"
                    android:text="@string/sign_document" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verifyButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/verify_document" />

                <TextView
                    android:id="@+id/actionHint"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/on_surface"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/progressContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:indeterminate="true" />

                    <TextView
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/operation_in_progress"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/resultCard"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/resultSectionTitle"
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/result_section"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <TextView
                    android:id="@+id/resultTitle"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:accessibilityLiveRegion="assertive"
                    android:text="@string/result_idle"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/resultDetail"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                        <TextView
                            android:id="@+id/verificationDetail"
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/control_spacing"
                            android:textColor="@color/on_surface"
                            android:textIsSelectable="true"
                            android:visibility="gone" />

                        <!-- Evidencias del motor: plegadas de inicio, para quien las necesite. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggleVerificationTechnicalButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/verification_technical_toggle"
                            android:visibility="gone"
                            app:icon="@drawable/ic_expand_more"
                            app:iconGravity="end" />

                        <TextView
                            android:id="@+id/verificationTechnical"
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textIsSelectable="true"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/exportReportHtmlButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/export_verification_report_html"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportReportButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/export_verification_report" />

                <LinearLayout
                    android:id="@+id/pendingSaveActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_spacing"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retrySaveButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/retry_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/discardPendingOutputButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/discard_pending_output" />
                </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggleOtherToolsButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/other_tools_title"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="end" />

                <LinearLayout
                    android:id="@+id/otherToolsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/tools"
                        layout="@layout/section_tools"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/documents"
                        layout="@layout/section_documents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
