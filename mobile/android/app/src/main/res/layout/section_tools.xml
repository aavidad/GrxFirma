<!-- Huellas, protección CMS y firma por lotes. Se incluye en activity_main. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/toolsHelper"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tools_helper"
        android:textColor="@color/on_surface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleBatchButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/batch_title"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="end" />

    <LinearLayout
        android:id="@+id/batchGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/batchHelperText"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/batch_helper"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectBatchButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:minHeight="48dp"
            android:text="@string/batch_select" />

        <TextView
            android:id="@+id/batchSummary"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/batch_none"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearBatchButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/batch_clear"
            android:visibility="gone" />

        <include
            android:id="@+id/batchWave4"
            layout="@layout/section_batch_wave4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signBatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/batch_sign" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleHashButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/hash_title"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="end" />

    <LinearLayout
        android:id="@+id/hashGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hash_helper"
            android:textColor="@color/on_surface" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/hashAlgorithmLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/hash_algorithm">

            <io.github.aavidad.grxfirma.android.ui.DropdownField
                android:id="@+id/hashAlgorithm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/hash_algorithms"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/hashFormatLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/hash_format">

            <io.github.aavidad.grxfirma.android.ui.DropdownField
                android:id="@+id/hashFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/hash_formats"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createHashButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:minHeight="48dp"
            android:text="@string/hash_create" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkHashButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/hash_check" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleProtectButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="@string/protect_title"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="end" />

    <LinearLayout
        android:id="@+id/protectGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/protect_helper"
            android:textColor="@color/on_surface" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/protectionContainerLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/protect_container">

            <io.github.aavidad.grxfirma.android.ui.DropdownField
                android:id="@+id/protectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/protect_containers"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/protectForMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/protect_for_me" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addRecipientButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/protect_add_recipient" />

        <TextView
            android:id="@+id/recipientsSummary"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/protect_recipients_none"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearRecipientsButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/protect_clear_recipients"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/protectKeyLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/protect_key"
            app:endIconMode="password_toggle"
            app:helperText="@string/protect_key_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/protectKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="noExcludeDescendants"
                android:inputType="textPassword|textNoSuggestions"
                android:maxLength="44"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/protectKeyConfirmLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/protect_key_confirm"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/protectKeyConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="noExcludeDescendants"
                android:inputType="textPassword|textNoSuggestions"
                android:maxLength="44"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generateKeyButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/protect_generate_key" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/protectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:minHeight="48dp"
            android:text="@string/protect_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/protectSignButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/protect_sign_button" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:text="@string/unprotect_helper"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unprotectButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/unprotect_button" />

        <TextView
            android:id="@+id/unprotectHint"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_unprotect_not_protected"
            android:textColor="@color/on_surface"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
