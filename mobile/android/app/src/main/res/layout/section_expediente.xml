<!-- Expediente ENI (cuarta oleada). Se incluye en section_documents. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/expedienteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleExpedienteButton"
            style="@style/Widget.GrxFirma.Button.TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:minHeight="48dp"
            android:text="@string/expediente_title"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="end" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expedienteHelp"
            style="@style/Widget.GrxFirma.HelpButton"
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expedienteGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:visibility="gone">
        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/expediente_helper"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expedienteFolderButton"
            style="@style/Widget.GrxFirma.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:minHeight="48dp"
            android:text="@string/expediente_select_folder" />

        <TextView
            android:id="@+id/expedienteSummary"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/expediente_none"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expedienteClearButton"
            style="@style/Widget.GrxFirma.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/expediente_clear"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/expedienteOrgansLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/expediente_organs"
            app:helperText="@string/expediente_organs_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/expedienteOrgans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="160"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/expedienteClassificationLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/expediente_classification"
            app:helperText="@string/expediente_classification_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/expedienteClassification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="64"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/expedienteStateLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/expediente_state">

            <io.github.aavidad.grxfirma.android.ui.DropdownField
                android:id="@+id/expedienteState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/expedienteIdentifierLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/expediente_identifier"
            app:helperText="@string/expediente_identifier_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/expedienteIdentifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLength="64"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/expedienteInterestedLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:hint="@string/expediente_interested"
            app:helperText="@string/expediente_interested_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/expedienteInterested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLength="1024"
                android:minHeight="48dp"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/expedienteOpeningSummary"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_spacing"
            android:text="@string/expediente_opening_now"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expedienteOpeningButton"
            style="@style/Widget.GrxFirma.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/expediente_opening_choose" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expedienteOpeningClearButton"
            style="@style/Widget.GrxFirma.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/expediente_opening_clear"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/expediente_sign_hint"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expedienteCreateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/expediente_create" />

    </LinearLayout>

</LinearLayout>
