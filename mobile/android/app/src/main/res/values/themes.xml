<resources>
    <style name="Theme.GrxFirma" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="grxHelpButtonStyle">@style/Widget.GrxFirma.HelpButton</item>
    </style>

    <!-- Botón «?» de ayuda: icono de 24 dp en un área táctil de 48 dp, con el color
         primario (contraste AA sobre la superficie en tema claro y oscuro). -->
    <style name="Widget.GrxFirma.HelpButton" parent="Widget.Material3.Button.IconButton">
        <item name="icon">@drawable/ic_help</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="iconSize">24dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>
</resources>
