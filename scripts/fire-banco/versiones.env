#
# Versiones fijadas del banco de pruebas FIRe. Cambiar una versión obliga a
# repetir la prueba completa y anotar el resultado en docs/FIRE_BANCO_PRUEBAS.md.

# Componente central FIRe (código abierto del Gobierno de España, GPL 2+ / EUPL 1.1).
# Commit de la rama master con pom 2.4, que declara clienteafirma 1.9.
FIRE_REPO=https://github.com/ctt-gob-es/fire.git
FIRE_COMMIT=fb54e53cfb9601a0951ebabb86c617646a134c04

# Cliente @firma (clienteafirma), etiqueta v1.9: FIRe 2.4 usa su núcleo trifásico
# (afirma-server-triphase-signer-core) y los módulos de firma. Se compilan desde
# la fuente en vez de bajar los binarios de Maven Central.
CLIENTEAFIRMA_REPO=https://github.com/ctt-gob-es/clienteafirma.git
CLIENTEAFIRMA_COMMIT=1f29aa7a2aae8eda40a70fed79b0428153c78df8
CLIENTEAFIRMA_MODULOS=afirma-server-triphase-signer-core

# Herramientas de compilación y servidor, descargadas en el directorio del banco
# (no se instala nada en el sistema). Sumas SHA-512 publicadas por Apache.
MAVEN_VERSION=3.9.9
MAVEN_URL=https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz
MAVEN_SHA512=a555254d6b53d267965a3404ecb14e53c3827c09c3b94b5678835887ab404556bfaf78dcfe03ba76fa2508649dca8531c74bca4d5846513522404d48e8c4ac8b

TOMCAT_VERSION=9.0.98
TOMCAT_URL=https://archive.apache.org/dist/tomcat/tomcat-9/v9.0.98/bin/apache-tomcat-9.0.98.tar.gz
TOMCAT_SHA512=07d87286e8ee84bb291069c596cf36233e56a14e3ecb6d65eea0fa7c7042ce5e75f5db31f210b96b6b25b80b34e626dd26c5a6ed5c052384a8587d62658b5e16

# Puertos: solo se escucha en 127.0.0.1.
FIRE_PUERTO_HTTPS=18443
FIRE_PUERTO_APAGADO=18005
