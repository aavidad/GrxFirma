<!--
  Plantilla del manifest MSIX de GrxFirma (Microsoft Store).
  Los marcadores @...@ los sustituye packaging/windows/build-msix.ps1.

  IMPORTANTE para publicar en la Store: Identity/Name y Publisher deben
  coincidir EXACTAMENTE con los valores que asigna el Partner Center al
  reservar el nombre de la app (variables MSIX_IDENTITY_NAME y
  MSIX_PUBLISHER). Los valores por defecto solo sirven para pruebas locales.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GrxFirma</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>MsixAssets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <!-- Aplicación principal: GUI de escritorio Qt/QML. -->
    <Application Id="GrxFirma" Executable="grxfirma-gui-qml.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GrxFirma"
        Description="Firma electrónica avanzada (CAdES, XAdES, PAdES, FacturaE)."
        BackgroundColor="transparent"
        Square150x150Logo="MsixAssets\Square150x150Logo.png"
        Square44x44Logo="MsixAssets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="MsixAssets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>

    <!-- Handler del protocolo afirma:// (firma web desde el navegador).
         Oculto del menú inicio: solo se lanza vía protocolo. -->
    <Application Id="AfirmaURI" Executable="grxfirma-afirmauri.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GrxFirma firma web"
        Description="Manejador del protocolo afirma:// de GrxFirma."
        BackgroundColor="transparent"
        Square150x150Logo="MsixAssets\Square150x150Logo.png"
        Square44x44Logo="MsixAssets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="afirma">
            <uap:DisplayName>GrxFirma firma web</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
