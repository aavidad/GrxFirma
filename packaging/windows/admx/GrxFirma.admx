    <policy name="TSAPermitidas" class="Machine" displayName="$(string.TSAPermitidas)" explainText="$(string.TSAPermitidas_Help)" presentation="$(presentation.TSAPermitidas)" key="SOFTWARE\Policies\GrxFirma">
      <parentCategory ref="Origenes" />
      <supportedOn ref="SUPPORTED_GrxFirma_0_0_90" />
