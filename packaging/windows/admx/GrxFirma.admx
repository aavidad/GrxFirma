      <parentCategory ref="Operacion" />
      <supportedOn ref="SUPPORTED_GrxFirma_0_0_126" />
      <elements>
        <enum id="ManejadorAfirma_Valor" valueName="manejador_afirma" required="true">
          <item displayName="$(string.ManejadorAfirma_GrxFirma)"><value><string>grxfirma</string></value></item>
          <item displayName="$(string.ManejadorAfirma_AutoFirma)"><value><string>autofirma</string></value></item>
          <item displayName="$(string.ManejadorAfirma_Preguntar)"><value><string>preguntar</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="FirmaRemotaCSC" class="Machine" displayName="$(string.FirmaRemotaCSC)" explainText="$(string.FirmaRemotaCSC_Help)" key="SOFTWARE\Policies\GrxFirma" valueName="firma_remota_csc">
