    <policy name="ProhibirCifradoCMSHeredado" class="Machine" displayName="$(string.ProhibirCifradoCMSHeredado)" explainText="$(string.ProhibirCifradoCMSHeredado_Help)" key="SOFTWARE\Policies\GrxFirma" valueName="prohibir_cifrado_cms_heredado">
