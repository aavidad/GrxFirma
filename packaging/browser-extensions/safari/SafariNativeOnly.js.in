// GRXFIRMA_SAFARI_NATIVE_ONLY_START
// Safari's native handler already performs the authenticated REST bridge.
(function enforceSafariNativeBridge() {
    "use strict";

    // Solo se reasignan funciones que background.js declara de verdad. Asignar
    // un nombre no declarado lanzaria ReferenceError en modo estricto, el resto
    // del parche no se aplicaria y el service worker podria no registrarse
    // (hallazgo C-01). Si falta una, no hay camino REST que anular; la prueba
    // native_only.test.mjs comprueba con el background.js real que ambas existen.
    function replaceDeclared(name, replacement) {
        if (typeof globalThis[name] === "function") globalThis[name] = replacement;
    }

    replaceDeclared("restJSON", async function disableRestFallback() {
        throw new Error("Safari native bridge only");
    });

    replaceDeclared("pingLocalIntegration", async function pingThroughSafariHandler() {
        const response = await sendToNativeHost("ping");
        return { success: true, message: "pong", mode: "safari-native", native: response };
    });
})();
// GRXFIRMA_SAFARI_NATIVE_ONLY_END
